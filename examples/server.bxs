/**
 * Runnable demo of the whole BoxExpress API surface. Start it with:
 *   boxlang examples/server.bxs
 * then exercise it with curl (see README.md for the full list of commands).
 */
app = new "../models/BoxExpress"()
bodyParsers = new "../models/middleware/BodyParsers"()
staticFiles = new "../models/middleware/StaticFiles"()
multipart = new "../models/middleware/Multipart"()

app.use( bodyParsers.json() )
app.use( bodyParsers.urlencoded() )
app.use( "/public", staticFiles.serve( expandPath( "./public" ) ) )
app.set( "views", expandPath( "./views" ) )

app.get( "/", ( req, res ) => {
	res.send( "Hello from BoxExpress!" )
} )

// Runs once for any matched route with an :id param, before that route's own
// handler — good for a shared lookup/validation step.
app.param( "id", ( req, res, next, value ) => {
	req.params.id = value.trim()
	next()
} )

app.get( "/users/:id", ( req, res ) => {
	res.json( { id: req.params.id, source: "route param" } )
} )

// Chainable per-path route builder — sugar over app.get/post individually.
app.route( "/widgets" )
	.get( ( req, res ) => res.json( { op: "list" } ) )
	.post( ( req, res ) => res.json( { op: "create", body: req.body } ) )

app.get( "/search", ( req, res ) => {
	res.json( { query: req.query } )
} )

app.post( "/echo", ( req, res ) => {
	res.json( { youSent: req.body } )
} )

app.get( "/boom", ( req, res, next ) => {
	throw( message = "Something went wrong on purpose", type = "DemoError" )
} )

// Demonstrates that requests are served concurrently (one virtual thread per
// request) rather than queued behind each other.
app.get( "/slow", ( req, res ) => {
	sleep( 1000 )
	res.json( { slept: 1000 } )
} )

app.get( "/download", ( req, res ) => {
	res.download( expandPath( "./public/hello.txt" ) )
} )

app.post( "/upload", multipart.upload( { dest: expandPath( "./uploads" ) } ), ( req, res ) => {
	res.json( { fields: req.body, files: req.files } )
} )

app.get( "/set-cookie", ( req, res ) => {
	res.cookie( "sessionId", "abc123", { maxAge: 3600 } ).json( { cookieSet: true } )
} )

app.get( "/go-home", ( req, res ) => {
	res.redirect( "/" )
} )

app.get( "/greet/:name", ( req, res ) => {
	res.render( "greeting", { name: req.params.name, age: 30 } )
} )

app.get( "/greet-hbs/:name", ( req, res ) => {
	res.render( "greeting.hbs", { data: { name: req.params.name, age: 30, things: [ "coffee", "code", "curl" ] } } )
} )

apiRouter = new "../models/Router"()

apiRouter.get( "/ping", ( req, res ) => {
	res.json( { pong: true } )
} )

apiRouter.get( "/items/:itemId", ( req, res ) => {
	res.json( { itemId: req.params.itemId, mountedUnder: "/api" } )
} )

app.use( "/api", apiRouter )

// Custom error-handling middleware (4 args) — registered last, like Express.
app.use( ( err, req, res, next ) => {
	writeLog( text = "Unhandled error: " & err.message, log = "application" )
	res.status( 500 ).json( { error: true, message: err.message } )
} )

// Blocks here — listen() keeps the process alive by default (options.block = true).
app.listen( 3000, ( port ) => {
	println( "BoxExpress listening on http://localhost:#port#" )
} )
