/**
 * Phase 5 load-comparison fixture: a realistic-ish route mix (static text,
 * a route param, a small JSON echo, and a static file) served by whichever
 * engine BOXEXPRESS_LOAD_ENGINE names ("jdk" or "undertow", default "jdk").
 * Driven by run.sh, not meant to be started by hand.
 */
engine = getSystemSetting( "BOXEXPRESS_LOAD_ENGINE", "jdk" )
port = getSystemSetting( "BOXEXPRESS_LOAD_PORT", "4700" )

app = new "../../models/BoxExpress"()
app.set( "server.engine", engine )

bodyParsers = new "../../models/middleware/BodyParsers"()
staticFiles = new "../../models/middleware/StaticFiles"()
app.use( bodyParsers.json() )
app.use( "/public", staticFiles.serve( expandPath( "../../tests/fixtures/public" ) ) )

app.get( "/", ( req, res ) => res.send( "Hello from BoxExpress!" ) )

app.get( "/users/:id", ( req, res ) => {
	res.json( { id: req.params.id, name: "user-" & req.params.id } )
} )

app.post( "/echo", ( req, res ) => {
	res.json( { youSent: req.body } )
} )

println( "[load-test] engine=#engine# starting on port #port#" )
app.listen( val( port ), ( boundPort ) => println( "[load-test] listening on #boundPort#" ) )
