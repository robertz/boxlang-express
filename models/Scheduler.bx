/**
 * Backs app.schedule() — fixed-interval recurring jobs, the setInterval
 * equivalent. Deliberately no cron-expression parsing: that's a real,
 * separable feature (a parser, timezone handling, calendar edge cases)
 * this pass isn't building, not an oversight.
 *
 * One java.util.concurrent.ScheduledExecutorService (single-threaded)
 * drives ticks for every job on this instance; each tick's actual
 * callback runs on its own virtual thread via
 * Executors.newVirtualThreadPerTaskExecutor(), same split
 * UndertowVirtualThreadHandler.bx uses for HTTP requests — a slow job
 * body never delays another job's tick, since the tick thread only ever
 * does the (cheap) work of deciding whether to submit, not the job
 * itself.
 *
 * No persistence across restarts (in-memory only, single process), no
 * missed-run catch-up after downtime, and no clustering/distributed
 * coordination — every process instance runs every job independently,
 * the same boundary Stomp.bx's docblock draws around multi-node
 * clustering for itself. An app running multiple instances behind a
 * load balancer will get the same job firing once per instance, not
 * once total; that's a real, known limitation of an in-process
 * scheduler, not something to work around here.
 */
class {

	/**
	 * app defaults to "" (a sentinel), never a bare javacast("null","")
	 * default — confirmed directly (2026-09-09) that a parameter actually
	 * holding a real null can't be referenced by name at all, not even a
	 * plain read to assign it onward (the exact landmine
	 * StompMessage.bx's own init() docblock documents — ClusterPeer.bx
	 * hit the identical bug once already; see its own init() docblock).
	 * variables.app only ever becomes a genuine null via the direct
	 * assignment below, never by reading the parameter itself.
	 */
	function init( settings = {}, app = "" ) {
		variables.settings = settings
		variables.app = isSimpleValue( app ) ? javacast( "null", "" ) : app
		variables.tickExecutor = createObject( "java", "java.util.concurrent.Executors" ).newSingleThreadScheduledExecutor()
		variables.taskExecutor = createObject( "java", "java.util.concurrent.Executors" ).newVirtualThreadPerTaskExecutor()
		variables.jobs = {}
		variables.jobCounter = 0
		return this
	}

	/**
	 * intervalMs is both the tick period and, unless immediate is true,
	 * the delay before the first tick — scheduleAtFixedRate() fires on a
	 * fixed wall-clock cadence regardless of how long an individual job
	 * body takes (that's what "fixed rate" means to the JDK scheduler);
	 * whether an overrunning job's next tick actually runs or gets
	 * skipped is decided by this class's own overlap policy below, not by
	 * the JDK executor.
	 *
	 * options.name defaults to an internal job id — set it to get a
	 * meaningful label in getJobs()/the "[Scheduler] job '...' threw"
	 * error log below, instead of "job-3".
	 *
	 * options.immediate runs the first tick right away (0 delay) instead
	 * of waiting one full interval first, for a job that should run once
	 * at startup and then on its normal cadence.
	 *
	 * options.allowOverlap (default false) — by default, a tick is
	 * skipped entirely (not queued, not delayed — just skipped) if the
	 * previous run of this same job hasn't finished yet, claimed
	 * atomically via an AtomicBoolean so the tick thread and whichever
	 * virtual thread is still running the previous job body can't both
	 * think they own the same tick. Skip-by-default exists so a job that
	 * occasionally runs long (a slow query, a network call) doesn't pile
	 * up an unbounded number of overlapping virtual threads all doing the
	 * same work concurrently — the failure mode this is guarding against
	 * is real resource exhaustion, not a theoretical one. Pass
	 * allowOverlap: true for a job that's actually safe to run
	 * concurrently with itself (each run independent, no shared state).
	 *
	 * The callback receives this job's own handle ({ cancel(), name }) as
	 * its one argument — a job that needs to cancel itself (a one-shot
	 * "run until some condition, then stop" job) doesn't need to hang
	 * onto the return value of schedule() to do it. A callback declared
	 * with no parameters just ignores it.
	 */
	function schedule( intervalMs, callback, options = {} ) {
		variables.jobCounter++
		var jobId = "job-" & variables.jobCounter
		var jobName = options.name ?: jobId
		var allowOverlap = options.allowOverlap ?: false
		var immediate = options.immediate ?: false
		var clustered = options.clustered ?: false

		var scheduler = this
		var handle = {
			name: jobName,
			cancel: function() {
				scheduler._cancelJob( jobId )
			}
		}

		variables.jobs[ jobId ] = {
			name: jobName,
			callback: callback,
			allowOverlap: allowOverlap,
			clustered: clustered,
			handle: handle,
			runningFlag: createObject( "java", "java.util.concurrent.atomic.AtomicBoolean" ).init( false ),
			// Counters for getMetrics() — AtomicLongs, since a job with allowOverlap
			// can update them from several virtual threads at once.
			runs: createObject( "java", "java.util.concurrent.atomic.AtomicLong" ).init( 0 ),
			failures: createObject( "java", "java.util.concurrent.atomic.AtomicLong" ).init( 0 ),
			skipped: createObject( "java", "java.util.concurrent.atomic.AtomicLong" ).init( 0 ),
			lastSuccessMs: createObject( "java", "java.util.concurrent.atomic.AtomicLong" ).init( 0 ),
			lastDurationNanos: createObject( "java", "java.util.concurrent.atomic.AtomicLong" ).init( 0 ),
			startedAt: 0,
			// A job body that never returns (blocks forever on some call with
			// no timeout of its own — the exact way a stalled WebSocket send
			// has actually been observed to hang, see _runTick's watchdog
			// below) would otherwise leave runningFlag stuck true forever,
			// silently skipping every future tick permanently. Scaled off
			// this job's own interval (so an hourly job isn't declared
			// stuck after 30s of genuine work) with a floor so a
			// sub-second job still gets a reasonable grace window.
			stallThresholdMs: max( intervalMs * 10, 30000 )
		}

		var tickRunnable = createDynamicProxy(
			new ThreadRunnable( function() {
				scheduler._runTick( jobId )
			} ),
			[ "java.lang.Runnable" ]
		)

		var initialDelayMs = immediate ? 0 : intervalMs
		variables.jobs[ jobId ].future = variables.tickExecutor.scheduleAtFixedRate(
			tickRunnable,
			javacast( "long", initialDelayMs ),
			javacast( "long", intervalMs ),
			createObject( "java", "java.util.concurrent.TimeUnit" ).MILLISECONDS
		)

		return handle
	}

	/**
	 * Runs on the single tick-executor thread — every job on this
	 * Scheduler shares it, so this needs to stay cheap (claim-and-submit
	 * only) and never itself run job code, or a slow job would delay
	 * every other job's ticks exactly the way the class docblock says
	 * this design avoids.
	 */
	function _runTick( jobId ) {
		var job = variables.jobs[ jobId ] ?: javacast( "null", "" )
		if ( isNull( job ) ) {
			return   // cancelled between the tick firing and this running
		}

		// Clustered jobs only ever run on the elected manager — see
		// plans/cluster-support.md's "Consumer 2: Scheduler leader
		// election". A non-leader node does zero work for this tick: it
		// never touches the overlap AtomicBoolean below, never submits
		// anything to taskExecutor. If this Scheduler was never handed an
		// app (a test/script using `new Scheduler(settings)` directly) or
		// clustering was never configured on it, isManager() is a no-op
		// that's always true — same behavior as an unclustered job.
		if ( job.clustered && !isNull( variables.app ) && !variables.app.getClusterManager().isManager() ) {
			return
		}

		if ( !job.allowOverlap && !job.runningFlag.compareAndSet( false, true ) ) {
			// The previous run is still marked active. Normally that just
			// means it's still working — skip this tick, same as always.
			// But a run whose body never returns at all (proven to happen
			// in practice: a WebSocket send blocking forever on a peer that
			// vanished mid-write, with no timeout of its own — see
			// WebSocketConnection.bx's send()) never reaches its own
			// finally block below, so runningFlag would otherwise stay
			// stuck true PERMANENTLY, silently skipping every future tick
			// forever. A run that's been "still active" for longer than
			// this job's own stall threshold is indistinguishable from one
			// that's never coming back, so treat it the same way: force
			// the flag open so the job isn't wedged forever. If the old
			// run does eventually finish, its own finally still fires and
			// harmlessly resets a flag that's already been reset.
			var runningForMs = getTickCount() - job.startedAt
			if ( runningForMs < job.stallThresholdMs ) {
				job.skipped.incrementAndGet()
				return
			}
			println( "[Scheduler] job '" & job.name & "' has been running for " & runningForMs & "ms (stall threshold " & job.stallThresholdMs & "ms) — forcing it open so future ticks aren't blocked forever" )
			job.runningFlag.set( true )
		}
		if ( job.allowOverlap ) {
			job.runningFlag.set( true )
		}
		job.startedAt = getTickCount()

		// Everything from here down runs on the single shared tick-executor
		// thread, driven by scheduleAtFixedRate() — if ANY exception escapes
		// this Runnable (not just ones inside the job callback above), the
		// JDK silently and permanently cancels every future tick of this job,
		// with nothing logged anywhere. createDynamicProxy()/ThreadRunnable
		// construction and taskExecutor.submit() itself are just as capable
		// of throwing as the job callback is, so they need the same net.
		try {
			variables.taskExecutor.submit( createDynamicProxy(
				new ThreadRunnable( function() {
					var startedNs = createObject( "java", "java.lang.System" ).nanoTime()
					job.runs.incrementAndGet()
					try {
						job.callback( job.handle )
						job.lastDurationNanos.set( createObject( "java", "java.lang.System" ).nanoTime() - startedNs )
						job.lastSuccessMs.set( createObject( "java", "java.lang.System" ).currentTimeMillis() )
					} catch ( any e ) {
						job.failures.incrementAndGet()
						// Caught and logged, never left to kill future ticks —
						// same posture as HttpBridge.bx's dispatch guard and
						// Stomp.bx's server-side listener guard (see
						// Stomp.bx's "listener for" log line). Unconditional,
						// not gated behind app.set("log", false), matching
						// both of those: that setting only quiets routine
						// traffic logging, never an actual caught failure.
						println( "[Scheduler] job '" & job.name & "' threw: " & e.message )
					} finally {
						job.runningFlag.set( false )
					}
				} ),
				[ "java.lang.Runnable" ]
			) )
		} catch ( any e ) {
			// Submission itself failed before the inner finally above ever
			// got a chance to run — reset the flag here or this job would
			// otherwise "skip forever" thinking a previous run is still in
			// flight.
			job.runningFlag.set( false )
			println( "[Scheduler] job '" & job.name & "' failed to submit: " & e.message )
		}
	}

	function _cancelJob( jobId ) {
		var job = variables.jobs[ jobId ] ?: javacast( "null", "" )
		if ( isNull( job ) ) {
			return
		}
		job.future.cancel( false )
		structDelete( variables.jobs, jobId )
	}

	/**
	 * Live introspection, same pattern as Stomp.bx's getConnections()/
	 * getSubscriptions() — reads current state, not a stable data API to
	 * build app logic against. running reflects the AtomicBoolean at the
	 * moment of the call, not a snapshot guaranteed to still be accurate
	 * by the time a caller looks at it.
	 */
	function getJobs() {
		var result = {}
		for ( var jobId in variables.jobs ) {
			var job = variables.jobs[ jobId ]
			result[ jobId ] = {
				name: job.name,
				allowOverlap: job.allowOverlap,
				clustered: job.clustered,
				running: job.runningFlag.get()
			}
		}
		return result
	}

	/**
	 * Per-job metrics for app.metrics(), each labeled with the job's name — so
	 * a job that has quietly been failing for a week shows up as a rising
	 * failures counter and a stale last-success time, instead of only as
	 * lines in a log nobody is reading.
	 */
	function getMetrics() {
		var runs = []
		var failures = []
		var skipped = []
		var lastSuccess = []
		var lastDuration = []
		var running = []
		for ( var jobId in structCopy( variables.jobs ) ) {
			var job = variables.jobs[ jobId ] ?: javacast( "null", "" )
			if ( isNull( job ) ) {
				continue
			}
			var labels = { job: job.name }
			runs.append( { labels: labels, value: job.runs.get() } )
			failures.append( { labels: labels, value: job.failures.get() } )
			skipped.append( { labels: labels, value: job.skipped.get() } )
			running.append( { labels: labels, value: job.runningFlag.get() ? 1 : 0 } )
			if ( job.lastSuccessMs.get() > 0 ) {
				lastSuccess.append( { labels: labels, value: job.lastSuccessMs.get() / 1000 } )
				lastDuration.append( { labels: labels, value: job.lastDurationNanos.get() / 1000000000 } )
			}
		}
		return [
			{ name: "boxexpress_scheduler_job_runs_total", type: "counter", help: "Times the job has started running.", samples: runs },
			{ name: "boxexpress_scheduler_job_failures_total", type: "counter", help: "Runs that threw an error.", samples: failures },
			{ name: "boxexpress_scheduler_job_skipped_total", type: "counter", help: "Ticks skipped because the previous run was still going.", samples: skipped },
			{ name: "boxexpress_scheduler_job_running", type: "gauge", help: "1 while the job is running.", samples: running },
			{ name: "boxexpress_scheduler_job_last_success_timestamp_seconds", type: "gauge", help: "Unix time of the last successful run.", samples: lastSuccess },
			{ name: "boxexpress_scheduler_job_last_duration_seconds", type: "gauge", help: "How long the last successful run took.", samples: lastDuration }
		]
	}

	/**
	 * Cancels every job and stops both executors — called from
	 * BoxExpress.close(), the same teardown block that already stops
	 * reloadWatcher/undertowServer. shutdownNow() (not shutdown()) since
	 * there's no reason to let already-queued ticks run once the app is
	 * closing; a job body already in flight on the virtual-thread
	 * executor is interrupted, same as any other in-flight work when the
	 * process is going down.
	 */
	function shutdown() {
		for ( var jobId in structCopy( variables.jobs ) ) {
			_cancelJob( jobId )
		}
		variables.tickExecutor.shutdownNow()
		variables.taskExecutor.shutdownNow()
	}

}
