/**
 * Parses/serializes STOMP 1.2 frames: "COMMAND\nheader:value\n\n<body>\0".
 *
 * Header names/values are escaped per spec — backslash, newline, and colon
 * (STOMP reserves ":" as the header name/value separator, so a literal
 * colon in a value has to be escaped or it'd be misread as the start of a
 * new header). This is the actual protocol-correct fix for the same class
 * of injection SseEmitter.bx had to be fixed for: without escaping, a
 * caller putting request-derived data into a header value (a destination
 * name, say) could let a client's embedded newline break out of that
 * header line and forge extra frame content. Escaping here means it's
 * spec-compliant by construction, not just "stripped" — the value round-
 * trips correctly instead of being silently mangled.
 */
class {

	/**
	 * version picks the header escaping rules: 1.2 escapes \\, \n, \r and
	 * ":"; 1.1 the same minus \r; 1.0 does no escaping at all. CONNECT/STOMP/
	 * CONNECTED frames are never escaped in any version (per spec).
	 */
	function parse( rawText, version = "1.2" ) {
		// mid(), not left()/right(), throughout this method — confirmed
		// directly (the hard way, in this method's first draft) that
		// left()/right() throw "Count cannot be zero" on a legitimately
		// zero-length slice (an empty command, an empty body), the same
		// bug class already fixed everywhere else in this codebase
		// (RangeParser.bx, BodyParsers.bx, Multipart.bx, Request.bx —
		// see docs/ARCHITECTURE.md's BoxLang landmines section). mid()
		// with a zero count is safe (confirmed directly), unlike
		// left()/right(), so no zero-guard is needed around it.
		// The blank line ending the header block is "\n\n", or "\n\r\n" for a
		// client using CRLF line endings (STOMP 1.2 allows either).
		var lfPos = rawText.find( char( 10 ) & char( 10 ) )
		var crlfPos = rawText.find( char( 10 ) & char( 13 ) & char( 10 ) )
		var separatorPos = lfPos
		var separatorLen = 2
		if ( crlfPos && ( !lfPos || crlfPos < lfPos ) ) {
			separatorPos = crlfPos
			separatorLen = 3
		}
		var headerBlock = separatorPos ? rawText.mid( 1, separatorPos - 1 ) : rawText
		var rawBody = separatorPos ? rawText.mid( separatorPos + separatorLen, rawText.len() - separatorPos - separatorLen + 1 ) : ""

		var headerLines = headerBlock.listToArray( char( 10 ) )
		var command = _stripCR( headerLines[ 1 ] )
		var headers = {}
		var escapeVersion = listFindNoCase( "CONNECT,STOMP,CONNECTED", command ) ? "1.0" : version

		var i = 2
		while ( i <= headerLines.len() ) {
			var line = _stripCR( headerLines[ i ] )
			var colonPos = line.find( ":" )
			if ( colonPos ) {
				var key = _unescape( line.mid( 1, colonPos - 1 ), escapeVersion )
				// STOMP spec: when a header repeats, the FIRST occurrence
				// wins — a client can't override an earlier value by
				// repeating the header name later in the same frame.
				if ( !structKeyExists( headers, key ) ) {
					headers[ key ] = _unescape( line.mid( colonPos + 1, line.len() - colonPos ), escapeVersion )
				}
			}
			i++
		}

		// Per spec, a content-length header (when present) is authoritative:
		// the body is exactly that many octets, and a NUL byte inside that
		// range is part of the body, not its terminator. Honoring it here
		// (rather than always scanning for the first NUL) is what makes a
		// body containing an embedded NUL — common with binary payloads,
		// and something real client libraries send content-length for by
		// default — round-trip correctly instead of getting silently
		// truncated. Without content-length, fall back to the NUL-scan
		// (plus a single trailing newline some clients send before the
		// NUL), same as before.
		var body = ""
		var contentLength = headers[ "content-length" ] ?: ""
		if ( len( contentLength ) && isNumeric( contentLength ) ) {
			// content-length is an octet count, not a character count — the two
			// diverge on any multi-byte UTF-8 character, and counting characters
			// would pull the frame's trailing NUL into the body.
			var bodyBytes = rawBody.getBytes( "UTF-8" )
			var byteCount = min( max( int( contentLength ), 0 ), bodyBytes.len() )
			body = createObject( "java", "java.lang.String" ).init(
				createObject( "java", "java.util.Arrays" ).copyOfRange( bodyBytes, javacast( "int", 0 ), javacast( "int", byteCount ) ),
				"UTF-8"
			)
		} else {
			body = rawBody
			var nulPos = body.find( char( 0 ) )
			if ( nulPos ) {
				body = body.mid( 1, nulPos - 1 )
			}
			if ( body.len() && body.right( 1 ) == char( 10 ) ) {
				body = body.mid( 1, body.len() - 1 )
				if ( body.len() && body.right( 1 ) == char( 13 ) ) {
					body = body.mid( 1, body.len() - 1 )
				}
			}
		}

		return new "StompFrame"( command, headers, body )
	}

	/**
	 * Always emits a freshly-computed content-length (byte length, not
	 * BoxLang's character length — they diverge on any multi-byte UTF-8
	 * character, confirmed directly) rather than trusting a caller-
	 * supplied one, which could be stale or simply absent. Any
	 * content-length already present on the frame's headers is dropped in
	 * favor of this one.
	 */
	function serialize( frame, version = "1.2" ) {
		var escapeVersion = listFindNoCase( "CONNECT,STOMP,CONNECTED", frame.getCommand() ) ? "1.0" : version
		var body = frame.getBody()
		var out = frame.getCommand() & char( 10 )
		for ( var key in frame.getHeaders() ) {
			if ( key == "content-length" ) {
				continue
			}
			out &= _escape( key, escapeVersion ) & ":" & _escape( frame.getHeaders()[ key ], escapeVersion ) & char( 10 )
		}
		out &= "content-length:" & toString( body ).getBytes( "UTF-8" ).length & char( 10 )
		out &= char( 10 ) & body & char( 0 )
		return out
	}

	private function _stripCR( line ) {
		return ( line.len() && line.right( 1 ) == char( 13 ) ) ? line.mid( 1, line.len() - 1 ) : line
	}

	private function _escape( str, version = "1.2" ) {
		if ( version == "1.0" ) {
			return toString( str )
		}
		// Order matters: backslash first, so the backslashes introduced by
		// the newline/colon/CR escaping below don't themselves get escaped
		// a second time.
		var result = toString( str ).replace( "\", "\\", "all" )
			result = result.replace( char( 10 ), "\n", "all" )
			if ( version == "1.2" ) {
				result = result.replace( char( 13 ), "\r", "all" )
			}
			result = result.replace( ":", "\c", "all" )
			return result
		}

		private function _unescape( str, version = "1.2" ) {
			if ( version == "1.0" ) {
				return str
			}
			var result = ""
			var i = 1
			var len = str.len()
			while ( i <= len ) {
				var ch = str.mid( i, 1 )
				if ( ch == "\" && i < len ) {
					var next = str.mid( i + 1, 1 )
					if ( next == "n" ) {
						result &= char( 10 )
						i += 2
					} else if ( next == "c" ) {
						result &= ":"
						i += 2
					} else if ( next == "r" && version == "1.2" ) {
						result &= char( 13 )
						i += 2
					} else if ( next == "\" ) {
						result &= "\"
						i += 2
					} else {
						// An unrecognized escape — leave the backslash literal
						// rather than throwing, matching this project's
						// generally-lenient parsing posture elsewhere
						// (RangeParser falls back to "full" on anything it
						// can't parse rather than erroring the request).
						result &= ch
						i++
					}
				} else {
					result &= ch
					i++
				}
			}
			return result
		}

	}
