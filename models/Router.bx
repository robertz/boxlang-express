/**
 * Route table + middleware stack + dispatch/next() logic.
 * Mirrors Express's Router: app.get/post/put/patch/delete/all/use, mountable sub-routers.
 *
 * Register all routes/middleware before calling app.listen(). The route table isn't
 * synchronized, so adding routes concurrently with in-flight requests (which each run
 * on their own virtual thread once listening) is unsupported.
 */
class {

	function init( settings = {} ) {
		variables.stack = []
		variables.settings = settings
		variables.paramHandlers = {}
		return this
	}

	function get( path ) {
		return _addRoute( "GET", path, _extraHandlers( arguments ) )
	}

	function post( path ) {
		return _addRoute( "POST", path, _extraHandlers( arguments ) )
	}

	function put( path ) {
		return _addRoute( "PUT", path, _extraHandlers( arguments ) )
	}

	function patch( path ) {
		return _addRoute( "PATCH", path, _extraHandlers( arguments ) )
	}

	function delete( path ) {
		return _addRoute( "DELETE", path, _extraHandlers( arguments ) )
	}

	function all( path ) {
		return _addRoute( "ALL", path, _extraHandlers( arguments ) )
	}

	/**
	 * Registers a param-preprocessing callback: param( "id", (req, res, next, value) => {...} ).
	 * Runs once per matched route whose pattern captures that param name, before the
	 * route's own handler(s) — same idea as Express's app.param(). Call next(err) to
	 * abort with an error, or next() to continue into the route handler.
	 */
	function param( name, callback ) {
		variables.paramHandlers[ name ] = callback
		return this
	}

	/**
	 * route( path ) returns a chainable builder scoped to a single path:
	 *   router.route( "/users/:id" ).get( getHandler ).put( putHandler ).delete( deleteHandler )
	 * Equivalent to calling router.get/put/delete(path, handler) separately — sugar only.
	 */
	function route( path ) {
		var self = this
		var builder = {}

		builder.get = function() { self._addRoute( "GET", path, _routeHandlers( arguments ) ); return builder }
		builder.post = function() { self._addRoute( "POST", path, _routeHandlers( arguments ) ); return builder }
		builder.put = function() { self._addRoute( "PUT", path, _routeHandlers( arguments ) ); return builder }
		builder.patch = function() { self._addRoute( "PATCH", path, _routeHandlers( arguments ) ); return builder }
		builder.delete = function() { self._addRoute( "DELETE", path, _routeHandlers( arguments ) ); return builder }
		builder.all = function() { self._addRoute( "ALL", path, _routeHandlers( arguments ) ); return builder }

		return builder
	}

	/**
	 * use( middlewareFn )
	 * use( mountPath, middlewareFn )
	 * use( mountPath, subRouter )
	 */
	function use( pathOrHandler, handlerOrRouter ) {
		var mountPath = "/"
		var target = pathOrHandler

		if ( !isNull( handlerOrRouter ) ) {
			mountPath = pathOrHandler
			target = handlerOrRouter
		}

		if ( isInstanceOf( target, "Router" ) ) {
			variables.stack.append( {
				method: "USE",
				isRouter: true,
				router: target,
				pattern: _parsePath( mountPath )
			} )
		} else {
			variables.stack.append( {
				method: "USE",
				isRouter: false,
				handler: target,
				isErrorHandler: _isErrorHandler( target ),
				pattern: _parsePath( mountPath )
			} )
		}

		return this
	}

	/**
	 * Dispatch a request through the stack.
	 * finalNext( err ) is invoked when the stack is exhausted (used by sub-router mounting
	 * to hand control back to the parent chain). When omitted, exhausting the stack triggers
	 * the built-in 404 / 500 defaults.
	 */
	function dispatch( req, res, finalNext ) {
		var stackRef = variables.stack
		var idx = 0
		var self = this
		var next

		next = function( err ) {
			if ( res.isSent() ) {
				return
			}

			if ( idx >= stackRef.len() ) {
				if ( !isNull( finalNext ) ) {
					isNull( err ) ? finalNext() : finalNext( err )
				} else {
					isNull( err ) ? self._final( javacast( "null", "" ), req, res ) : self._final( err, req, res )
				}
				return
			}

			idx++
			var layer = stackRef[ idx ]
			var isErrorLayer = layer.isRouter ? false : layer.isErrorHandler

			if ( !isNull( err ) && !isErrorLayer ) {
				return next( err )
			}
			if ( isNull( err ) && isErrorLayer ) {
				return next()
			}

			if ( layer.method != "USE" && layer.method != "ALL" && layer.method != req.method ) {
				return isNull( err ) ? next() : next( err )
			}

			var exactMatch = ( layer.method != "USE" )
			var reqSegments = _splitPath( req.path )
			var matchResult = _matchPath( layer.pattern.segments, reqSegments, exactMatch )

			if ( !matchResult.matched ) {
				return isNull( err ) ? next() : next( err )
			}

			for ( var paramName in matchResult.params ) {
				req.params[ paramName ] = matchResult.params[ paramName ]
			}

			if ( layer.method == "USE" ) {
				var savedPath = req.path
				var remainder = "/" & reqSegments.slice( matchResult.consumed + 1 ).toList( "/" )
				req.path = remainder
				var scopedNext = function( innerErr ) {
					req.path = savedPath
					if ( isNull( innerErr ) ) {
						next()
					} else {
						next( innerErr )
					}
				}

				if ( layer.isRouter ) {
					layer.router.dispatch( req, res, scopedNext )
				} else {
					try {
						if ( isErrorLayer ) {
							layer.handler( err, req, res, scopedNext )
						} else {
							layer.handler( req, res, scopedNext )
						}
					} catch ( any e ) {
						req.path = savedPath
						next( e )
					}
				}
				return
			}

			var pendingParams = []
			for ( var paramName in matchResult.params ) {
				if ( !isNull( variables.paramHandlers[ paramName ] ) ) {
					pendingParams.append( paramName )
				}
			}

			if ( pendingParams.len() ) {
				return self._runParamHandlers( pendingParams, 1, req, res, function( paramErr ) {
					if ( !isNull( paramErr ) ) {
						return next( paramErr )
					}
					try {
						layer.handler( req, res, next )
					} catch ( any e ) {
						next( e )
					}
				} )
			}

			try {
				layer.handler( req, res, next )
			} catch ( any e ) {
				next( e )
			}
		}

		next()
	}

	/**
	 * Runs registered param() callbacks in sequence for a matched route, one per
	 * captured param name that has a handler — each callback's next(err) either moves
	 * on to the next pending param or (with an error) aborts straight to doneFn.
	 */
	function _runParamHandlers( names, position, req, res, doneFn ) {
		if ( position > names.len() ) {
			return doneFn( javacast( "null", "" ) )
		}

		var name = names[ position ]
		var handler = variables.paramHandlers[ name ]
		var value = req.params[ name ]
		var self = this

		try {
			handler( req, res, function( err ) {
				if ( !isNull( err ) ) {
					return doneFn( err )
				}
				self._runParamHandlers( names, position + 1, req, res, doneFn )
			}, value )
		} catch ( any e ) {
			doneFn( e )
		}
	}

	/**
	 * The default 500 body hides the real error message unless the app has opted in
	 * with app.set("env", "development") — an unhandled exception's message (file
	 * paths, driver errors, internal identifiers, whatever the thrown error happened
	 * to contain) would otherwise leak straight through to an unauthenticated client.
	 * The full message is always logged server-side via HttpBridge regardless.
	 */
	function _final( err, req, res ) {
		if ( res.isSent() ) {
			return
		}
		if ( !isNull( err ) ) {
			var message = ( variables.settings[ "env" ] ?: "" ) == "development"
				? _errorMessage( err )
				: "Internal Server Error"
			res.status( 500 ).json( { error: true, message: message } )
		} else {
			res.status( 404 ).json( { error: true, message: "Cannot #req.method# #req.path#" } )
		}
	}

	private function _errorMessage( err ) {
		try {
			return err.message
		} catch ( any e ) {
			return err.toString()
		}
	}

	function _addRoute( method, path, handlers ) {
		if ( handlers.len() == 0 ) {
			throw(
				message = "#method# ""#path#"" was registered with no handler function",
				type = "BoxExpress.MissingHandler"
			)
		}

		var pattern = _parsePath( path )
		for ( var handler in handlers ) {
			variables.stack.append( {
				method: method,
				isRouter: false,
				handler: handler,
				isErrorHandler: false,
				pattern: pattern
			} )
		}
		return this
	}

	private function _extraHandlers( argScope ) {
		var handlers = []
		for ( var i = 2; i <= argScope.count(); i++ ) {
			handlers.append( argScope[ i ] )
		}
		return handlers
	}

	private function _routeHandlers( argScope ) {
		var handlers = []
		for ( var i = 1; i <= argScope.count(); i++ ) {
			handlers.append( argScope[ i ] )
		}
		return handlers
	}

	private function _isErrorHandler( handler ) {
		return getMetadata( handler ).parameters.len() == 4
	}

	private function _splitPath( path ) {
		var parts = path.listToArray( "/" )
		return parts
	}

	private function _parsePath( path ) {
		var segments = []
		var paramNames = []
		var rawSegments = _splitPath( path )

		for ( var i = 1; i <= rawSegments.len(); i++ ) {
			var raw = rawSegments[ i ]
			if ( raw.left( 1 ) == ":" ) {
				var paramName = raw.right( raw.len() - 1 )
				segments.append( { type: "param", name: paramName } )
				paramNames.append( paramName )
			} else if ( raw == "*" ) {
				if ( i != rawSegments.len() ) {
					throw(
						message = "Invalid route path ""#path#"" — '*' is only supported as the final path segment",
						type = "BoxExpress.InvalidRoutePath"
					)
				}
				segments.append( { type: "wildcard" } )
			} else {
				segments.append( { type: "literal", value: raw } )
			}
		}
		return { segments: segments, paramNames: paramNames }
	}

	private function _matchPath( patternSegments, requestSegments, exact ) {
		var params = {}
		var i = 0

		for ( i = 1; i <= patternSegments.len(); i++ ) {
			var seg = patternSegments[ i ]

			if ( seg.type == "wildcard" ) {
				return { matched: true, params: params, consumed: requestSegments.len() }
			}

			if ( i > requestSegments.len() ) {
				return { matched: false, params: {}, consumed: 0 }
			}

			if ( seg.type == "param" ) {
				params[ seg.name ] = requestSegments[ i ]
			} else if ( seg.value != requestSegments[ i ] ) {
				return { matched: false, params: {}, consumed: 0 }
			}
		}

		if ( exact && patternSegments.len() != requestSegments.len() ) {
			return { matched: false, params: {}, consumed: 0 }
		}

		return { matched: true, params: params, consumed: patternSegments.len() }
	}

}
