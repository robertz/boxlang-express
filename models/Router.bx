/**
 * Route table + middleware stack + dispatch/next() logic.
 * Mirrors Express's Router: app.get/post/put/patch/delete/all/use, mountable sub-routers.
 *
 * Register all routes/middleware before calling app.listen(). The route table isn't
 * synchronized, so adding routes concurrently with in-flight requests (which each run
 * on their own virtual thread once listening) is unsupported.
 */
class {

	function init( settings = {} ) {
		variables.stack = []
		variables.settings = settings
		variables.paramHandlers = {}
		return this
	}

	function get( path ) {
		return _addRoute( "GET", path, _extraHandlers( arguments ) )
	}

	function post( path ) {
		return _addRoute( "POST", path, _extraHandlers( arguments ) )
	}

	function put( path ) {
		return _addRoute( "PUT", path, _extraHandlers( arguments ) )
	}

	function patch( path ) {
		return _addRoute( "PATCH", path, _extraHandlers( arguments ) )
	}

	function delete( path ) {
		return _addRoute( "DELETE", path, _extraHandlers( arguments ) )
	}

	function head( path ) {
		return _addRoute( "HEAD", path, _extraHandlers( arguments ) )
	}

	function all( path ) {
		return _addRoute( "ALL", path, _extraHandlers( arguments ) )
	}

	/**
	 * Registers a param-preprocessing callback: param( "id", (req, res, next, value) => {...} ).
	 * Runs once per matched route whose pattern captures that param name, before the
	 * route's own handler(s) — same idea as Express's app.param(). Call next(err) to
	 * abort with an error, or next() to continue into the route handler.
	 */
	function param( name, callback ) {
		variables.paramHandlers[ name ] = callback
		return this
	}

	/**
	 * route( path ) returns a chainable builder scoped to a single path:
	 *   router.route( "/users/:id" ).get( getHandler ).put( putHandler ).delete( deleteHandler )
	 * Equivalent to calling router.get/put/delete(path, handler) separately — sugar only.
	 */
	function route( path ) {
		var self = this
		var builder = {}

		builder.get = function() { self._addRoute( "GET", path, _routeHandlers( arguments ) ); return builder }
		builder.post = function() { self._addRoute( "POST", path, _routeHandlers( arguments ) ); return builder }
		builder.put = function() { self._addRoute( "PUT", path, _routeHandlers( arguments ) ); return builder }
		builder.patch = function() { self._addRoute( "PATCH", path, _routeHandlers( arguments ) ); return builder }
		builder.delete = function() { self._addRoute( "DELETE", path, _routeHandlers( arguments ) ); return builder }
		builder.all = function() { self._addRoute( "ALL", path, _routeHandlers( arguments ) ); return builder }

		return builder
	}

	/**
	 * use( middlewareFn )
	 * use( middlewareFn1, middlewareFn2, ... )
	 * use( mountPath, middlewareFn )
	 * use( mountPath, middlewareFn1, middlewareFn2, ..., subRouter )
	 * use( mountPath, subRouter )
	 *
	 * The first argument is a mount path only when it's a plain string — anything
	 * else (a closure/function, or a Router) is a target, and every argument
	 * after the path (or all of them, when there's no path) is registered as
	 * its own stack layer at that same mount point, in order.
	 */
	function use( pathOrHandler = "" ) {
		if ( arguments.count() == 0 ) {
			throw( message = "use() requires at least one handler or router", type = "BoxExpress.MissingHandler" )
		}

		var mountPath = "/"
		var startIndex = 1

		if ( isSimpleValue( pathOrHandler ) ) {
			mountPath = pathOrHandler
			startIndex = 2
		}

		if ( startIndex > arguments.count() ) {
			throw( message = "use(""#mountPath#"") requires at least one handler or router", type = "BoxExpress.MissingHandler" )
		}

		var pattern = _parsePath( mountPath )

		for ( var i = startIndex; i <= arguments.count(); i++ ) {
			var target = arguments[ i ]

			if ( isInstanceOf( target, "Router" ) ) {
				variables.stack.append( {
					method: "USE",
					isRouter: true,
					router: target,
					pattern: pattern
				} )
			} else {
				variables.stack.append( {
					method: "USE",
					isRouter: false,
					handler: target,
					isErrorHandler: _isErrorHandler( target ),
					pattern: pattern
				} )
			}
		}

		return this
	}

	/**
	 * Dispatch a request through the stack.
	 * finalNext( err ) is invoked when the stack is exhausted (used by sub-router mounting
	 * to hand control back to the parent chain). When omitted, exhausting the stack triggers
	 * the built-in 404 / 500 defaults.
	 */
	function dispatch( req, res, finalNext ) {
		var stackRef = variables.stack
		var idx = 0
		var self = this
		var next
		// Cache of _splitPath( req.path ), invalidated only when req.path itself
		// changes (a USE layer mounting/unmounting) — without this, every layer
		// in the stack re-splits the same path string, even though it's usually
		// unchanged from the layer before it.
		var cachedPath = javacast( "null", "" )
		var cachedSegments = javacast( "null", "" )

		next = function( err ) {
			if ( res.isSent() ) {
				return
			}

			// A request the watchdog interrupted is answered by HttpBridge,
			// not by error-handling middleware — the error here is only how
			// the interrupt happened to surface (see RequestWatchdog.bx).
			if ( !isNull( err ) && ( req.timedOut ?: false ) ) {
				throw( type = "BoxExpress.RequestTimeout", message = "Request timed out" )
			}

			// Layers that don't apply are skipped in this loop rather than by
			// calling next() again — recursing once per skipped layer made the
			// stack grow with the size of the route table, and a 404 in an app
			// with a few hundred routes overflowed it.
			var layer = ""
			var isErrorLayer = false
			var matchResult = ""
			var reqSegments = ""
			while ( true ) {
				if ( idx >= stackRef.len() ) {
					if ( !isNull( finalNext ) ) {
						isNull( err ) ? finalNext() : finalNext( err )
					} else {
						isNull( err ) ? self._final( javacast( "null", "" ), req, res ) : self._final( err, req, res )
					}
					return
				}

				idx++
				layer = stackRef[ idx ]
				isErrorLayer = layer.isRouter ? false : layer.isErrorHandler

				if ( isNull( err ) == isErrorLayer ) {
					continue
				}

				// A HEAD request also matches a GET-registered layer (same handler
				// Express reuses for HEAD) — a layer registered with app.head() still
				// wins if it comes first in the stack, since that's a plain exact match.
				var methodMatches = ( layer.method == req.method ) || ( req.method == "HEAD" && layer.method == "GET" )
				if ( layer.method != "USE" && layer.method != "ALL" && !methodMatches ) {
					continue
				}

				if ( isNull( cachedPath ) || compare( cachedPath, req.path ) != 0 ) {
					cachedPath = req.path
					cachedSegments = _splitPath( req.path )
				}
				reqSegments = cachedSegments
				matchResult = _matchPath( layer.pattern.segments, reqSegments, layer.method != "USE" )
				if ( matchResult.matched ) {
					break
				}
			}

			for ( var paramName in matchResult.params ) {
				req.params[ paramName ] = matchResult.params[ paramName ]
			}

			if ( layer.method == "USE" ) {
				var savedPath = req.path
				var savedBaseUrl = req.baseUrl ?: ""
				var remainder = "/" & reqSegments.slice( matchResult.consumed + 1 ).toList( "/" )
				// _splitPath()/listToArray() drops empty segments, so a trailing
				// slash on the incoming path leaves no trace in reqSegments —
				// reattach it here from the pre-mutation path string, the only
				// place that still knows it was there. Without this, every
				// app.use()-mounted layer (nearly everything, since even a
				// root-mounted "/" layer takes this branch) silently strips a
				// trailing slash from req.path, which broke static-file
				// directory-index resolution ("/foo/" -> "/foo/index.html").
				if ( savedPath.right( 1 ) == "/" && remainder.right( 1 ) != "/" ) {
					remainder &= "/"
				}
				req.path = remainder
				req.baseUrl = savedBaseUrl & ( matchResult.consumed > 0 ? "/" & reqSegments.slice( 1, matchResult.consumed ).toList( "/" ) : "" )
				var scopedNext = function( innerErr ) {
					req.path = savedPath
					req.baseUrl = savedBaseUrl
					if ( isNull( innerErr ) ) {
						next()
					} else {
						next( innerErr )
					}
				}

				if ( layer.isRouter ) {
					layer.router.dispatch( req, res, scopedNext )
				} else {
					try {
						if ( isErrorLayer ) {
							layer.handler( err, req, res, scopedNext )
						} else {
							layer.handler( req, res, scopedNext )
						}
					} catch ( any e ) {
						req.path = savedPath
						req.baseUrl = savedBaseUrl
						next( e )
					}
				}
				return
			}

			var pendingParams = []
			for ( var paramName in matchResult.params ) {
				if ( !isNull( variables.paramHandlers[ paramName ] ) ) {
					pendingParams.append( paramName )
				}
			}

			if ( pendingParams.len() ) {
				return self._runParamHandlers( pendingParams, 1, req, res, function( paramErr ) {
					if ( !isNull( paramErr ) ) {
						return next( paramErr )
					}
					try {
						layer.handler( req, res, next )
					} catch ( any e ) {
						next( e )
					}
				} )
			}

			try {
				layer.handler( req, res, next )
			} catch ( any e ) {
				next( e )
			}
		}

		next()
	}

	/**
	 * Runs registered param() callbacks in sequence for a matched route, one per
	 * captured param name that has a handler — each callback's next(err) either moves
	 * on to the next pending param or (with an error) aborts straight to doneFn.
	 */
	function _runParamHandlers( names, position, req, res, doneFn ) {
		if ( position > names.len() ) {
			return doneFn( javacast( "null", "" ) )
		}

		var name = names[ position ]
		var handler = variables.paramHandlers[ name ]
		var value = req.params[ name ]
		var self = this

		try {
			handler( req, res, function( err ) {
				if ( !isNull( err ) ) {
					return doneFn( err )
				}
				self._runParamHandlers( names, position + 1, req, res, doneFn )
				}, value )
		} catch ( any e ) {
			doneFn( e )
		}
	}

	/**
	 * The default 500 body hides the real error message unless the app has opted in
	 * with app.set("env", "development") — an unhandled exception's message (file
	 * paths, driver errors, internal identifiers, whatever the thrown error happened
	 * to contain) would otherwise leak straight through to an unauthenticated client.
	 * The full message is always logged server-side via HttpBridge regardless.
	 */
	function _final( err, req, res ) {
		if ( res.isSent() ) {
			return
		}
		if ( !isNull( err ) ) {
			var message = ( variables.settings[ "env" ] ?: "" ) == "development"
				? _errorMessage( err )
				: "Internal Server Error"
			res.status( 500 ).json( { error: true, message: message } )
		} else {
			res.status( 404 ).json( { error: true, message: "Cannot #req.method# #req.path#" } )
		}
	}

	private function _errorMessage( err ) {
		try {
			return err.message
		} catch ( any e ) {
			return err.toString()
		}
	}

	function _addRoute( method, path, handlers ) {
		if ( handlers.len() == 0 ) {
			throw(
				message = "#method# ""#path#"" was registered with no handler function",
				type = "BoxExpress.MissingHandler"
			)
		}

		var pattern = _parsePath( path )
		for ( var handler in handlers ) {
			variables.stack.append( {
				method: method,
				isRouter: false,
				handler: handler,
				isErrorHandler: false,
				pattern: pattern
			} )
		}
		return this
	}

	private function _extraHandlers( argScope ) {
		var handlers = []
		for ( var i = 2; i <= argScope.count(); i++ ) {
			handlers.append( argScope[ i ] )
		}
		return handlers
	}

	private function _routeHandlers( argScope ) {
		var handlers = []
		for ( var i = 1; i <= argScope.count(); i++ ) {
			handlers.append( argScope[ i ] )
		}
		return handlers
	}

	private function _isErrorHandler( handler ) {
		return getMetadata( handler ).parameters.len() == 4
	}

	private function _splitPath( path ) {
		var parts = path.listToArray( "/" )
		return parts
	}

	private function _parsePath( path ) {
		var segments = []
		var paramNames = []
		var rawSegments = _splitPath( path )

		for ( var i = 1; i <= rawSegments.len(); i++ ) {
			var raw = rawSegments[ i ]
			var isLast = ( i == rawSegments.len() )

			if ( raw.left( 1 ) == "*" ) {
				if ( !isLast ) {
					throw(
						message = "Invalid route path ""#path#"" — '*' is only supported as the final path segment",
						type = "BoxExpress.InvalidRoutePath"
					)
				}
				// "*" matches the rest of the path; "*name" also captures it.
				var wildcardName = raw.mid( 2, raw.len() )
				if ( len( wildcardName ) && !reFind( "^[A-Za-z0-9_]+$", wildcardName ) ) {
					_invalidPath( path, "'#raw#' is not a valid wildcard name" )
				}
				segments.append( { type: "wildcard", name: wildcardName } )
				if ( len( wildcardName ) ) {
					paramNames.append( wildcardName )
				}
			} else if ( _isPlainParam( raw ) ) {
				var optional = raw.right( 1 ) == "?"
				if ( optional && !isLast ) {
					throw(
						message = "Invalid route path ""#path#"" — an optional param (':name?') is only supported as the final path segment",
						type = "BoxExpress.InvalidRoutePath"
					)
				}
				var paramName = raw.mid( 2, raw.len() - ( optional ? 2 : 1 ) )
				if ( !len( paramName ) ) {
					throw(
						message = "Invalid route path ""#path#"" — ':' alone is not a valid param name (did you mean ':name'?)",
						type = "BoxExpress.InvalidRoutePath"
					)
				}
				segments.append( { type: optional ? "optionalParam" : "param", name: paramName } )
				paramNames.append( paramName )
			} else if ( raw.find( ":" ) ) {
				var compiled = _compileSegment( path, raw, isLast )
				segments.append( compiled )
				paramNames.append( compiled.names, true )
			} else {
				segments.append( { type: "literal", value: raw } )
			}
		}
		return { segments: segments, paramNames: paramNames }
	}

	/**
	 * ":name" or ":name?" with nothing else in the segment — the original
	 * param syntax, where everything after the colon is the name (so
	 * ":user-id" stays one param called "user-id"). A segment with a
	 * constraint, more than one param, or text around a param goes through
	 * _compileSegment() instead.
	 */
	private function _isPlainParam( raw ) {
		return raw.left( 1 ) == ":" && !raw.find( "(" ) && !raw.find( ":", 2 )
	}

	/**
	 * Compiles a segment mixing params with text or constraints into a
	 * regex over that one segment:
	 *
	 *   :id(\d+)        a param that must match a pattern
	 *   :from-:to        two params around a literal
	 *   v:version        a param after a literal prefix
	 *   :name(.+).json   a constrained param before a literal suffix
	 *   :id(\d+)?       optional, as the final segment
	 *
	 * In a compiled segment a param's name is letters, digits and
	 * underscores, and ends at the first other character.
	 */
	private function _compileSegment( path, raw, isLast ) {
		var regex = ""
		var names = []
		var pos = 1
		var optional = false
		var soleParam = false

		while ( pos <= raw.len() ) {
			var ch = raw.mid( pos, 1 )
			if ( ch != ":" ) {
				var nextColon = raw.find( ":", pos )
				var literalEnd = nextColon ? nextColon - 1 : raw.len()
				regex &= createObject( "java", "java.util.regex.Pattern" ).quote( raw.mid( pos, literalEnd - pos + 1 ) )
				pos = literalEnd + 1
				continue
			}

			var nameMatch = reFind( "^[A-Za-z0-9_]+", raw.mid( pos + 1, raw.len() ), 1, true )
			if ( !nameMatch.len[ 1 ] ) {
				_invalidPath( path, "':' in '#raw#' isn't followed by a param name" )
			}
			var paramName = raw.mid( pos + 1, nameMatch.len[ 1 ] )
			if ( names.findNoCase( paramName ) ) {
				_invalidPath( path, "param ':#paramName#' appears twice in '#raw#'" )
			}
			var paramStart = pos
			pos += 1 + nameMatch.len[ 1 ]

			var constraint = "[^/]+?"
			if ( raw.mid( pos, 1 ) == "(" ) {
				var closeAt = _closingParen( raw, pos )
				if ( !closeAt ) {
					_invalidPath( path, "the constraint on ':#paramName#' has no closing ')' — a constraint can't contain '/'" )
				}
				constraint = raw.mid( pos + 1, closeAt - pos - 1 )
				if ( !len( constraint ) ) {
					_invalidPath( path, "the constraint on ':#paramName#' is empty" )
				}
				pos = closeAt + 1
			}

			names.append( paramName )
			// Named groups, so capture groups inside a constraint don't
			// shift which group belongs to which param.
			regex &= "(?<p" & names.len() & ">" & constraint & ")"

			if ( raw.mid( pos, 1 ) == "?" ) {
				if ( paramStart != 1 || pos != raw.len() ) {
					_invalidPath( path, "'?' in '#raw#' only works on a param that is the whole segment" )
				}
				if ( !isLast ) {
					throw(
						message = "Invalid route path ""#path#"" — an optional param (':name?') is only supported as the final path segment",
						type = "BoxExpress.InvalidRoutePath"
					)
				}
				optional = true
				pos++
			}
		}

		var pattern = ""
		try {
			// Case-insensitive, like literal segments.
			pattern = createObject( "java", "java.util.regex.Pattern" ).compile( "^" & regex & "$", javacast( "int", 2 ) )
		} catch ( any e ) {
			_invalidPath( path, "'#raw#' doesn't compile to a valid pattern (#e.message#)" )
		}
		return { type: optional ? "optionalPattern" : "pattern", pattern: pattern, names: names }
	}

	/**
	 * The position of the ')' closing the '(' at openAt, skipping escaped
	 * and nested parens; 0 if there isn't one.
	 */
	private function _closingParen( text, openAt ) {
		var depth = 0
		var inClass = false
		for ( var i = openAt; i <= text.len(); i++ ) {
			var ch = text.mid( i, 1 )
			if ( ch == "\" ) {
				i++
			} else if ( inClass ) {
				inClass = ( ch != "]" )
			} else if ( ch == "[" ) {
				inClass = true
			} else if ( ch == "(" ) {
				depth++
			} else if ( ch == ")" ) {
				depth--
				if ( depth == 0 ) {
					return i
				}
			}
		}
		return 0
	}

	private function _invalidPath( path, reason ) {
		throw( message = "Invalid route path ""#path#"" — #reason#", type = "BoxExpress.InvalidRoutePath" )
	}

	private function _matchPath( patternSegments, requestSegments, exact ) {
		var params = {}
		var i = 0

		for ( i = 1; i <= patternSegments.len(); i++ ) {
			var seg = patternSegments[ i ]

			if ( seg.type == "wildcard" ) {
				if ( len( seg.name ) ) {
					params[ seg.name ] = i > requestSegments.len() ? "" : requestSegments.slice( i ).toList( "/" )
				}
				return { matched: true, params: params, consumed: requestSegments.len() }
			}

			// Always the final pattern segment (enforced in _parsePath()) — if the
			// request doesn't have this segment, the route still matches, just
			// without that param captured (like Express's req.params.id === undefined).
			if ( ( seg.type == "optionalParam" || seg.type == "optionalPattern" ) && i > requestSegments.len() ) {
				return { matched: true, params: params, consumed: i - 1 }
			}

			if ( i > requestSegments.len() ) {
				return { matched: false, params: {}, consumed: 0 }
			}

			if ( seg.type == "param" || seg.type == "optionalParam" ) {
				params[ seg.name ] = requestSegments[ i ]
			} else if ( seg.type == "pattern" || seg.type == "optionalPattern" ) {
				var matcher = seg.pattern.matcher( requestSegments[ i ] )
				if ( !matcher.matches() ) {
					return { matched: false, params: {}, consumed: 0 }
				}
				for ( var n = 1; n <= seg.names.len(); n++ ) {
					params[ seg.names[ n ] ] = matcher.group( "p" & n )
				}
			} else if ( seg.value != requestSegments[ i ] ) {
				return { matched: false, params: {}, consumed: 0 }
			}
		}

		if ( exact && patternSegments.len() != requestSegments.len() ) {
			return { matched: false, params: {}, consumed: 0 }
		}

		return { matched: true, params: params, consumed: patternSegments.len() }
	}

}
