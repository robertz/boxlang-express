/**
 * Bridges an exchange adapter (see models/adapters/UndertowExchangeAdapter)
 * into the Request/Response/Router world. Engine-neutral by construction:
 * this class never builds the adapter itself — UndertowHandlerGlue wraps
 * the raw Undertow exchange into an adapter and calls handle() with it.
 * Never used directly by application code.
 */
class {

	function init( router, settings, appLocals = {}, metrics = "" ) {
		variables.router = router
		variables.settings = settings
		variables.appLocals = appLocals
		// "" (not a real null) when metrics aren't enabled — a null parameter
		// can't be referenced by name, see StompMessage.bx's init().
		variables.metrics = metrics
		variables.color = new AnsiColor()
		return this
	}

	function handle( exchangeAdapter ) {
		var req = ""
		var res = ""
		var requestId = ""
		var startedNs = createObject( "java", "java.lang.System" ).nanoTime()

		try {
			req = new Request( exchangeAdapter, variables.settings )
			res = new Response( exchangeAdapter, variables.settings, variables.appLocals )
			if ( variables.settings[ "requestId" ] ?: false ) {
				requestId = _resolveRequestId( req )
				req.id = requestId
				res.set( variables.settings[ "requestIdHeader" ] ?: "X-Request-Id", requestId )
			}
			// The one log line every single request pays for, whether anyone's
			// watching stdout or not — opt out with app.set("log", false) for a
			// high-throughput deployment that doesn't want it (println is a
			// synchronized write, so concurrent requests briefly serialize on it).
			// Unlike this, the error paths below always log: those are actual
			// server-side failures, not routine traffic.
			if ( variables.settings[ "log" ] ?: true ) {
				println( variables.color.gray( "[#dateTimeFormat( now(), 'yyyy-MM-dd HH:mm:ss' )#]" ) & _idTag( requestId ) & " " & variables.color.method( req.method ) & " #req.path# " & variables.color.dim( req.ip ) )
			}
		} catch ( any e ) {
			println( variables.color.gray( "[#dateTimeFormat( now(), 'yyyy-MM-dd HH:mm:ss' )#]" ) & " " & variables.color.red( "Failed to construct Request/Response: #e.message#" ) )
			// Safe to use the adapter here now (unlike before step 2b's
			// refactor) — by the time handle() runs, the adapter itself is
			// already constructed successfully by the caller's glue; only
			// Request/Response construction from it can fail here.
			try {
				var message = ( variables.settings[ "env" ] ?: "" ) == "development" ? e.message : "Internal Server Error"
				var bodyBytes = JSONSerialize( { error: true, message: message } ).getBytes( "UTF-8" )
				exchangeAdapter.setHeader( "Content-Type", "application/json" )
				exchangeAdapter.sendBody( 500, bodyBytes )
			} catch ( any ignore ) {
				try {
					exchangeAdapter.sendHeadersOnly( 500 )
				} catch ( any ignoreToo ) {
				}
			}
			return
		}

		try {
			variables.router.dispatch( req, res )
		} catch ( any e ) {
			println( variables.color.gray( "[#dateTimeFormat( now(), 'yyyy-MM-dd HH:mm:ss' )#]" ) & _idTag( requestId ) & " " & variables.color.red( "Unhandled error dispatching #req.method# #req.path#: #e.message#" ) )
			if ( !res.isSent() ) {
				try {
					var message = ( variables.settings[ "env" ] ?: "" ) == "development" ? e.message : "Internal Server Error"
					res.status( 500 ).json( { error: true, message: message } )
				} catch ( any ignore ) {
				}
			}
		} finally {
			if ( !res.isSent() ) {
				try {
					res.status( 500 ).send( "Internal Server Error" )
				} catch ( any ignore ) {
				}
			}
			if ( !isSimpleValue( variables.metrics ) ) {
				variables.metrics.recordRequest( res.getStatusCode(), createObject( "java", "java.lang.System" ).nanoTime() - startedNs )
			}
		}
	}

	/**
	 * Uses the caller's X-Request-Id when it looks like an id — short, and only
	 * characters that are safe to put in a log line and a response header (it
	 * comes from the client, so it's untrusted) — otherwise mints one.
	 */
	private function _resolveRequestId( req ) {
		var headerName = variables.settings[ "requestIdHeader" ] ?: "X-Request-Id"
		var incoming = req.headers[ headerName ] ?: ""
		if ( len( incoming ) && reFind( "^[A-Za-z0-9._\-]{1,128}$", incoming ) ) {
			return incoming
		}
		return lCase( createUUID() )
	}

	private function _idTag( requestId ) {
		return len( requestId ) ? " " & variables.color.dim( "[" & requestId & "]" ) : ""
	}

}
