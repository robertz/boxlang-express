/**
 * Internal adapter: implements java's HttpHandler (via createDynamicProxy) and
 * bridges a raw HttpExchange into the Request/Response/Router world.
 * Never used directly by application code.
 */
class {

	function init( router, settings, appLocals = {} ) {
		variables.router = router
		variables.settings = settings
		variables.appLocals = appLocals
		variables.color = new AnsiColor()
		return this
	}

	function handle( exchange ) {
		var req = ""
		var res = ""

		try {
			req = new Request( exchange, variables.settings )
			res = new Response( exchange, variables.settings, variables.appLocals )
			println( variables.color.gray( "[#dateTimeFormat( now(), 'yyyy-MM-dd HH:mm:ss' )#]" ) & " " & variables.color.method( req.method ) & " #req.path# " & variables.color.dim( req.ip ) )
		} catch ( any e ) {
			println( variables.color.gray( "[#dateTimeFormat( now(), 'yyyy-MM-dd HH:mm:ss' )#]" ) & " " & variables.color.red( "Failed to construct Request/Response: #e.message#" ) )
			try {
				var message = ( variables.settings[ "env" ] ?: "" ) == "development" ? e.message : "Internal Server Error"
				var bodyBytes = JSONSerialize( { error: true, message: message } ).getBytes( "UTF-8" )
				exchange.getResponseHeaders().set( "Content-Type", "application/json" )
				exchange.sendResponseHeaders( 500, bodyBytes.len() )
				var outStream = exchange.getResponseBody()
				outStream.write( bodyBytes )
				outStream.close()
			} catch ( any ignore ) {
				try {
					exchange.sendResponseHeaders( 500, -1 )
					exchange.close()
				} catch ( any ignoreToo ) {
				}
			}
			return
		}

		try {
			variables.router.dispatch( req, res )
		} catch ( any e ) {
			println( variables.color.gray( "[#dateTimeFormat( now(), 'yyyy-MM-dd HH:mm:ss' )#]" ) & " " & variables.color.red( "Unhandled error dispatching #req.method# #req.path#: #e.message#" ) )
			if ( !res.isSent() ) {
				try {
					var message = ( variables.settings[ "env" ] ?: "" ) == "development" ? e.message : "Internal Server Error"
					res.status( 500 ).json( { error: true, message: message } )
				} catch ( any ignore ) {
				}
			}
		} finally {
			if ( !res.isSent() ) {
				try {
					res.status( 500 ).send( "Internal Server Error" )
				} catch ( any ignore ) {
				}
			}
		}
	}

}
