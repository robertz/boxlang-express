/**
 * Bridges an exchange adapter (see models/adapters/ — JdkExchangeAdapter,
 * UndertowExchangeAdapter) into the Request/Response/Router world. Fully
 * engine-neutral: unlike before Phase 2 step 2b, this class never
 * constructs an engine-specific adapter itself — each server adapter's own
 * small "handler glue" (JdkHandlerGlue, UndertowHandlerGlue) is responsible
 * for wrapping its engine's raw exchange type into the right adapter and
 * calling handle() with it. Never used directly by application code.
 */
class {

	function init( router, settings, appLocals = {} ) {
		variables.router = router
		variables.settings = settings
		variables.appLocals = appLocals
		variables.color = new AnsiColor()
		return this
	}

	function handle( exchangeAdapter ) {
		var req = ""
		var res = ""

		try {
			req = new Request( exchangeAdapter, variables.settings )
			res = new Response( exchangeAdapter, variables.settings, variables.appLocals )
			println( variables.color.gray( "[#dateTimeFormat( now(), 'yyyy-MM-dd HH:mm:ss' )#]" ) & " " & variables.color.method( req.method ) & " #req.path# " & variables.color.dim( req.ip ) )
		} catch ( any e ) {
			println( variables.color.gray( "[#dateTimeFormat( now(), 'yyyy-MM-dd HH:mm:ss' )#]" ) & " " & variables.color.red( "Failed to construct Request/Response: #e.message#" ) )
			// Safe to use the adapter here now (unlike before step 2b's
			// refactor) — by the time handle() runs, the adapter itself is
			// already constructed successfully by the caller's glue; only
			// Request/Response construction from it can fail here.
			try {
				var message = ( variables.settings[ "env" ] ?: "" ) == "development" ? e.message : "Internal Server Error"
				var bodyBytes = JSONSerialize( { error: true, message: message } ).getBytes( "UTF-8" )
				exchangeAdapter.setHeader( "Content-Type", "application/json" )
				exchangeAdapter.sendBody( 500, bodyBytes )
			} catch ( any ignore ) {
				try {
					exchangeAdapter.sendHeadersOnly( 500 )
				} catch ( any ignoreToo ) {
				}
			}
			return
		}

		try {
			variables.router.dispatch( req, res )
		} catch ( any e ) {
			println( variables.color.gray( "[#dateTimeFormat( now(), 'yyyy-MM-dd HH:mm:ss' )#]" ) & " " & variables.color.red( "Unhandled error dispatching #req.method# #req.path#: #e.message#" ) )
			if ( !res.isSent() ) {
				try {
					var message = ( variables.settings[ "env" ] ?: "" ) == "development" ? e.message : "Internal Server Error"
					res.status( 500 ).json( { error: true, message: message } )
				} catch ( any ignore ) {
				}
			}
		} finally {
			if ( !res.isSent() ) {
				try {
					res.status( 500 ).send( "Internal Server Error" )
				} catch ( any ignore ) {
				}
			}
		}
	}

}
