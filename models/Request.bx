/**
 * Express-style request object, backed by an exchange adapter (see
 * models/adapters/UndertowExchangeAdapter.bx) rather than a raw
 * io.undertow.server.HttpServerExchange directly — everything here reads
 * the adapter once at construction into plain BoxLang values, so the rest
 * of this class (query/cookie parsing, IP/hostname resolution) doesn't
 * touch Undertow's API at all. rawExchange() is the one deliberate
 * exception — see UndertowExchangeAdapter.bx's docblock.
 */
class {

	function init( exchangeAdapter, settings = {} ) {
		variables.exchangeAdapter = exchangeAdapter

		var queryString = exchangeAdapter.getQueryString()

		this.method = exchangeAdapter.getMethod()
		this.path = exchangeAdapter.getPath()
		this.originalUrl = this.path & ( len( queryString ) ? "?" & queryString : "" )
		this.query = _parseQueryString( queryString )
		this.params = {}
		this.body = {}
		this.files = {}
		this.headers = exchangeAdapter.getRequestHeaders()
		this.cookies = _parseCookies( this.headers[ "Cookie" ] ?: "" )
		this.signedCookies = _extractSignedCookies( settings )
		// Compiled once by app.set( "trust proxy", ... ); built here only for a
		// Request made with raw settings (a test, a bare Router).
		variables.proxyTrust = settings[ "trust proxy compiled" ] ?: new ProxyTrust( settings[ "trust proxy" ] ?: false )
		variables.peerAddress = exchangeAdapter.getRemoteAddress()
		this.ip = _resolveIp( exchangeAdapter, settings )
		this.protocol = _resolveProtocol( settings )
		this.secure = ( this.protocol == "https" )
		this.hostname = _resolveHostname( settings )
		this.subdomains = _resolveSubdomains( settings )
		this.xhr = compareNoCase( trim( this.headers[ "X-Requested-With" ] ?: "" ), "XMLHttpRequest" ) == 0
		// The mount path of the router or middleware currently handling the
		// request; Router.dispatch() maintains it.
		this.baseUrl = ""
		// Set by RequestWatchdog when this request ran past its timeout.
		this.timedOut = false
		variables.watchdog = ""
		variables.watchId = ""
		variables.bufferedBody = ""

		return this
	}

	/**
	 * Gives this request `timeoutMs` from now to start its response,
	 * replacing app.set( "requestTimeoutMs" ) for this one request; 0 turns
	 * the timeout off. Call it from the thread handling the request.
	 */
	function setTimeout( timeoutMs ) {
		if ( !isSimpleValue( timeoutMs ) || !isNumeric( timeoutMs ) || timeoutMs < 0 ) {
			throw( type = "BoxExpress.InvalidArgument", message = "req.setTimeout() takes a number of milliseconds, 0 or more" )
		}
		if ( isSimpleValue( variables.watchdog ) ) {
			return this
		}
		_clearTimeout()
		if ( timeoutMs > 0 ) {
			variables.watchId = variables.watchdog.watch( this, variables.response, timeoutMs )
		}
		return this
	}

	/**
	 * HttpBridge's hooks: which watchdog and response setTimeout() works
	 * with, and the end-of-request cleanup.
	 */
	function _bindTimeout( watchdog, res ) {
		variables.watchdog = watchdog
		variables.response = res
	}

	function _clearTimeout() {
		if ( len( variables.watchId ) ) {
			variables.watchdog.unwatch( variables.watchId )
			variables.watchId = ""
		}
	}

	/**
	 * A body HttpBridge already read to enforce app.set( "maxBodySize" ) on
	 * a request that didn't declare its length.
	 */
	function _setBufferedBody( bodyBytes ) {
		variables.bufferedBody = createObject( "java", "java.io.ByteArrayInputStream" ).init( bodyBytes )
	}

	function get( name ) {
		return this.headers[ name ] ?: javacast( "null", "" )
	}

	/**
	 * accepts( "html" ) / accepts( "html", "json" ) / accepts( [ "html", "json" ] )
	 *
	 * The offered type (an extension or a full MIME type, returned as given)
	 * the Accept header prefers, or false when none is acceptable. With no
	 * arguments, the types the client accepts, most preferred first.
	 */
	function accepts() {
		var offered = _offered( arguments )
		var negotiator = new Negotiator()
		var acceptHeader = this.headers[ "Accept" ] ?: ""
		if ( !offered.len() ) {
			return negotiator.mediaTypes( acceptHeader )
		}
		var chosen = negotiator.mediaType( acceptHeader, offered )
		return len( chosen ) ? chosen : false
	}

	/**
	 * Same shape as accepts(), against Accept-Language.
	 */
	function acceptsLanguages() {
		var offered = _offered( arguments )
		var negotiator = new Negotiator()
		var languageHeader = this.headers[ "Accept-Language" ] ?: ""
		if ( !offered.len() ) {
			return negotiator.languages( languageHeader )
		}
		var chosen = negotiator.language( languageHeader, offered )
		return len( chosen ) ? chosen : false
	}

	/**
	 * is( "json" ) / is( "html", "+json" ) / is( [ ... ] )
	 *
	 * The first given type the request's Content-Type matches, or false —
	 * also false when the request has no Content-Type at all.
	 */
	function is() {
		var contentTypeHeader = this.headers[ "Content-Type" ] ?: ""
		if ( !len( contentTypeHeader ) ) {
			return false
		}
		var negotiator = new Negotiator()
		for ( var pattern in _offered( arguments ) ) {
			var matched = negotiator.matchType( contentTypeHeader, pattern )
			if ( len( matched ) ) {
				return matched
			}
		}
		return false
	}

	private function _offered( args ) {
		var offered = []
		for ( var i = 1; i <= args.count(); i++ ) {
			if ( isArray( args[ i ] ) ) {
				offered.append( args[ i ], true )
			} else {
				offered.append( args[ i ] )
			}
		}
		return offered
	}

	function rawExchange() {
		return variables.exchangeAdapter.getRawExchange()
	}

	/**
	 * The raw request body as a java.io.InputStream, engine-neutral —
	 * what body-reading middleware (BodyParsers.bx, Multipart.bx) should
	 * use instead of rawExchange().getRequestBody()/getInputStream(),
	 * since that method exists under a different name (or not at all)
	 * per engine. rawExchange() itself is unchanged, for anyone who needs
	 * genuinely engine-specific access beyond just the body stream.
	 */
	function bodyStream() {
		if ( !isSimpleValue( variables.bufferedBody ) ) {
			return variables.bufferedBody
		}
		return variables.exchangeAdapter.getRequestBodyStream()
	}

	private function _parseQueryString( rawQuery ) {
		var result = {}
		if ( isNull( rawQuery ) || !len( rawQuery ) ) {
			return result
		}
		for ( var pair in rawQuery.listToArray( "&" ) ) {
			var eqPos = pair.find( "=" )
			if ( eqPos ) {
				// eqPos - 1 or pair.len() - eqPos can be zero (an empty key or an
				// empty value, e.g. "key=") — BoxLang's left()/right() throw "Count
				// cannot be zero" for a zero count. Same class of bug BodyParsers.bx
				// already guards against.
				var rawKey = eqPos == 1 ? "" : pair.left( eqPos - 1 )
				var rawValue = eqPos == pair.len() ? "" : pair.right( pair.len() - eqPos )
				result[ _decode( rawKey ) ] = _decode( rawValue )
			} else {
				result[ _decode( pair ) ] = ""
			}
		}
		return result
	}

	private function _parseCookies( cookieHeader ) {
		var result = {}
		if ( !len( cookieHeader ) ) {
			return result
		}
		for ( var pair in cookieHeader.listToArray( ";" ) ) {
			var trimmedPair = pair.trim()
			var eqPos = trimmedPair.find( "=" )
			if ( eqPos ) {
				// Same zero-count left()/right() guard as _parseQueryString() above.
				var cookieName = ( eqPos == 1 ? "" : trimmedPair.left( eqPos - 1 ) ).trim()
				var cookieValue = ( eqPos == trimmedPair.len() ? "" : trimmedPair.right( trimmedPair.len() - eqPos ) ).trim()
				result[ cookieName ] = _decode( cookieValue )
			}
		}
		return result
	}

	/**
	 * With app.set( "cookie secret" ), moves every cookie in the signed
	 * format out of this.cookies: into the returned struct as its original
	 * value when the signature checks out, as false when it doesn't. A
	 * tampered cookie is never left where it could be read as a plain one.
	 */
	private function _extractSignedCookies( settings ) {
		var verified = {}
		var signer = settings[ "cookie signer" ] ?: ""
		if ( isSimpleValue( signer ) ) {
			return verified
		}
		for ( var cookieName in this.cookies.keyArray() ) {
			var cookieValue = this.cookies[ cookieName ]
			if ( !signer.isSigned( cookieValue ) ) {
				continue
			}
			var result = signer.unsign( cookieValue )
			verified[ cookieName ] = result.valid ? result.value : false
			this.cookies.delete( cookieName )
		}
		return verified
	}

	/**
	 * urlDecode() throws on a malformed escape ("50%", "%zz"). A cookie can be
	 * set by any script or sibling subdomain, so one bad value must not fail
	 * every request that carries it — the raw text is used instead.
	 */
	private function _decode( value ) {
		try {
			return urlDecode( value )
		} catch ( any e ) {
			return value
		}
	}

	/**
	 * By default this is always the direct TCP peer (safe, can't be spoofed by a client).
	 * Behind a reverse proxy, the direct peer is the proxy itself — app.set("trust
	 * proxy", ...) says which hops to believe; see ProxyTrust.bx. Prefer a hop count
	 * or a list of proxy addresses over `true`, which takes the left-most
	 * X-Forwarded-For entry — the one a client can write.
	 *
	 * X-Forwarded-For is the wrong choice behind some platforms, though: verified
	 * directly against DigitalOcean App Platform (with Cloudflare in front of that)
	 * that both hops APPEND to X-Forwarded-For rather than replacing it, so a client
	 * can still prepend a forged entry and have it survive to the app — trust proxy
	 * would make req.ip attacker-controlled there, not just wrong. Platforms that do
	 * this typically also inject their own edge-set header carrying the real client IP
	 * (DigitalOcean's DO-Connecting-IP, Cloudflare's CF-Connecting-IP, Fastly's
	 * Fastly-Client-IP, etc.) — set from the connection the edge itself observed, not
	 * from anything the client sent, so trustworthy where X-Forwarded-For's leftmost
	 * entry is not. app.set("trust proxy header", "DO-Connecting-IP") (or an array,
	 * checked in order, first present wins) reads one of those instead. Checked before
	 * the X-Forwarded-For path, and independent of the "trust proxy" boolean — a named
	 * single-value edge header is a different, safer trust model than a client-writable
	 * multi-value one.
	 */
	private function _resolveIp( exchangeAdapter, settings ) {
		var trustedHeaders = settings[ "trust proxy header" ] ?: []
		if ( !isArray( trustedHeaders ) ) {
			trustedHeaders = [ trustedHeaders ]
		}
		for ( var headerName in trustedHeaders ) {
			var headerValue = this.headers[ headerName ] ?: ""
			if ( len( headerValue ) ) {
				return headerValue.listFirst( "," ).trim()
			}
		}

		return variables.proxyTrust.clientIp( variables.peerAddress, this.headers[ "X-Forwarded-For" ] ?: "" )
	}

	/**
	 * BoxExpress's own HttpServer never terminates TLS itself, so this is always
	 * "http" unless a reverse proxy in front of it is trusted (app.set("trust
	 * proxy", true)) to report the original scheme via X-Forwarded-Proto — the
	 * same trust model as req.ip, and off by default for the same reason: an
	 * untrusted client could otherwise forge that header to spoof HTTPS.
	 */
	private function _resolveProtocol( settings ) {
		if ( variables.proxyTrust.trustsPeer( variables.peerAddress ) ) {
			var forwardedProto = this.headers[ "X-Forwarded-Proto" ] ?: ""
			if ( len( forwardedProto ) && forwardedProto.listFirst( "," ).trim().lcase() == "https" ) {
				return "https"
			}
		}
		return "http"
	}

	/**
	 * The Host header with any ":port" suffix stripped, same as Express's
	 * req.hostname. With app.set("trust proxy", true), X-Forwarded-Host (if
	 * present) is preferred over the direct Host header, same trust model as
	 * req.ip/req.protocol.
	 */
	private function _resolveHostname( settings ) {
		var hostHeader = this.headers[ "Host" ] ?: ""
		if ( variables.proxyTrust.trustsPeer( variables.peerAddress ) ) {
			hostHeader = this.headers[ "X-Forwarded-Host" ] ?: hostHeader
		}
		if ( !len( hostHeader ) ) {
			return ""
		}
		// An IPv6 host is bracketed ("[::1]:3000") — its own colons aren't the
		// port separator, so strip the port only for anything after the "]".
		if ( hostHeader.left( 1 ) == "[" ) {
			var closeBracket = hostHeader.find( "]" )
			return closeBracket ? hostHeader.mid( 1, closeBracket ) : hostHeader
		}
		var colonPos = hostHeader.find( ":" )
		return colonPos ? hostHeader.mid( 1, colonPos - 1 ) : hostHeader
	}

	/**
	 * The hostname's labels left of the registrable domain, nearest the
	 * domain first: "tobi.ferrets.example.com" -> [ "ferrets", "tobi" ].
	 * app.set( "subdomain offset", n ) says how many trailing labels make up
	 * the domain (default 2; use 3 for "example.co.uk"). An IP address has
	 * none.
	 */
	private function _resolveSubdomains( settings ) {
		var host = this.hostname
		if ( !len( host ) || host.find( ":" ) || reFind( "^[0-9.]+$", host ) ) {
			return []
		}
		var labels = host.listToArray( "." ).reverse()
		var offset = settings[ "subdomain offset" ] ?: 2
		if ( offset >= labels.len() ) {
			return []
		}
		return offset <= 0 ? labels : labels.slice( offset + 1 )
	}

}
