/**
 * Express-style request object, backed by an exchange adapter (see
 * models/adapters/UndertowExchangeAdapter.bx) rather than a raw
 * io.undertow.server.HttpServerExchange directly — everything here reads
 * the adapter once at construction into plain BoxLang values, so the rest
 * of this class (query/cookie parsing, IP/hostname resolution) doesn't
 * touch Undertow's API at all. rawExchange() is the one deliberate
 * exception — see UndertowExchangeAdapter.bx's docblock.
 */
class {

	function init( exchangeAdapter, settings = {} ) {
		variables.exchangeAdapter = exchangeAdapter

		var queryString = exchangeAdapter.getQueryString()

		this.method = exchangeAdapter.getMethod()
		this.path = exchangeAdapter.getPath()
		this.originalUrl = this.path & ( len( queryString ) ? "?" & queryString : "" )
		this.query = _parseQueryString( queryString )
		this.params = {}
		this.body = {}
		this.files = {}
		this.headers = exchangeAdapter.getRequestHeaders()
		this.cookies = _parseCookies( this.headers[ "Cookie" ] ?: "" )
		this.ip = _resolveIp( exchangeAdapter, settings )
		this.protocol = _resolveProtocol( settings )
		this.secure = ( this.protocol == "https" )
		this.hostname = _resolveHostname( settings )

		return this
	}

	function get( name ) {
		return this.headers[ name ] ?: javacast( "null", "" )
	}

	function rawExchange() {
		return variables.exchangeAdapter.getRawExchange()
	}

	/**
	 * The raw request body as a java.io.InputStream, engine-neutral —
	 * what body-reading middleware (BodyParsers.bx, Multipart.bx) should
	 * use instead of rawExchange().getRequestBody()/getInputStream(),
	 * since that method exists under a different name (or not at all)
	 * per engine. rawExchange() itself is unchanged, for anyone who needs
	 * genuinely engine-specific access beyond just the body stream.
	 */
	function bodyStream() {
		return variables.exchangeAdapter.getRequestBodyStream()
	}

	private function _parseQueryString( rawQuery ) {
		var result = {}
		if ( isNull( rawQuery ) || !len( rawQuery ) ) {
			return result
		}
		for ( var pair in rawQuery.listToArray( "&" ) ) {
			var eqPos = pair.find( "=" )
			if ( eqPos ) {
				// eqPos - 1 or pair.len() - eqPos can be zero (an empty key or an
				// empty value, e.g. "key=") — BoxLang's left()/right() throw "Count
				// cannot be zero" for a zero count. Same class of bug BodyParsers.bx
				// already guards against.
				var rawKey = eqPos == 1 ? "" : pair.left( eqPos - 1 )
				var rawValue = eqPos == pair.len() ? "" : pair.right( pair.len() - eqPos )
				result[ urlDecode( rawKey ) ] = urlDecode( rawValue )
			} else {
				result[ urlDecode( pair ) ] = ""
			}
		}
		return result
	}

	private function _parseCookies( cookieHeader ) {
		var result = {}
		if ( !len( cookieHeader ) ) {
			return result
		}
		for ( var pair in cookieHeader.listToArray( ";" ) ) {
			var trimmedPair = pair.trim()
			var eqPos = trimmedPair.find( "=" )
			if ( eqPos ) {
				// Same zero-count left()/right() guard as _parseQueryString() above.
				var cookieName = ( eqPos == 1 ? "" : trimmedPair.left( eqPos - 1 ) ).trim()
				var cookieValue = ( eqPos == trimmedPair.len() ? "" : trimmedPair.right( trimmedPair.len() - eqPos ) ).trim()
				result[ cookieName ] = urlDecode( cookieValue )
			}
		}
		return result
	}

	/**
	 * By default this is always the direct TCP peer (safe, can't be spoofed by a client).
	 * Behind a reverse proxy, the direct peer is the proxy itself — opt in with
	 * app.set("trust proxy", true) to prefer X-Forwarded-For instead, same as Express's
	 * trust-proxy setting (off by default for the same reason: an untrusted client could
	 * otherwise forge that header to spoof its IP).
	 *
	 * X-Forwarded-For is the wrong choice behind some platforms, though: verified
	 * directly against DigitalOcean App Platform (with Cloudflare in front of that)
	 * that both hops APPEND to X-Forwarded-For rather than replacing it, so a client
	 * can still prepend a forged entry and have it survive to the app — trust proxy
	 * would make req.ip attacker-controlled there, not just wrong. Platforms that do
	 * this typically also inject their own edge-set header carrying the real client IP
	 * (DigitalOcean's DO-Connecting-IP, Cloudflare's CF-Connecting-IP, Fastly's
	 * Fastly-Client-IP, etc.) — set from the connection the edge itself observed, not
	 * from anything the client sent, so trustworthy where X-Forwarded-For's leftmost
	 * entry is not. app.set("trust proxy header", "DO-Connecting-IP") (or an array,
	 * checked in order, first present wins) reads one of those instead. Checked before
	 * the X-Forwarded-For path, and independent of the "trust proxy" boolean — a named
	 * single-value edge header is a different, safer trust model than a client-writable
	 * multi-value one.
	 */
	private function _resolveIp( exchangeAdapter, settings ) {
		var trustedHeaders = settings[ "trust proxy header" ] ?: []
		if ( !isArray( trustedHeaders ) ) {
			trustedHeaders = [ trustedHeaders ]
		}
		for ( var headerName in trustedHeaders ) {
			var headerValue = this.headers[ headerName ] ?: ""
			if ( len( headerValue ) ) {
				return headerValue.listFirst( "," ).trim()
			}
		}

		if ( settings[ "trust proxy" ] ?: false ) {
			var forwardedFor = this.headers[ "X-Forwarded-For" ] ?: ""
			if ( len( forwardedFor ) ) {
				return forwardedFor.listFirst( "," ).trim()
			}
		}
		return exchangeAdapter.getRemoteAddress()
	}

	/**
	 * BoxExpress's own HttpServer never terminates TLS itself, so this is always
	 * "http" unless a reverse proxy in front of it is trusted (app.set("trust
	 * proxy", true)) to report the original scheme via X-Forwarded-Proto — the
	 * same trust model as req.ip, and off by default for the same reason: an
	 * untrusted client could otherwise forge that header to spoof HTTPS.
	 */
	private function _resolveProtocol( settings ) {
		if ( settings[ "trust proxy" ] ?: false ) {
			var forwardedProto = this.headers[ "X-Forwarded-Proto" ] ?: ""
			if ( len( forwardedProto ) && forwardedProto.listFirst( "," ).trim().lcase() == "https" ) {
				return "https"
			}
		}
		return "http"
	}

	/**
	 * The Host header with any ":port" suffix stripped, same as Express's
	 * req.hostname. With app.set("trust proxy", true), X-Forwarded-Host (if
	 * present) is preferred over the direct Host header, same trust model as
	 * req.ip/req.protocol.
	 */
	private function _resolveHostname( settings ) {
		var hostHeader = this.headers[ "Host" ] ?: ""
		if ( settings[ "trust proxy" ] ?: false ) {
			hostHeader = this.headers[ "X-Forwarded-Host" ] ?: hostHeader
		}
		if ( !len( hostHeader ) ) {
			return ""
		}
		// An IPv6 host is bracketed ("[::1]:3000") — its own colons aren't the
		// port separator, so strip the port only for anything after the "]".
		if ( hostHeader.left( 1 ) == "[" ) {
			var closeBracket = hostHeader.find( "]" )
			return closeBracket ? hostHeader.mid( 1, closeBracket ) : hostHeader
		}
		var colonPos = hostHeader.find( ":" )
		return colonPos ? hostHeader.mid( 1, colonPos - 1 ) : hostHeader
	}

}
