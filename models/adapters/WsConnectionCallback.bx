/**
 * Implements io.undertow.websockets.WebSocketConnectionCallback (via
 * createDynamicProxy) — the single callback wired to Undertow's
 * WebSocketProtocolHandshakeHandler for every app.ws() route this app
 * registered. Looks up which registered handler owns this connection's
 * path, builds the WebSocketConnection + shim wiring, and hands the
 * connection to that handler before resuming receives — registering the
 * app's own onMessage()/onClose() has to happen before that, or a fast
 * client's first message could arrive with nothing listening for it yet.
 */
class {

	/**
	 * Eagerly resolves both java-src/-compiled classes this adapter needs —
	 * boxexpress.ws.BoxWebSocketListener (below) and boxexpress.ws.
	 * WebSocketMessageHandler (the _warmMessageHandlerInterface() call) —
	 * synchronously, here, rather than lazily on the first real connection.
	 *
	 * Found the hard way: neither class ships as a prebuilt .class; BoxLang's
	 * module class loader compiles each on demand the first time it's
	 * resolved by name (createObject() for the former, the interface name
	 * passed to createDynamicProxy() for the latter — see
	 * BoxWebSocketListener.java's own docblock for why a real compiled Java
	 * class is needed here at all). Resolving either one fresh on every
	 * onConnect() (i.e. every handshake, including StompJs's own reconnect
	 * attempts) hit that on-demand compile-and-define path repeatedly
	 * instead of once, and two connections landing close enough together (a
	 * page's own connection racing an in-flight reconnect, two browser tabs
	 * opening within the same instant) could both miss whatever caching
	 * that path does internally and both try to define the class into the
	 * same per-module classloader — which throws LinkageError: attempted
	 * duplicate class definition, since a ClassLoader can only ever define
	 * one class under a given fully-qualified name. Reproduced directly:
	 * identical failure with this project's own unmodified released
	 * version, on the very first handshake against a freshly started
	 * server, so it's a real bug here, not a downstream consumer's
	 * environment.
	 *
	 * init() runs exactly once, synchronously, while app.ws() is still
	 * being set up — strictly before app.listen() ever accepts a
	 * connection (see BoxExpress.bx) — so resolving both classes here
	 * instead of lazily removes the race outright: by the time any real,
	 * possibly-concurrent connection reaches onConnect(), both classes are
	 * already defined and this single-threaded resolution is the only one
	 * that will ever happen.
	 */
	function init( wsRoutes ) {
		variables.wsRoutes = wsRoutes
		variables.listenerClass = createObject( "java", "boxexpress.ws.BoxWebSocketListener" )
		_warmMessageHandlerInterface()
		return this
	}

	function onConnect( exchange, channel ) {
		// getRequestURI() includes the query string (confirmed directly —
		// unlike HttpServerExchange.getRequestPath() used for the plain
		// HTTP path, which doesn't), so it has to be stripped here to match
		// how app.ws(path, ...) paths are registered.
		var uri = exchange.getRequestURI()
		var path = uri.find( "?" ) ? uri.left( uri.find( "?" ) - 1 ) : uri

		var handlerFn = variables.wsRoutes[ path ] ?: javacast( "null", "" )
		if ( isNull( handlerFn ) ) {
			channel.sendClose()
			return
		}

		var connection = new "../WebSocketConnection"( channel, _extractHeaders( exchange ) )
		var handlerAdapter = new "WsMessageHandlerAdapter"( connection )
		var handlerProxy = createDynamicProxy( handlerAdapter, [ "boxexpress.ws.WebSocketMessageHandler" ] )
		var listener = variables.listenerClass.init( handlerProxy )
		channel.getReceiveSetter().set( listener )

		handlerFn( connection )

		channel.resumeReceives()
	}

	/**
	 * Forces boxexpress.ws.WebSocketMessageHandler's class definition to
	 * happen once, here, instead of on the first real (and possibly
	 * concurrent) connection's createDynamicProxy() call in onConnect().
	 * The proxy itself is throwaway — createDynamicProxy() necessarily
	 * builds a fresh proxy instance per call (each connection needs its
	 * own, wrapping its own WsMessageHandlerAdapter), so unlike
	 * BoxWebSocketListener there's nothing reusable to cache — only the
	 * underlying interface class resolution this warms up front.
	 * WsMessageHandlerAdapter.init() only stores whatever it's given
	 * without dereferencing it, so "" (not a real null — see
	 * StompMessage.bx's own init() docblock for why: a BoxLang function
	 * parameter holding an actual null can't be referenced by name inside
	 * that function at all, and init() does exactly that with a bare
	 * `connection = connection` assignment) is a safe throwaway value
	 * here; none of this adapter's methods are ever invoked on this
	 * warm-up instance in the first place.
	 */
	private function _warmMessageHandlerInterface() {
		var throwawayAdapter = new "WsMessageHandlerAdapter"( "" )
		createDynamicProxy( throwawayAdapter, [ "boxexpress.ws.WebSocketMessageHandler" ] )
	}

	/**
	 * WebSocketHttpExchange.getRequestHeaders() returns
	 * Map<String, List<String>> — different shape than
	 * HttpServerExchange's HeaderMap used on the plain HTTP side
	 * (UndertowExchangeAdapter.getRequestHeaders()) — so this reads
	 * getRequestHeader(name) per name instead, taking the first value
	 * per header the same way the HTTP side does.
	 */
	private function _extractHeaders( exchange ) {
		var headerStruct = {}
		for ( var headerName in exchange.getRequestHeaders().keySet() ) {
			headerStruct[ headerName ] = exchange.getRequestHeader( headerName )
		}
		return headerStruct
	}

}
