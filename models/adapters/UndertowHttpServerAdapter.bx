/**
 * HttpServerAdapter backed by io.undertow.Undertow — BoxExpress's server
 * transport. Contract: start(port, backlog, bridge) / stop().
 */
class {

	function start( port, backlog, bridge ) {
		var glue = new UndertowHandlerGlue( bridge )
		var innerProxy = createDynamicProxy( glue, [ "io.undertow.server.HttpHandler" ] )

		// Undertow dispatches handlers on its own I/O thread by default,
		// where blocking I/O throws IllegalStateException — confirmed
		// directly, reading the request body via getInputStream() (needed
		// for BodyParsers.bx/Multipart.bx) failed exactly this way without
		// dispatching off of it first. UndertowVirtualThreadHandler moves
		// each request onto its own virtual thread before this handler
		// ever runs, matching the virtual-thread-per-request model this
		// project uses everywhere else (this project's whole handler model
		// is blocking by design, not async, so every request needs a
		// thread it's safe to block on).
		var dispatchHandler = new UndertowVirtualThreadHandler( innerProxy )
		var proxy = createDynamicProxy( dispatchHandler, [ "io.undertow.server.HttpHandler" ] )

		var builder = createObject( "java", "io.undertow.Undertow" ).builder()
		builder.addHttpListener( port, "0.0.0.0" )
		builder.setHandler( proxy )
		builder.setSocketOption( createObject( "java", "org.xnio.Options" ).BACKLOG, javacast( "int", backlog ) )

		try {
			variables.undertowServer = builder.build()
			variables.undertowServer.start()
		} catch ( any e ) {
			var cause = e.getCause()
			if ( !isNull( cause ) && cause.getClass().getName() == "java.net.BindException" ) {
				throw( message = "Port #port# is already in use", type = "BoxExpress.PortInUse" )
			}
			rethrow;
		}

		return this
	}

	function stop() {
		if ( !isNull( variables.undertowServer ) ) {
			variables.undertowServer.stop()
			variables.undertowServer = javacast( "null", "" )
		}
		return this
	}

}
