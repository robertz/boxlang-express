/**
 * BoxExpress: an Express.js-style API for building lightweight HTTP servers in BoxLang.
 *
 *   app = new BoxExpress()
 *   app.get( "/", ( req, res ) => res.send( "Hello World" ) )
 *   app.listen( 3000, () => println( "listening on 3000" ) )
 */
class {

	function init() {
		this.settings = {}
		variables.router = new Router( this.settings )
		variables.httpServer = javacast( "null", "" )
		variables.running = false
		return this
	}

	function get( path ) {
		variables.router.get( argumentCollection = arguments )
		return this
	}

	function post( path ) {
		variables.router.post( argumentCollection = arguments )
		return this
	}

	function put( path ) {
		variables.router.put( argumentCollection = arguments )
		return this
	}

	function patch( path ) {
		variables.router.patch( argumentCollection = arguments )
		return this
	}

	function delete( path ) {
		variables.router.delete( argumentCollection = arguments )
		return this
	}

	function all( path ) {
		variables.router.all( argumentCollection = arguments )
		return this
	}

	function use( pathOrHandler, handlerOrRouter ) {
		variables.router.use( argumentCollection = arguments )
		return this
	}

	function param( name, callback ) {
		variables.router.param( argumentCollection = arguments )
		return this
	}

	function route( path ) {
		return variables.router.route( argumentCollection = arguments )
	}

	function set( name, value ) {
		this.settings[ name ] = value
		// Response.render() does a plain `include` on an absolute path it has already
		// canonicalized and verified is inside this directory (its own path-traversal
		// check). BoxLang core no longer resolves an absolute include path unless it's
		// backed by a registered mapping — that check is intentional (BoxLang won't
		// implicitly trust a bare absolute path), so this registers one instead of
		// asking BoxLang to bypass it. Registered once here at app-configuration time
		// (not per-request from render()) since Configuration.mappings is a sorted,
		// non-concurrent structure — safe for the single-threaded startup sequence,
		// not for concurrent virtual-thread request handlers.
		if ( lCase( name ) == "views" ) {
			getBoxRuntime().getConfiguration().registerMapping( value, value )
		}
		return this
	}

	function getSetting( name ) {
		return this.settings[ name ] ?: javacast( "null", "" )
	}

	/**
	 * Starts the server. Blocks the calling thread by default (options.block = true) —
	 * Node keeps a CLI process alive via its event loop, BoxLang's CLI runtime has no
	 * equivalent, so listen() blocks itself rather than requiring every caller to
	 * remember a keep-alive loop. Pass { block: false } for the old non-blocking
	 * behavior (used by this project's own test suite, or anyone embedding BoxExpress
	 * inside a larger app that manages its own lifecycle) — close() still works to stop
	 * the server either way, and also breaks the blocking loop if something else (e.g.
	 * a route handler, on its own virtual thread) calls it while listen() is blocked.
	 */
	function listen( port, callback, options = {} ) {
		var addr = createObject( "java", "java.net.InetSocketAddress" ).init( port )
		variables.httpServer = createObject( "java", "com.sun.net.httpserver.HttpServer" ).create( addr, 0 )

		var bridge = new HttpBridge( variables.router, this.settings )
		var proxy = createDynamicProxy( bridge, [ "com.sun.net.httpserver.HttpHandler" ] )

		variables.httpServer.createContext( "/", proxy )
		variables.httpServer.setExecutor( createObject( "java", "java.util.concurrent.Executors" ).newVirtualThreadPerTaskExecutor() )
		variables.httpServer.start()
		variables.running = true

		if ( !isNull( callback ) ) {
			callback( port )
		}

		if ( options.block ?: true ) {
			while ( variables.running ) {
				sleep( 1000 )
			}
		}

		return this
	}

	function close() {
		variables.running = false
		if ( isNull( variables.httpServer ) ) {
			return this
		}
		variables.httpServer.stop( 0 )
		return this
	}

}
