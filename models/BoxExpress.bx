/**
 * BoxExpress: an Express.js-style API for building lightweight HTTP servers in BoxLang.
 *
 *   app = new BoxExpress()
 *   app.get( "/", ( req, res ) => res.send( "Hello World" ) )
 *   app.listen( 3000, () => println( "listening on 3000" ) )
 */
class {

	function init() {
		this.settings = {}
		this.locals = {}
		variables.router = new Router( this.settings )
		variables.undertowServer = javacast( "null", "" )
		variables.running = false
		variables.reloadWatcher = javacast( "null", "" )
		variables.shutdownHook = javacast( "null", "" )
		variables.closed = false
		variables.color = new AnsiColor()
		return this
	}

	function get( path ) {
		variables.router.get( argumentCollection = arguments )
		return this
	}

	function post( path ) {
		variables.router.post( argumentCollection = arguments )
		return this
	}

	function put( path ) {
		variables.router.put( argumentCollection = arguments )
		return this
	}

	function patch( path ) {
		variables.router.patch( argumentCollection = arguments )
		return this
	}

	function delete( path ) {
		variables.router.delete( argumentCollection = arguments )
		return this
	}

	/**
	 * Explicit HEAD handler — usually unnecessary, since any app.get() route
	 * already answers HEAD automatically (same handler, body suppressed).
	 * Register one only when HEAD should behave differently than just running
	 * the GET handler with the body thrown away (e.g. skipping an expensive
	 * computation the response body needed but the headers alone don't).
	 */
	function head( path ) {
		variables.router.head( argumentCollection = arguments )
		return this
	}

	function all( path ) {
		variables.router.all( argumentCollection = arguments )
		return this
	}

	/**
	 * use( handler ) / use( handler1, handler2, ... )
	 * use( mountPath, handler ) / use( mountPath, handler1, handler2, ..., router )
	 * See Router.use() for the full signature — this just forwards every
	 * argument through, variadic middleware chains included.
	 */
	function use( pathOrHandler = "" ) {
		variables.router.use( argumentCollection = arguments )
		return this
	}

	function param( name, callback ) {
		variables.router.param( argumentCollection = arguments )
		return this
	}

	function route( path ) {
		return variables.router.route( argumentCollection = arguments )
	}

	function set( name, value ) {
		this.settings[ name ] = value
		return this
	}

	function getSetting( name ) {
		return this.settings[ name ] ?: javacast( "null", "" )
	}

	/**
	 * Starts the server. Blocks the calling thread by default (options.block = true) —
	 * Node keeps a CLI process alive via its event loop, BoxLang's CLI runtime has no
	 * equivalent, so listen() blocks itself rather than requiring every caller to
	 * remember a keep-alive loop. Pass { block: false } for the old non-blocking
	 * behavior (used by this project's own test suite, or anyone embedding BoxExpress
	 * inside a larger app that manages its own lifecycle) — close() still works to stop
	 * the server either way, and also breaks the blocking loop if something else (e.g.
	 * a route handler, on its own virtual thread) calls it while listen() is blocked.
	 *
	 * options.backlog sets the TCP accept queue depth (default 1024), passed through to
	 * Undertow's org.xnio.Options.BACKLOG. A small backlog is enough that a burst of
	 * concurrent connections — well within what the virtual-thread executor itself can
	 * handle — can get refused with a connection reset instead of queued, which is why
	 * this defaults higher than Undertow's own default rather than being left unset.
	 * Exposed here instead of hardcoded higher still, since a reverse proxy in front
	 * (already required — see req.secure) may queue connections itself and make a large
	 * backlog here redundant.
	 *
	 * UndertowOptions.ENABLE_STATISTICS is turned on unconditionally — off by
	 * default in Undertow itself since tracking adds a small amount of overhead
	 * per request, but that cost is negligible next to everything else already
	 * happening per request here (virtual thread dispatch, routing, BoxLang
	 * closure invocation), and having it always on is what makes
	 * getConnectorStatistics() below actually return something instead of null.
	 */
	function listen( port, callback, options = {} ) {
		var backlog = options.backlog ?: 1024
		var bridge = new HttpBridge( variables.router, this.settings, this.locals )

		var glue = new adapters.UndertowHandlerGlue( bridge )
		var innerProxy = createDynamicProxy( glue, [ "io.undertow.server.HttpHandler" ] )

		// Undertow dispatches handlers on its own I/O thread by default,
		// where blocking I/O throws IllegalStateException — confirmed
		// directly, reading the request body via getInputStream() (needed
		// for BodyParsers.bx/Multipart.bx) failed exactly this way without
		// dispatching off of it first. UndertowVirtualThreadHandler moves
		// each request onto its own virtual thread before the handler ever
		// runs, matching the virtual-thread-per-request model this project
		// uses everywhere else (this project's whole handler model is
		// blocking by design, not async, so every request needs a thread
		// it's safe to block on).
		var dispatchHandler = new adapters.UndertowVirtualThreadHandler( innerProxy )
		var proxy = createDynamicProxy( dispatchHandler, [ "io.undertow.server.HttpHandler" ] )

		var builder = createObject( "java", "io.undertow.Undertow" ).builder()
		builder.addHttpListener( port, "0.0.0.0" )
		builder.setHandler( proxy )
		builder.setSocketOption( createObject( "java", "org.xnio.Options" ).BACKLOG, javacast( "int", backlog ) )
		builder.setServerOption( createObject( "java", "io.undertow.UndertowOptions" ).ENABLE_STATISTICS, javacast( "boolean", true ) )

		try {
			variables.undertowServer = builder.build()
			variables.undertowServer.start()
		} catch ( any e ) {
			var cause = e.getCause()
			if ( !isNull( cause ) && cause.getClass().getName() == "java.net.BindException" ) {
				println( variables.color.red( "[BoxExpress] Port #port# is already in use — exiting." ) )
				createObject( "java", "java.lang.System" ).exit( 1 )
				return this
			}
			rethrow;
		}

		variables.running = true
		_registerShutdownHook()

		if ( this.settings[ "reloadOnChange" ] ?: false ) {
			_startReloadWatcher()
		}

		if ( !isNull( callback ) ) {
			callback( port )
		}

		if ( options.block ?: true ) {
			while ( variables.running ) {
				sleep( 1000 )
			}
		}

		return this
	}

	function close() {
		if ( variables.closed ) {
			return this
		}
		variables.closed = true
		variables.running = false

		if ( !isNull( variables.reloadWatcher ) ) {
			variables.reloadWatcher.stop()
			variables.reloadWatcher = javacast( "null", "" )
		}

		if ( !isNull( variables.shutdownHook ) ) {
			try {
				createObject( "java", "java.lang.Runtime" ).getRuntime().removeShutdownHook( variables.shutdownHook )
			} catch ( any e ) {
				// already in the middle of JVM shutdown — the hook is running (or has run) anyway
			}
			variables.shutdownHook = javacast( "null", "" )
		}

		if ( !isNull( variables.undertowServer ) ) {
			variables.undertowServer.stop()
			variables.undertowServer = javacast( "null", "" )
		}

		return this
	}

	/**
	 * Live request-level metrics straight from Undertow's own listener — active
	 * connections/requests, total request count, bytes sent/received, error
	 * count, and processing time. Complements JVM/OS-level monitoring (memory,
	 * CPU, GC via java.lang.management) with the HTTP-layer numbers those
	 * MXBeans can't see. Returns null before listen() has run, after close(),
	 * or on the rare build where Undertow has no listener registered — always
	 * non-null otherwise, since listen() unconditionally turns statistics
	 * tracking on (see its docblock).
	 *
	 * @return {io.undertow.server.ConnectorStatistics} or null.
	 */
	function getConnectorStatistics() {
		if ( isNull( variables.undertowServer ) ) {
			return javacast( "null", "" )
		}

		var listeners = variables.undertowServer.getListenerInfo()
		if ( listeners.isEmpty() ) {
			return javacast( "null", "" )
		}

		return listeners.get( javacast( "int", 0 ) ).getConnectorStatistics()
	}

	/**
	 * Ensures close() runs on Ctrl-C / SIGTERM / normal JVM exit, not just on
	 * an explicit app.close() call. Without this, listen()'s blocking loop
	 * and the reload watcher's daemon thread just get torn down by the JVM
	 * without ever calling undertowServer.stop() or reloadWatcher.stop() — the
	 * process dies, but nothing runs the cleanup path, which is what let the
	 * dev-mode watcher outlive a Ctrl-C'd server.
	 */
	private function _registerShutdownHook() {
		var runnable = createDynamicProxy(
			new ThreadRunnable( function() {
				close()
			} ),
			[ "java.lang.Runnable" ]
		)
		variables.shutdownHook = createObject( "java", "java.lang.Thread" ).init( runnable )
		createObject( "java", "java.lang.Runtime" ).getRuntime().addShutdownHook( variables.shutdownHook )
	}

	/**
	 * Dev-mode convenience: app.set("reloadOnChange", true) watches the
	 * current working directory for .bx/.bxs changes (via FileWatcher) and
	 * restarts the process on save — .bxm views aren't watched, since
	 * render()'s bx:include re-reads the template from disk on every
	 * request, so a view edit already takes effect on the next request
	 * with no restart needed. Deliberately separate from
	 * app.set("env", "development") — the two are orthogonal settings, so
	 * either can be used without the other.
	 */
	private function _startReloadWatcher() {
		variables.reloadWatcher = new FileWatcher( expandPath( "." ) )

		var runnable = createDynamicProxy(
			new ThreadRunnable( function() {
				variables.reloadWatcher.watch( function( changedPath ) {
					println( variables.color.cyan( "[reloadOnChange] #changedPath# changed — restarting..." ) )
					_restartProcess()
				} )
			} ),
			[ "java.lang.Runnable" ]
		)

		var thread = createObject( "java", "java.lang.Thread" ).init( runnable )
		thread.setDaemon( true )
		thread.start()
	}

	/**
	 * Replays the exact original JVM invocation (ProcessHandle.current()) to
	 * relaunch the app, rather than assuming a fixed "boxlang <script>"
	 * shape — this way it works whatever the entry script is named and
	 * however it was launched (bvm-managed boxlang, a raw java -jar, custom
	 * JVM flags, etc).
	 *
	 * pb.start() only has to launch the new OS process — it doesn't wait for
	 * BoxLang to boot or the new process to bind the port, so it's safe to
	 * call before close() releases this server. That ordering matters: if
	 * launching the replacement fails (bad command, a transient OS resource
	 * limit, whatever), the current server is left running and a clear error
	 * is logged, rather than close() + exit() already having torn it down
	 * with nothing left to replace it — previously an uncaught exception
	 * here (on this daemon thread) silently killed the server with no
	 * replacement and no visible explanation tying the two together.
	 */
	private function _restartProcess() {
		var info = createObject( "java", "java.lang.ProcessHandle" ).current().info()

		var command = []
		command.append( info.command().isPresent() ? info.command().get() : "boxlang" )
		if ( info.arguments().isPresent() ) {
			command.append( info.arguments().get(), true )
		} else {
			command.append( getBaseTemplatePath() )
		}

		try {
			var pb = createObject( "java", "java.lang.ProcessBuilder" ).init( command )
			pb.inheritIO()
			pb.start()
		} catch ( any e ) {
			println( variables.color.red( "[reloadOnChange] Failed to restart: #e.message# — keeping the current server running." ) )
			return
		}

		close()
		createObject( "java", "java.lang.System" ).exit( 0 )
	}

}
