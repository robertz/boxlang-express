/**
 * BoxExpress: an Express.js-style API for building lightweight HTTP servers in BoxLang.
 *
 *   app = new BoxExpress()
 *   app.get( "/", ( req, res ) => res.send( "Hello World" ) )
 *   app.listen( 3000, () => println( "listening on 3000" ) )
 */
class {

	function init() {
		this.settings = {}
		this.locals = {}
		variables.router = new Router( this.settings )
		variables.wsRoutes = {}
		variables.undertowServer = javacast( "null", "" )
		variables.running = false
		variables.reloadWatcher = javacast( "null", "" )
		variables.shutdownHook = javacast( "null", "" )
		variables.scheduler = javacast( "null", "" )
		variables.clusterManager = javacast( "null", "" )
		variables.closed = false
		variables.draining = false
		variables.metricsRegistry = ""    // "" until app.metrics() is called — see HttpBridge.init()
		variables.metricsSources = []
		variables.gracefulHandler = javacast( "null", "" )
		variables.wsCallbackObject = javacast( "null", "" )
		variables.color = new AnsiColor()
		return this
	}

	function get( path ) {
		variables.router.get( argumentCollection = arguments )
		return this
	}

	function post( path ) {
		variables.router.post( argumentCollection = arguments )
		return this
	}

	function put( path ) {
		variables.router.put( argumentCollection = arguments )
		return this
	}

	function patch( path ) {
		variables.router.patch( argumentCollection = arguments )
		return this
	}

	function delete( path ) {
		variables.router.delete( argumentCollection = arguments )
		return this
	}

	/**
	 * Explicit HEAD handler — usually unnecessary, since any app.get() route
	 * already answers HEAD automatically (same handler, body suppressed).
	 * Register one only when HEAD should behave differently than just running
	 * the GET handler with the body thrown away (e.g. skipping an expensive
	 * computation the response body needed but the headers alone don't).
	 */
	function head( path ) {
		variables.router.head( argumentCollection = arguments )
		return this
	}

	function all( path ) {
		variables.router.all( argumentCollection = arguments )
		return this
	}

	/**
	 * Registers a WebSocket route — a separate table from the HTTP route
	 * table above, not another verb on Router, since a WebSocket connection
	 * has no req/res/next() chain to run through. Exact-path matching only
	 * for now (no :params, no mount paths) — the simplest version that
	 * covers a real route table, extended later if a real need for
	 * pattern-matched WebSocket paths shows up.
	 *
	 * handler receives a WebSocketConnection when a client connects —
	 * register onMessage()/onClose() on it synchronously, before returning,
	 * since messages can start arriving as soon as the handshake completes:
	 *
	 *   app.ws( "/chat", ( connection ) => {
	 *       connection.onMessage( ( text ) => connection.send( "echo:" & text ) )
	 *   } )
	 */
	function ws( path, handler ) {
		variables.wsRoutes[ path ] = handler
		return this
	}

	/**
	 * Registers a fixed-interval recurring job — the setInterval
	 * equivalent, not a cron scheduler (see Scheduler.bx's own docblock
	 * for why that's deliberately out of scope). Lazily creates one
	 * internal Scheduler instance on the first call; an app that never
	 * calls schedule() pays nothing for it, same "no cost until used"
	 * posture as wsRoutes/WsUpgradeRouter above.
	 *
	 *   app.schedule( 60000, () => { ... } )
	 *   app.schedule( 60000, ( job ) => { ... }, { name: "cleanup", immediate: true } )
	 *
	 * Returns a job handle ({ cancel(), name }) — see Scheduler.bx's
	 * schedule() for the full options (name/immediate/allowOverlap).
	 */
	function schedule( intervalMs, callback, options = {} ) {
		if ( isNull( variables.scheduler ) ) {
			variables.scheduler = new Scheduler( this.settings, this )
		}
		return variables.scheduler.schedule( intervalMs, callback, options )
	}

	/**
	 * Lazily builds this app's one shared ClusterManager — cross-process
	 * peer discovery and manager election, backed by a durable cache().
	 * See plans/cluster-support.md for the full design. Safe to call even
	 * when clustering was never configured (cluster.enabled stays false,
	 * the module default): every ClusterManager method then behaves as a
	 * no-op, so this never throws just because it was called.
	 *
	 * Shared explicitly, not built separately per-feature, so a clustered
	 * app.schedule() job and boxExpressStomp({ cluster: app.getClusterManager() })
	 * reuse one peer-discovery loop instead of running two redundant ones:
	 *
	 *   stomp = boxExpressStomp( { cluster: app.getClusterManager() } )
	 */
	function getClusterManager() {
		if ( isNull( variables.clusterManager ) ) {
			variables.clusterManager = new cluster.ClusterManager( this, this.settings )
		}
		return variables.clusterManager
	}

	/**
	 * Introspection getter, same pattern as Stomp.bx's getConnections()/
	 * getSubscriptions() — an empty struct before the first schedule()
	 * call, since there's no Scheduler instance yet to ask.
	 */
	function getScheduledJobs() {
		return isNull( variables.scheduler ) ? {} : variables.scheduler.getJobs()
	}

	/**
	 * use( handler ) / use( handler1, handler2, ... )
	 * use( mountPath, handler ) / use( mountPath, handler1, handler2, ..., router )
	 * See Router.use() for the full signature — this just forwards every
	 * argument through, variadic middleware chains included.
	 */
	function use( pathOrHandler = "" ) {
		variables.router.use( argumentCollection = arguments )
		return this
	}

	function param( name, callback ) {
		variables.router.param( argumentCollection = arguments )
		return this
	}

	function route( path ) {
		return variables.router.route( argumentCollection = arguments )
	}

	function set( name, value ) {
		this.settings[ name ] = value
		// Response.render() does a plain `include` on an absolute path it has already
		// canonicalized and verified is inside this directory (its own path-traversal
		// check). BoxLang core no longer resolves an absolute include path unless it's
		// backed by a registered mapping — that check is intentional (BoxLang won't
		// implicitly trust a bare absolute path), so this registers one instead of
		// asking BoxLang to bypass it. Registered once here at app-configuration time
		// (not per-request from render()) since Configuration.mappings is a sorted,
		// non-concurrent structure — safe for the single-threaded startup sequence,
		// not for concurrent virtual-thread request handlers.
		//
		// clearConfigCache() is required, not optional: RequestBoxContext.getConfig()
		// memoizes its merged config struct on first read and never invalidates it.
		// The context executing this app.bxs script (captured by listen() when it
		// builds HttpBridge, and reused for every request handled afterward) may
		// already have read+cached its config via an earlier app.use()/route call
		// before this line runs — without clearing that cache, the mapping above is
		// live on the runtime's Configuration but invisible to every request's
		// include, and every render() keeps failing exactly as before this fix.
		if ( lCase( name ) == "views" ) {
			getBoxRuntime().getConfiguration().registerMapping( value, value )
			getBoxContext().clearConfigCache()
		}
		return this
	}

	function getSetting( name ) {
		return this.settings[ name ] ?: javacast( "null", "" )
	}

	/**
	 * Starts the server. Blocks the calling thread by default (options.block = true) —
	 * Node keeps a CLI process alive via its event loop, BoxLang's CLI runtime has no
	 * equivalent, so listen() blocks itself rather than requiring every caller to
	 * remember a keep-alive loop. Pass { block: false } for the old non-blocking
	 * behavior (used by this project's own test suite, or anyone embedding BoxExpress
	 * inside a larger app that manages its own lifecycle) — close() still works to stop
	 * the server either way, and also breaks the blocking loop if something else (e.g.
	 * a route handler, on its own virtual thread) calls it while listen() is blocked.
	 *
	 * options.backlog sets the TCP accept queue depth (default 1024), passed through to
	 * Undertow's org.xnio.Options.BACKLOG. A small backlog is enough that a burst of
	 * concurrent connections — well within what the virtual-thread executor itself can
	 * handle — can get refused with a connection reset instead of queued, which is why
	 * this defaults higher than Undertow's own default rather than being left unset.
	 * Exposed here instead of hardcoded higher still, since a reverse proxy in front
	 * (already required — see req.secure) may queue connections itself and make a large
	 * backlog here redundant.
	 *
	 * UndertowOptions.ENABLE_STATISTICS is turned on unconditionally — off by
	 * default in Undertow itself since tracking adds a small amount of overhead
	 * per request, but that cost is negligible next to everything else already
	 * happening per request here (virtual thread dispatch, routing, BoxLang
	 * closure invocation), and having it always on is what makes
	 * getConnectorStatistics() below actually return something instead of null.
	 */
	function listen( port, callback, options = {} ) {
		var backlog = options.backlog ?: 1024
		var bridge = new HttpBridge( variables.router, this.settings, this.locals, variables.metricsRegistry )

		var glue = new adapters.UndertowHandlerGlue( bridge )
		var innerProxy = createDynamicProxy( glue, [ "io.undertow.server.HttpHandler" ] )

		// Undertow dispatches handlers on its own I/O thread by default,
		// where blocking I/O throws IllegalStateException — confirmed
		// directly, reading the request body via getInputStream() (needed
		// for BodyParsers.bx/Multipart.bx) failed exactly this way without
		// dispatching off of it first. UndertowVirtualThreadHandler moves
		// each request onto its own virtual thread before the handler ever
		// runs, matching the virtual-thread-per-request model this project
		// uses everywhere else (this project's whole handler model is
		// blocking by design, not async, so every request needs a thread
		// it's safe to block on).
		var dispatchHandler = new adapters.UndertowVirtualThreadHandler( innerProxy )
		var proxy = createDynamicProxy( dispatchHandler, [ "io.undertow.server.HttpHandler" ] )

		// An app that never called app.ws() pays nothing for this — proxy
		// (the plain HTTP dispatch chain) is set directly as Undertow's
		// handler, no extra indirection. Only when at least one WebSocket
		// route exists does a request first pass through WsUpgradeRouter,
		// which delegates to the WebSocket handshake handler for a
		// matching upgrade request and to the exact same HTTP chain,
		// completely unchanged, for everything else.
		var rootProxy = proxy
		if ( !structIsEmpty( variables.wsRoutes ) ) {
			var wsConnectionCallback = new adapters.WsConnectionCallback(
				variables.wsRoutes,
				this.settings.wsMaxMessageSize ?: 1048576,
				this.settings.wsIdleTimeoutMs ?: 0
			)
			variables.wsCallbackObject = wsConnectionCallback
			var wsCallbackProxy = createDynamicProxy( wsConnectionCallback, [ "io.undertow.websockets.WebSocketConnectionCallback" ] )

			// Registering the STOMP-over-WebSocket subprotocol names here
			// (rather than leaving the handshake handler's default, which
			// negotiates none) is what lets stomp.js and other STOMP client
			// libraries — several of which send Sec-WebSocket-Protocol and
			// expect it echoed — complete the handshake cleanly. Harmless to
			// every other app.ws() route: a client that never sends
			// Sec-WebSocket-Protocol (a bare app.ws() consumer, or this
			// project's own WebSocketTestClient) skips negotiation
			// entirely, and one that sends an unrelated protocol name just
			// gets none selected — confirmed directly this doesn't fail the
			// handshake, only skips echoing a protocol back.
			var wsSubprotocols = createObject( "java", "java.util.HashSet" ).init()
			wsSubprotocols.add( "v12.stomp" )
			wsSubprotocols.add( "v11.stomp" )
			wsSubprotocols.add( "v10.stomp" )
			var wsHandshakes = createObject( "java", "java.util.ArrayList" ).init()
			wsHandshakes.add( createObject( "java", "io.undertow.websockets.core.protocol.version13.Hybi13Handshake" ).init( wsSubprotocols, false ) )
			var wsHandshakeHandler = createObject( "java", "io.undertow.websockets.WebSocketProtocolHandshakeHandler" ).init( wsHandshakes, wsCallbackProxy )

			var upgradeRouter = new adapters.WsUpgradeRouter( wsHandshakeHandler, variables.wsRoutes, proxy )
			rootProxy = createDynamicProxy( upgradeRouter, [ "io.undertow.server.HttpHandler" ] )
		}

		var builder = createObject( "java", "io.undertow.Undertow" ).builder()
		builder.addHttpListener( port, "0.0.0.0" )
		// Wrapping the whole chain in Undertow's GracefulShutdownHandler is what
		// lets shutdown() below refuse new requests with a 503 while waiting for
		// the ones already running to finish.
		variables.gracefulHandler = createObject( "java", "io.undertow.server.handlers.GracefulShutdownHandler" ).init( rootProxy )
		builder.setHandler( variables.gracefulHandler )
		builder.setSocketOption( createObject( "java", "org.xnio.Options" ).BACKLOG, javacast( "int", backlog ) )
		builder.setServerOption( createObject( "java", "io.undertow.UndertowOptions" ).ENABLE_STATISTICS, javacast( "boolean", true ) )

		try {
			variables.undertowServer = builder.build()
			variables.undertowServer.start()
		} catch ( any e ) {
			var cause = e.getCause()
			if ( !isNull( cause ) && cause.getClass().getName() == "java.net.BindException" ) {
				println( variables.color.red( "[BoxExpress] Port #port# is already in use — exiting." ) )
				createObject( "java", "java.lang.System" ).exit( 1 )
				return this
			}
			rethrow;
		}

		variables.running = true
		_registerShutdownHook()

		if ( this.settings[ "reloadOnChange" ] ?: false ) {
			_startReloadWatcher()
		}

		if ( !isNull( callback ) ) {
			callback( port )
		}

		if ( options.block ?: true ) {
			while ( variables.running ) {
				sleep( 1000 )
			}
		}

		return this
	}

	/**
	 * Registers liveness and readiness endpoints — GET <path>/live (200 as
	 * long as the process can answer at all) and GET <path>/ready (200 when
	 * the app should receive traffic, 503 when it shouldn't) — for load
	 * balancers and orchestrators (a Kubernetes livenessProbe/readinessProbe).
	 *
	 *   app.health()
	 *   app.health( { path: "/healthz", checks: { db: () => pingDatabase() } } )
	 *
	 * Each entry in options.checks is a function returning false — or
	 * throwing — when that dependency is unhealthy; readiness then reports 503
	 * with the names of the failing checks (never their exception messages).
	 * Readiness also reports 503 the moment shutdown() begins, so a load
	 * balancer stops sending traffic before the drain starts.
	 *
	 * Routes are ordinary ones, so call this before app.use(...) if the
	 * endpoints shouldn't pass through session/CSRF/rate-limit middleware.
	 */
	function health( options = {} ) {
		var basePath = options.path ?: "/health"
		var checks = options.checks ?: {}
		var app = this

		get( basePath & "/live", ( req, res ) => {
			res.set( "Cache-Control", "no-store" )
			res.json( { status: "ok" } )
		} )

		get( basePath & "/ready", ( req, res ) => {
			res.set( "Cache-Control", "no-store" )
			if ( app.isDraining() ) {
				return res.status( 503 ).json( { status: "draining" } )
			}
			var failed = []
			for ( var checkName in checks ) {
				try {
					var result = checks[ checkName ]()
					if ( !isNull( result ) && isBoolean( result ) && !result ) {
						failed.append( checkName )
					}
				} catch ( any e ) {
					println( "[BoxExpress] health check '" & checkName & "' threw: " & e.message )
					failed.append( checkName )
				}
			}
			if ( failed.len() ) {
				return res.status( 503 ).json( { status: "unhealthy", failing: failed } )
			}
			res.json( { status: "ready" } )
		} )

		return this
	}

	/**
	 * Runs one request through this app — routing, middleware, handlers,
	 * error handling, all of it — without opening a port, and returns what
	 * the app produced. For testing your own app:
	 *
	 *   var res = app.inject( { method: "POST", url: "/users", body: { name: "ada" } } )
	 *   expect( res.statusCode ).toBe( 201 )
	 *   expect( res.json().name ).toBe( "ada" )
	 *
	 * options:
	 *   method    default "GET"
	 *   url       path plus optional query string, default "/" (a bare string
	 *             argument, app.inject( "/x" ), means a GET of that url)
	 *   query     a struct appended to the query string
	 *   headers   a struct of request headers
	 *   cookies   a struct sent as the Cookie header — pass a previous
	 *             response's `cookies` to carry a session across requests
	 *   body      a struct/array (sent as JSON), a string, or binary, as-is
	 *   form      a struct sent urlencoded
	 *   ip        the client address req.ip sees, default "127.0.0.1"
	 *   log       true to print the usual request log line (default false)
	 *
	 * Returns an InjectResponse: statusCode, body, headers, cookies, json(),
	 * header( name ). The handler runs on the calling thread. WebSocket
	 * routes aren't reachable this way, and req.rawExchange() is null.
	 */
	function inject( options = {} ) {
		if ( isSimpleValue( options ) ) {
			options = { url: options }
		}

		var method = uCase( options.method ?: "GET" )
		var rawUrl = options.url ?: "/"
		var queryPos = find( "?", rawUrl )
		var pathPart = queryPos ? left( rawUrl, queryPos - 1 ) : rawUrl
		var queryString = queryPos ? mid( rawUrl, queryPos + 1, len( rawUrl ) - queryPos ) : ""

		if ( structKeyExists( options, "query" ) ) {
			var extra = _urlEncodePairs( options.query )
			queryString = len( queryString ) && len( extra ) ? queryString & "&" & extra : queryString & extra
		}

		// Undertow hands handlers the decoded path; "+" is a literal plus in a
		// path (only in a query does it mean a space), so protect it first.
		var path = createObject( "java", "java.net.URLDecoder" ).decode( replace( pathPart, "+", "%2B", "all" ), "UTF-8" )
		if ( !len( path ) || left( path, 1 ) != "/" ) {
			path = "/" & path
		}

		var headers = {}
		for ( var headerName in ( options.headers ?: {} ) ) {
			headers[ headerName ] = toString( options.headers[ headerName ] )
		}
		if ( !structKeyExists( headers, "Host" ) ) {
			headers[ "Host" ] = "localhost"
		}
		if ( structKeyExists( options, "cookies" ) && !structIsEmpty( options.cookies ) ) {
			var cookiePairs = []
			for ( var cookieName in options.cookies ) {
				cookiePairs.append( cookieName & "=" & options.cookies[ cookieName ] )
			}
			headers[ "Cookie" ] = arrayToList( cookiePairs, "; " )
		}

		var bodyBytes = "".getBytes( "UTF-8" )
		var contentType = ""
		if ( structKeyExists( options, "form" ) ) {
			bodyBytes = _urlEncodePairs( options.form ).getBytes( "UTF-8" )
			contentType = "application/x-www-form-urlencoded"
		} else if ( structKeyExists( options, "body" ) ) {
			if ( isBinary( options.body ) ) {
				bodyBytes = options.body
			} else if ( isSimpleValue( options.body ) ) {
				bodyBytes = toString( options.body ).getBytes( "UTF-8" )
			} else {
				bodyBytes = JSONSerialize( options.body ).getBytes( "UTF-8" )
				contentType = "application/json"
			}
		}
		if ( len( contentType ) && !structKeyExists( headers, "Content-Type" ) ) {
			headers[ "Content-Type" ] = contentType
		}
		if ( !structKeyExists( headers, "Content-Length" ) && ( bodyBytes.len() > 0 || listFindNoCase( "POST,PUT,PATCH", method ) ) ) {
			headers[ "Content-Length" ] = toString( bodyBytes.len() )
		}

		var adapter = new adapters.InjectExchangeAdapter( method, path, queryString, headers, bodyBytes, options.ip ?: "127.0.0.1" )

		// A shallow copy, so the request log line can be switched off for
		// this call without touching the app's real settings.
		var injectSettings = structCopy( this.settings )
		injectSettings[ "log" ] = options.log ?: false
		new HttpBridge( variables.router, injectSettings, this.locals ).handle( adapter )

		return adapter.getResult()
	}

	private function _urlEncodePairs( pairs ) {
		var parts = []
		for ( var key in pairs ) {
			var values = isArray( pairs[ key ] ) ? pairs[ key ] : [ pairs[ key ] ]
			for ( var value in values ) {
				parts.append( urlEncodedFormat( key ) & "=" & urlEncodedFormat( toString( value ) ) )
			}
		}
		return arrayToList( parts, "&" )
	}

	/**
	 * Registers a Prometheus-format metrics endpoint — GET <path> (default
	 * "/metrics") — and starts counting requests. Call it before listen().
	 *
	 *   app.metrics()
	 *   app.metrics( { path: "/-/metrics", token: getSystemSetting( "METRICS_TOKEN" ), sources: [ stomp ] } )
	 *
	 * What it exposes: requests by status class and their total duration (the
	 * `_sum`/`_count` pair a rate or average is built from), Undertow's active
	 * connections/requests and bytes in/out, open WebSocket connections,
	 * whether the app is draining for shutdown, every scheduled job's runs,
	 * failures, overlap skips, last success and last duration, the cluster's
	 * peer count and manager status when clustering is on, and anything in
	 * options.sources — objects with a getMetrics() method, such as a STOMP
	 * broker (connections, subscriptions, messages published and delivered).
	 *
	 * options.token requires "Authorization: Bearer <token>" — the numbers are
	 * operational detail, so don't leave the endpoint open on a public
	 * listener; put it behind the token, a firewall, or a private port's
	 * proxy. Register this before app.use() middleware if scrapes shouldn't
	 * pass through sessions or rate limiting. Requests made through
	 * app.inject() aren't counted.
	 */
	function metrics( options = {} ) {
		var app = this
		var path = options.path ?: "/metrics"
		var token = options.token ?: ""
		if ( isSimpleValue( variables.metricsRegistry ) ) {
			variables.metricsRegistry = new Metrics()
		}
		for ( var source in ( options.sources ?: [] ) ) {
			variables.metricsSources.append( source )
		}

		get( path, ( req, res ) => {
			if ( len( token ) ) {
				var presented = req.headers[ "Authorization" ] ?: ""
				var expected = "Bearer " & token
				// Constant-time, so the comparison doesn't leak how much of a guess matched.
				if ( !createObject( "java", "java.security.MessageDigest" ).isEqual( presented.getBytes( "UTF-8" ), expected.getBytes( "UTF-8" ) ) ) {
					res.set( "WWW-Authenticate", "Bearer" )
					return res.status( 401 ).send( "Unauthorized" )
				}
			}
			res.set( "Cache-Control", "no-store" )
			res.set( "Content-Type", "text/plain; version=0.0.4; charset=utf-8" )
			res.send( new PrometheusFormat().render( app.collectMetrics() ) )
		} )

		return this
	}

	/**
	 * Every metric this app currently reports, as PrometheusFormat's input.
	 * Public because the /metrics handler calls it from a closure; useful for
	 * inspecting values in a test, too.
	 */
	function collectMetrics() {
		var out = []
		var registry = variables.metricsRegistry

		if ( !isSimpleValue( registry ) ) {
			var samples = []
			for ( var statusClass in [ "1xx", "2xx", "3xx", "4xx", "5xx" ] ) {
				samples.append( { labels: { class: statusClass }, value: registry.get( "http.requests." & statusClass ) } )
			}
			out.append( { name: "boxexpress_http_requests_total", type: "counter", help: "Requests handled, by response status class.", samples: samples } )
			out.append( {
				name: "boxexpress_http_request_duration_seconds", type: "summary",
				help: "Time spent handling requests.",
				samples: [
					{ suffix: "_sum", labels: {}, value: registry.get( "http.duration.nanos" ) / 1000000000 },
					{ suffix: "_count", labels: {}, value: registry.get( "http.duration.count" ) }
				]
			} )
		}

		var stats = getConnectorStatistics()
		if ( !isNull( stats ) ) {
			out.append( { name: "boxexpress_http_active_connections", type: "gauge", help: "Open client connections.", samples: [ { labels: {}, value: stats.getActiveConnections() } ] } )
			out.append( { name: "boxexpress_http_active_requests", type: "gauge", help: "Requests currently being handled.", samples: [ { labels: {}, value: stats.getActiveRequests() } ] } )
			out.append( { name: "boxexpress_http_bytes_received_total", type: "counter", help: "Bytes received.", samples: [ { labels: {}, value: stats.getBytesReceived() } ] } )
			out.append( { name: "boxexpress_http_bytes_sent_total", type: "counter", help: "Bytes sent.", samples: [ { labels: {}, value: stats.getBytesSent() } ] } )
		}

		out.append( {
			name: "boxexpress_websocket_connections", type: "gauge", help: "Open WebSocket connections.",
			samples: [ { labels: {}, value: isNull( variables.wsCallbackObject ) ? 0 : variables.wsCallbackObject.openCount() } ]
		} )
		out.append( { name: "boxexpress_draining", type: "gauge", help: "1 while the app is shutting down.", samples: [ { labels: {}, value: variables.draining ? 1 : 0 } ] } )

		var producers = []
		if ( !isNull( variables.scheduler ) ) {
			producers.append( variables.scheduler )
		}
		if ( !isNull( variables.clusterManager ) ) {
			producers.append( variables.clusterManager )
		}
		for ( var extra in variables.metricsSources ) {
			producers.append( extra )
		}
		for ( var producer in producers ) {
			try {
				out.append( producer.getMetrics(), true )
			} catch ( any e ) {
				println( "[BoxExpress] a metrics source failed and was skipped: " & e.message )
			}
		}
		return out
	}

	function isDraining() {
		return variables.draining
	}

	/**
	 * Graceful stop: readiness starts reporting 503 straight away; after
	 * options.drainDelayMs (default 0 — set it to give a load balancer time to
	 * notice before requests start being refused) new requests get a 503,
	 * every open WebSocket connection is closed, and in-flight requests get up
	 * to options.timeoutMs (default: app.set("shutdownTimeoutMs"), else 10000)
	 * to finish before the server stops regardless. A long-lived response such
	 * as an SSE stream counts as in-flight until it ends, so it will use the
	 * whole timeout. Returns { drained, webSocketsClosed } — drained is false
	 * if the timeout ran out with requests still running.
	 *
	 * close() remains the immediate stop; this is what SIGTERM/Ctrl-C now run.
	 */
	function shutdown( options = {} ) {
		if ( variables.closed ) {
			return { drained: true, webSocketsClosed: 0 }
		}
		var timeoutMs = options.timeoutMs ?: ( this.settings.shutdownTimeoutMs ?: 10000 )
		var drainDelayMs = options.drainDelayMs ?: 0
		var drained = true
		var webSocketsClosed = 0

		variables.draining = true
		if ( drainDelayMs > 0 ) {
			sleep( drainDelayMs )
		}
		if ( !isNull( variables.gracefulHandler ) ) {
			variables.gracefulHandler.shutdown()
		}
		if ( !isNull( variables.wsCallbackObject ) ) {
			webSocketsClosed = variables.wsCallbackObject.closeAll()
		}
		if ( !isNull( variables.gracefulHandler ) && timeoutMs > 0 ) {
			drained = variables.gracefulHandler.awaitShutdown( javacast( "long", timeoutMs ) )
		}
		close()
		return { drained: drained, webSocketsClosed: webSocketsClosed }
	}

	function close() {
		if ( variables.closed ) {
			return this
		}
		variables.closed = true
		variables.running = false

		if ( !isNull( variables.reloadWatcher ) ) {
			variables.reloadWatcher.stop()
			variables.reloadWatcher = javacast( "null", "" )
		}

		if ( !isNull( variables.scheduler ) ) {
			variables.scheduler.shutdown()
			variables.scheduler = javacast( "null", "" )
		}

		if ( !isNull( variables.clusterManager ) ) {
			variables.clusterManager.shutdown()
			variables.clusterManager = javacast( "null", "" )
		}

		if ( !isNull( variables.shutdownHook ) ) {
			try {
				createObject( "java", "java.lang.Runtime" ).getRuntime().removeShutdownHook( variables.shutdownHook )
			} catch ( any e ) {
			// already in the middle of JVM shutdown — the hook is running (or has run) anyway
			}
			variables.shutdownHook = javacast( "null", "" )
		}

		if ( !isNull( variables.undertowServer ) ) {
			variables.undertowServer.stop()
			variables.undertowServer = javacast( "null", "" )
		}

		return this
	}

	/**
	 * Live request-level metrics straight from Undertow's own listener — active
	 * connections/requests, total request count, bytes sent/received, error
	 * count, and processing time. Complements JVM/OS-level monitoring (memory,
	 * CPU, GC via java.lang.management) with the HTTP-layer numbers those
	 * MXBeans can't see. Returns null before listen() has run, after close(),
	 * or on the rare build where Undertow has no listener registered — always
	 * non-null otherwise, since listen() unconditionally turns statistics
	 * tracking on (see its docblock).
	 *
	 * @return {io.undertow.server.ConnectorStatistics} or null.
	 */
	function getConnectorStatistics() {
		if ( isNull( variables.undertowServer ) ) {
			return javacast( "null", "" )
		}

		var listeners = variables.undertowServer.getListenerInfo()
		if ( listeners.isEmpty() ) {
			return javacast( "null", "" )
		}

		return listeners.get( javacast( "int", 0 ) ).getConnectorStatistics()
	}

	/**
	 * Ensures close() runs on Ctrl-C / SIGTERM / normal JVM exit, not just on
	 * an explicit app.close() call. Without this, listen()'s blocking loop
	 * and the reload watcher's daemon thread just get torn down by the JVM
	 * without ever calling undertowServer.stop() or reloadWatcher.stop() — the
	 * process dies, but nothing runs the cleanup path, which is what let the
	 * dev-mode watcher outlive a Ctrl-C'd server.
	 */
	private function _registerShutdownHook() {
		var app = this
		var runnable = createDynamicProxy(
			new ThreadRunnable( function() {
				// SIGTERM/Ctrl-C drain in-flight requests first; app.set(
				// "shutdownTimeoutMs", 0) restores the old immediate stop.
				app.shutdown( { timeoutMs: app.settings.shutdownTimeoutMs ?: 5000 } )
			} ),
			[ "java.lang.Runnable" ]
		)
		variables.shutdownHook = createObject( "java", "java.lang.Thread" ).init( runnable )
		createObject( "java", "java.lang.Runtime" ).getRuntime().addShutdownHook( variables.shutdownHook )
	}

	/**
	 * Dev-mode convenience: app.set("reloadOnChange", true) watches the
	 * current working directory for .bx/.bxs changes (via FileWatcher) and
	 * restarts the process on save — .bxm views aren't watched, since
	 * render()'s bx:include re-reads the template from disk on every
	 * request, so a view edit already takes effect on the next request
	 * with no restart needed. Deliberately separate from
	 * app.set("env", "development") — the two are orthogonal settings, so
	 * either can be used without the other.
	 */
	private function _startReloadWatcher() {
		variables.reloadWatcher = new FileWatcher( expandPath( "." ) )

		var runnable = createDynamicProxy(
			new ThreadRunnable( function() {
				variables.reloadWatcher.watch( function( changedPath ) {
					println( variables.color.cyan( "[reloadOnChange] #changedPath# changed — restarting..." ) )
					_restartProcess()
				} )
			} ),
			[ "java.lang.Runnable" ]
		)

		var thread = createObject( "java", "java.lang.Thread" ).init( runnable )
		thread.setDaemon( true )
		thread.start()
	}

	/**
	 * Replays the exact original JVM invocation (ProcessHandle.current()) to
	 * relaunch the app, rather than assuming a fixed "boxlang <script>"
	 * shape — this way it works whatever the entry script is named and
	 * however it was launched (bvm-managed boxlang, a raw java -jar, custom
	 * JVM flags, etc).
	 *
	 * pb.start() only has to launch the new OS process — it doesn't wait for
	 * BoxLang to boot or the new process to bind the port, so it's safe to
	 * call before close() releases this server. That ordering matters: if
	 * launching the replacement fails (bad command, a transient OS resource
	 * limit, whatever), the current server is left running and a clear error
	 * is logged, rather than close() + exit() already having torn it down
	 * with nothing left to replace it — previously an uncaught exception
	 * here (on this daemon thread) silently killed the server with no
	 * replacement and no visible explanation tying the two together.
	 */
	private function _restartProcess() {
		var info = createObject( "java", "java.lang.ProcessHandle" ).current().info()

		var command = []
		command.append( info.command().isPresent() ? info.command().get() : "boxlang" )
		if ( info.arguments().isPresent() ) {
			command.append( info.arguments().get(), true )
		} else {
			command.append( getBaseTemplatePath() )
		}

		try {
			var pb = createObject( "java", "java.lang.ProcessBuilder" ).init( command )
			pb.inheritIO()
			pb.start()
		} catch ( any e ) {
			println( variables.color.red( "[reloadOnChange] Failed to restart: #e.message# — keeping the current server running." ) )
			return
		}

		close()
		createObject( "java", "java.lang.System" ).exit( 0 )
	}

}
