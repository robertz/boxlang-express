/**
 * Handed to the callback given to app.ws(path, callback) — one instance per
 * open connection. Same shape as SseEmitter deliberately: onMessage/
 * onClose register callbacks the way SseEmitter's send/comment/close are
 * called, send()/close() are safe to call from another thread (a route
 * handler holding onto a connection to push to it later), each funneled
 * through a per-connection lock so two writers can't interleave on the
 * shared channel — same reasoning, same fix shape as SseEmitter's own
 * thread-safety fix. this.headers/this.cookies carry the handshake
 * request's headers/cookies (mirroring Request.bx's req.headers/
 * req.cookies) so an app.ws() handler or STOMP's authenticate() can read
 * a session cookie instead of relying solely on STOMP's login/passcode
 * frame headers.
 */
class {

	function init( channel, headers = {} ) {
		variables.channel = channel
		variables.closed = false
		variables.messageCallback = javacast( "null", "" )
		variables.closeCallback = javacast( "null", "" )
		variables.lockName = "WebSocketConnection-" & createUUID()
		// send()'s actual blocking write has no timeout of its own —
		// confirmed directly that a peer which vanishes mid-write can hang
		// sendTextBlocking() forever, with nothing bounding it but the
		// lock's own 5s ACQUISITION timeout below (which only protects a
		// second caller waiting to get in, not the first caller already
		// inside doing the write). Running the write on its own thread and
		// bounding the WAIT for it lets a caller give up and move on even
		// when the underlying write itself never will — see send()'s own
		// docblock for the full reasoning.
		variables.sendExecutor = createObject( "java", "java.util.concurrent.Executors" ).newVirtualThreadPerTaskExecutor()
		this.headers = headers
		this.cookies = _parseCookies( headers[ "Cookie" ] ?: "" )
		return this
	}

	/**
	 * A single request header from the handshake, without reaching into
	 * this.headers directly — mirrors Request.get().
	 */
	function get( name ) {
		return this.headers[ name ] ?: javacast( "null", "" )
	}

	/**
	 * Registers the callback that runs for every text message this
	 * connection receives — callback( text ). Call this (and onClose(), if
	 * you need it) before returning from the app.ws() handler; messages
	 * can start arriving as soon as the connection is handed to that
	 * handler, so registering afterward can race a fast client.
	 */
	function onMessage( callback ) {
		variables.messageCallback = callback
		return this
	}

	/**
	 * Registers the callback that runs when this connection closes —
	 * callback( code, reason ) — whether the client disconnected or
	 * close() was called locally.
	 */
	function onClose( callback ) {
		variables.closeCallback = callback
		return this
	}

	/**
	 * Sends one text message. Complex data is JSON-serialized, matching
	 * SseEmitter.send()'s existing convention. No-ops once the connection
	 * is closed rather than throwing — same posture as SseEmitter, since a
	 * caller broadcasting to many connections shouldn't have one already-
	 * closed one blow up the whole loop.
	 *
	 * The actual write runs on variables.sendExecutor (its own thread), and
	 * this waits on it with a hard 5s timeout — undertow's
	 * sendTextBlocking() has no timeout of its own, and has been observed
	 * directly to hang indefinitely against a peer that vanishes mid-write
	 * (the socket write never completes and never errors). Bounding only
	 * the WAIT (not the write itself — a blocked native I/O call can't be
	 * force-killed) means a caller can never be stuck here forever, even
	 * though the abandoned write keeps its own thread alive in the
	 * background until the OS eventually notices the peer is gone.
	 */
	function send( data ) {
		if ( variables.closed ) {
			return this
		}
		var payload = isSimpleValue( data ) ? toString( data ) : JSONSerialize( data )
		lock name="#variables.lockName#" type="exclusive" timeout="5" {
			if ( !variables.closed ) {
				try {
					var future = variables.sendExecutor.submit( createDynamicProxy(
						new ThreadRunnable( function() {
							createObject( "java", "io.undertow.websockets.core.WebSockets" ).sendTextBlocking( payload, variables.channel )
						} ),
						[ "java.lang.Runnable" ]
					) )
					future.get( javacast( "long", 5 ), createObject( "java", "java.util.concurrent.TimeUnit" ).SECONDS )
				} catch ( any e ) {
					variables.closed = true
				}
			}
		}
		return this
	}

	function close() {
		if ( !variables.closed ) {
			lock name="#variables.lockName#" type="exclusive" timeout="5" {
				if ( !variables.closed ) {
					variables.closed = true
					variables.sendExecutor.shutdown()
					try {
						variables.channel.sendClose()
					} catch ( any e ) {
					}
				}
			}
		}
		return this
	}

	function isClosed() {
		return variables.closed
	}

	/**
	 * Called by WsMessageHandlerAdapter, not application code — the
	 * boundary between the Java-shim event and the app's own registered
	 * callback.
	 */
	function _dispatchMessage( text ) {
		if ( !isNull( variables.messageCallback ) ) {
			variables.messageCallback( text )
		}
	}

	/**
	 * Guarded against firing twice — WsMessageHandlerAdapter's onError() now also calls this (an
	 * abrupt disconnect doesn't always get a paired onCloseMessage from Undertow — see
	 * BoxWebSocketListener.java's own onError() docblock), so a connection that errors and then
	 * still receives a real close frame shouldn't run the app's close callback (and whatever
	 * cleanup it does, e.g. Stomp.bx's per-connection registry teardown) more than once.
	 */
	function _dispatchClose( code, reason ) {
		if ( variables.closed ) {
			return
		}
		variables.closed = true
		variables.sendExecutor.shutdown()
		if ( !isNull( variables.closeCallback ) ) {
			variables.closeCallback( code, reason )
		}
	}

	/**
	 * Same parsing as Request.bx's _parseCookies() — kept as its own copy
	 * here rather than a shared util, since the handshake headers this
	 * reads come from a differently-shaped exchange (WebSocketHttpExchange,
	 * not HttpServerExchange) and the two call sites shouldn't be coupled
	 * through a helper just to save a few lines.
	 */
	private function _parseCookies( cookieHeader ) {
		var result = {}
		if ( !len( cookieHeader ) ) {
			return result
		}
		for ( var pair in cookieHeader.listToArray( ";" ) ) {
			var trimmedPair = pair.trim()
			var eqPos = trimmedPair.find( "=" )
			if ( eqPos ) {
				var cookieName = ( eqPos == 1 ? "" : trimmedPair.left( eqPos - 1 ) ).trim()
				var cookieValue = ( eqPos == trimmedPair.len() ? "" : trimmedPair.right( trimmedPair.len() - eqPos ) ).trim()
				result[ cookieName ] = urlDecode( cookieValue )
			}
		}
		return result
	}

}
