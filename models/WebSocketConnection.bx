/**
 * Handed to the callback given to app.ws(path, callback) — one instance per
 * open connection. Same shape as SseEmitter deliberately: onMessage/
 * onClose register callbacks the way SseEmitter's send/comment/close are
 * called, send()/close() are safe to call from another thread (a route
 * handler holding onto a connection to push to it later), each funneled
 * through a per-connection lock so two writers can't interleave on the
 * shared channel — same reasoning, same fix shape as SseEmitter's own
 * thread-safety fix.
 */
class {

	function init( channel ) {
		variables.channel = channel
		variables.closed = false
		variables.messageCallback = javacast( "null", "" )
		variables.closeCallback = javacast( "null", "" )
		variables.lockName = "WebSocketConnection-" & createUUID()
		return this
	}

	/**
	 * Registers the callback that runs for every text message this
	 * connection receives — callback( text ). Call this (and onClose(), if
	 * you need it) before returning from the app.ws() handler; messages
	 * can start arriving as soon as the connection is handed to that
	 * handler, so registering afterward can race a fast client.
	 */
	function onMessage( callback ) {
		variables.messageCallback = callback
		return this
	}

	/**
	 * Registers the callback that runs when this connection closes —
	 * callback( code, reason ) — whether the client disconnected or
	 * close() was called locally.
	 */
	function onClose( callback ) {
		variables.closeCallback = callback
		return this
	}

	/**
	 * Sends one text message. Complex data is JSON-serialized, matching
	 * SseEmitter.send()'s existing convention. No-ops once the connection
	 * is closed rather than throwing — same posture as SseEmitter, since a
	 * caller broadcasting to many connections shouldn't have one already-
	 * closed one blow up the whole loop.
	 */
	function send( data ) {
		if ( variables.closed ) {
			return this
		}
		var payload = isSimpleValue( data ) ? toString( data ) : JSONSerialize( data )
		lock name="#variables.lockName#" type="exclusive" timeout="5" {
			if ( !variables.closed ) {
				try {
					createObject( "java", "io.undertow.websockets.core.WebSockets" ).sendTextBlocking( payload, variables.channel )
				} catch ( any e ) {
					variables.closed = true
				}
			}
		}
		return this
	}

	function close() {
		if ( !variables.closed ) {
			lock name="#variables.lockName#" type="exclusive" timeout="5" {
				if ( !variables.closed ) {
					variables.closed = true
					try {
						variables.channel.sendClose()
					} catch ( any e ) {
					}
				}
			}
		}
		return this
	}

	function isClosed() {
		return variables.closed
	}

	/**
	 * Called by WsMessageHandlerAdapter, not application code — the
	 * boundary between the Java-shim event and the app's own registered
	 * callback.
	 */
	function _dispatchMessage( text ) {
		if ( !isNull( variables.messageCallback ) ) {
			variables.messageCallback( text )
		}
	}

	function _dispatchClose( code, reason ) {
		variables.closed = true
		if ( !isNull( variables.closeCallback ) ) {
			variables.closeCallback( code, reason )
		}
	}

}
