/**
 * Wraps a com.sun.net.httpserver.HttpExchange as an Express-style response object.
 * All terminal methods (send/json/sendStatus/redirect) funnel through _end() which
 * writes headers + body exactly once and closes the exchange.
 */
class {

	function init( exchange, settings = {} ) {
		variables.exchange = exchange
		variables.sent = false
		variables.statusCode = 200
		variables.settings = settings
		variables.STATUS_TEXT = {
			200: "OK", 201: "Created", 204: "No Content",
			301: "Moved Permanently", 302: "Found",
			400: "Bad Request", 401: "Unauthorized", 403: "Forbidden", 404: "Not Found",
			405: "Method Not Allowed", 409: "Conflict", 422: "Unprocessable Entity",
			500: "Internal Server Error", 502: "Bad Gateway", 503: "Service Unavailable"
		}
		return this
	}

	function isSent() {
		return variables.sent
	}

	function status( code ) {
		variables.statusCode = code
		return this
	}

	function set( name, value ) {
		variables.exchange.getResponseHeaders().set( name, value )
		return this
	}

	function header( name, value ) {
		return set( name, value )
	}

	function type( mimeType ) {
		return set( "Content-Type", mimeType )
	}

	function cookie( name, value, options = {} ) {
		var parts = [ name & "=" & urlEncodedFormat( value ) ]
		parts.append( "Path=" & ( options.path ?: "/" ) )
		if ( !isNull( options.maxAge ) ) {
			parts.append( "Max-Age=" & options.maxAge )
		}
		if ( options.httpOnly ?: true ) {
			parts.append( "HttpOnly" )
		}
		if ( options.secure ?: false ) {
			parts.append( "Secure" )
		}
		if ( !isNull( options.sameSite ) ) {
			parts.append( "SameSite=" & options.sameSite )
		}
		variables.exchange.getResponseHeaders().add( "Set-Cookie", parts.toList( "; " ) )
		return this
	}

	function send( data ) {
		if ( isStruct( data ) || isArray( data ) ) {
			return json( data )
		}

		var body = isNull( data ) ? "" : toString( data )

		if ( isNull( variables.exchange.getResponseHeaders().getFirst( "Content-Type" ) ) ) {
			type( "text/html; charset=utf-8" )
		}

		return _end( body.getBytes( "UTF-8" ) )
	}

	function json( data ) {
		type( "application/json; charset=utf-8" )
		return _end( JSONSerialize( data ).getBytes( "UTF-8" ) )
	}

	function sendStatus( code ) {
		status( code )
		var text = variables.STATUS_TEXT[ code ] ?: toString( code )
		type( "text/plain; charset=utf-8" )
		return _end( text.getBytes( "UTF-8" ) )
	}

	function redirect( targetUrl, code = 302 ) {
		status( code )
		set( "Location", targetUrl )
		return _end( [] )
	}

	function end( data = "" ) {
		return _end( toString( data ).getBytes( "UTF-8" ) )
	}

	/**
	 * Send raw bytes (e.g. from a file read) with an explicit content type,
	 * bypassing the string/UTF-8 round trip so binary payloads aren't corrupted.
	 */
	function sendBytes( bytes, contentType ) {
		if ( !isNull( contentType ) ) {
			type( contentType )
		}
		return _end( bytes )
	}

	/**
	 * Send a file from disk. Any path is allowed (unlike static middleware, this is
	 * driven by server-side route code, not user-supplied request paths) but a
	 * root-relative escape check still runs when options.root is given, so a caller
	 * building the path from user input (e.g. req.params) gets the same containment
	 * guarantee as express.static().
	 */
	function sendFile( filePath, options = {} ) {
		var target = filePath

		if ( !isNull( options.root ) ) {
			var rootPath = createObject( "java", "java.io.File" ).init( options.root ).getCanonicalFile().toPath()
			var candidate = rootPath.resolve( filePath ).normalize()
			var realRoot = ""
			var realCandidate = ""
			try {
				realRoot = rootPath.toRealPath()
				realCandidate = candidate.toRealPath()
			} catch ( any e ) {
				throw( message = "File not found: #filePath#", type = "BoxExpress.FileNotFound" )
			}
			if ( !realCandidate.startsWith( realRoot ) ) {
				throw( message = "Invalid file path: #filePath#", type = "BoxExpress.InvalidFilePath" )
			}
			target = realCandidate.toString()
		}

		var fileObj = createObject( "java", "java.io.File" ).init( target )
		if ( !fileObj.exists() || !fileObj.isFile() ) {
			throw( message = "File not found: #filePath#", type = "BoxExpress.FileNotFound" )
		}

		var contentType = options.contentType ?: _guessMimeType( fileObj.getName() )
		var bytes = createObject( "java", "java.nio.file.Files" ).readAllBytes( fileObj.toPath() )

		type( contentType )
		if ( options.download ?: false ) {
			var downloadName = !isNull( options.filename ) ? options.filename : fileObj.getName()
			set( "Content-Disposition", 'attachment; filename="#downloadName#"' )
		}

		return _end( bytes )
	}

	/**
	 * Force-download variant of sendFile() — always sets Content-Disposition: attachment,
	 * defaulting the downloaded filename to the source file's own name.
	 */
	function download( filePath, filename ) {
		var options = { download: true }
		if ( !isNull( filename ) ) {
			options.filename = filename
		}
		return sendFile( filePath, options )
	}

	private function _guessMimeType( fileName ) {
		var mimeTypes = {
			html: "text/html; charset=utf-8", htm: "text/html; charset=utf-8",
			css: "text/css; charset=utf-8", js: "text/javascript; charset=utf-8",
			json: "application/json; charset=utf-8", txt: "text/plain; charset=utf-8",
			png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg", gif: "image/gif",
			svg: "image/svg+xml", ico: "image/x-icon",
			woff: "font/woff", woff2: "font/woff2",
			pdf: "application/pdf", zip: "application/zip",
			csv: "text/csv; charset=utf-8", xml: "application/xml; charset=utf-8",
			mp4: "video/mp4", mp3: "audio/mpeg"
		}
		var ext = listLast( fileName, "." ).lcase()
		return mimeTypes[ ext ] ?: "application/octet-stream"
	}

	/**
	 * Render a view from the configured views directory (app.set("views", dir)) and
	 * send it as the response body. Supports two engines, picked by the view's file
	 * extension:
	 *   .bxm — native BoxLang template (include + savecontent). `data` is available
	 *          inside it as the `data` struct — interpolation needs a <bx:output>
	 *          block, same as classic CFML <cfoutput>.
	 *   .hbs — Handlebars (models/HandlebarsEngine.bx), `data` is the render context
	 *          directly, so template variables are {{data.whatever}} — or {{whatever}}
	 *          if you pass your view data as the top-level struct.
	 * A view with no extension gets one appended based on app.set("view engine", ...),
	 * defaulting to "bxm" — mirrors Express's view-engine setting.
	 */
	function render( view, data = {} ) {
		var viewsDir = variables.settings[ "views" ] ?: javacast( "null", "" )
		if ( isNull( viewsDir ) ) {
			throw(
				message = "No views directory configured — call app.set( ""views"", expandPath( ""./views"" ) ) before using res.render()",
				type = "BoxExpress.NoViewsDir"
			)
		}

		var viewFile = view
		if ( viewFile.right( 4 ) != ".bxm" && viewFile.right( 4 ) != ".hbs" ) {
			viewFile &= "." & ( variables.settings[ "view engine" ] ?: "bxm" )
		}

		var viewsRoot = createObject( "java", "java.io.File" ).init( viewsDir ).getCanonicalFile().toPath()
		var candidate = viewsRoot.resolve( viewFile ).normalize()
		var realCandidate = ""
		var realRoot = ""

		try {
			realCandidate = candidate.toRealPath()
			realRoot = viewsRoot.toRealPath()
		} catch ( any e ) {
			throw( message = "View not found: #view#", type = "BoxExpress.ViewNotFound" )
		}

		if ( !realCandidate.startsWith( realRoot ) ) {
			throw( message = "Invalid view path: #view#", type = "BoxExpress.InvalidViewPath" )
		}

		var templatePath = realCandidate.toString()
		var output = ""

		if ( viewFile.right( 4 ) == ".hbs" ) {
			output = new HandlebarsEngine().render( templatePath, data )
		} else {
			bx:savecontent variable="output" {
				include "#templatePath#"
			}
		}

		type( "text/html; charset=utf-8" )
		return _end( output.getBytes( "UTF-8" ) )
	}

	private function _end( bodyBytes ) {
		if ( variables.sent ) {
			throw( message = "Response already sent for this request", type = "BoxExpress.ResponseAlreadySent" )
		}
		variables.sent = true

		if ( bodyBytes.len() == 0 ) {
			variables.exchange.sendResponseHeaders( variables.statusCode, -1 )
		} else {
			variables.exchange.sendResponseHeaders( variables.statusCode, bodyBytes.len() )
			var outStream = variables.exchange.getResponseBody()
			outStream.write( bodyBytes )
			outStream.close()
		}

		variables.exchange.close()
		return this
	}

}
