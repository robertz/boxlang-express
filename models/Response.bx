/**
 * Express-style response object, backed by an exchange adapter (see
 * models/adapters/UndertowExchangeAdapter.bx) rather than a raw
 * io.undertow.server.HttpServerExchange directly. All terminal methods
 * (send/json/sendStatus/redirect) funnel
 * through _end() which writes headers + body exactly once via the adapter.
 */
class {

	// Built once per class, not once per request.
	static {
		STATUS_TEXT = {
			200: "OK", 201: "Created", 204: "No Content",
			301: "Moved Permanently", 302: "Found",
			400: "Bad Request", 401: "Unauthorized", 403: "Forbidden", 404: "Not Found",
			405: "Method Not Allowed", 406: "Not Acceptable", 409: "Conflict", 422: "Unprocessable Entity",
			500: "Internal Server Error", 502: "Bad Gateway", 503: "Service Unavailable"
		}
		// Stateless, so one instance serves every response.
		CONDITIONAL = new ConditionalGet()
	}

	function init( exchangeAdapter, settings = {}, appLocals = {} ) {
		variables.exchangeAdapter = exchangeAdapter
		variables.sent = false
		variables.statusCode = 200
		variables.bytesWritten = 0
		variables.beforeSendCallbacks = []
		variables.settings = settings
		variables.appLocals = appLocals
		this.locals = {}
		return this
	}

	function isSent() {
		return variables.sent
	}

	function status( code ) {
		variables.statusCode = code
		return this
	}

	/**
	 * The status code that will be (or was) sent — whatever the last status()
	 * call set, defaulting to 200. Every terminal method that isn't a plain
	 * 200 (redirect, sendStatus, sendFileRange's 206/304/416) routes through
	 * status() internally, so this reflects the real outcome even when a
	 * caller never touched status() directly. Added for request-logging
	 * middleware (app.use, registered first) that needs to know the outcome
	 * of a request it can't otherwise observe from outside this class.
	 */
	function getStatusCode() {
		return variables.statusCode
	}

	/**
	 * Byte count of the body actually written by _end() — 0 for a response
	 * still in flight. Same motivation as getStatusCode() above: the "bytes
	 * sent" field of an Apache-style access log.
	 */
	function getBytesWritten() {
		return variables.bytesWritten
	}

	/**
	 * Registers a callback to run once, synchronously, the instant before this
	 * response's headers are actually flushed — the only point guaranteed to
	 * run after every downstream middleware/handler has finished mutating
	 * request/response state, but still early enough to add a header.
	 *
	 * Exists for middleware whose header depends on what happened during
	 * next() (e.g. session middleware deciding whether to send a cookie
	 * based on whether req.session was actually touched) — calling
	 * res.cookie() *after* next() returns is usually too late, since a
	 * terminal method further down the chain (res.json(), etc.) has
	 * normally already called _end() and flushed the headers by then.
	 */
	function onBeforeSend( callback ) {
		variables.beforeSendCallbacks.append( callback )
		return this
	}

	/**
	 * set( name, value ) or set( { name: value, ... } )
	 */
	function set( name, value ) {
		if ( isStruct( name ) ) {
			for ( var headerName in name ) {
				variables.exchangeAdapter.setHeader( headerName, name[ headerName ] )
			}
			return this
		}
		variables.exchangeAdapter.setHeader( name, value )
		return this
	}

	function header( name, value ) {
		return set( name, value )
	}

	/**
	 * A response header set so far, or null.
	 */
	function get( name ) {
		return variables.exchangeAdapter.getHeader( name )
	}

	/**
	 * Adds to a header instead of replacing it. Set-Cookie gets a line per
	 * value; any other header is joined into one comma-separated line,
	 * which means the same thing and keeps res.get() showing all of it.
	 */
	function append( name, value ) {
		var values = isArray( value ) ? value : [ value ]
		if ( compareNoCase( name, "Set-Cookie" ) == 0 ) {
			for ( var item in values ) {
				variables.exchangeAdapter.addHeader( name, item )
			}
			return this
		}
		var existing = variables.exchangeAdapter.getHeader( name ) ?: ""
		var combined = len( existing ) ? [ existing ] : []
		combined.append( values, true )
		if ( combined.len() ) {
			variables.exchangeAdapter.setHeader( name, combined.toList( ", " ) )
		}
		return this
	}

	/**
	 * type( "application/json" ), or an extension: type( "json" ), type( ".png" ).
	 * An unknown extension is sent as application/octet-stream.
	 */
	function type( mimeType ) {
		if ( !toString( mimeType ).find( "/" ) ) {
			var known = new MimeTypes().forExtension( mimeType )
			return set( "Content-Type", len( known ) ? known : "application/octet-stream" )
		}
		return set( "Content-Type", mimeType )
	}

	function location( targetUrl ) {
		return set( "Location", targetUrl )
	}

	/**
	 * Adds field names to Vary, skipping ones already listed — so a cache
	 * keys on every request header the response depends on, however many
	 * middleware each added their own.
	 */
	function vary( field ) {
		var fields = isArray( field ) ? field : toString( field ).listToArray( "," )
		var existing = variables.exchangeAdapter.getHeader( "Vary" ) ?: ""
		var current = existing.listToArray( "," ).map( ( item ) => trim( item ) )
		if ( current.find( "*" ) ) {
			return this
		}
		for ( var item in fields ) {
			var fieldName = trim( item )
			if ( !len( fieldName ) ) {
				continue
			}
			if ( fieldName == "*" ) {
				return set( "Vary", "*" )
			}
			if ( !current.findNoCase( fieldName ) ) {
				current.append( fieldName )
			}
		}
		if ( current.len() ) {
			set( "Vary", current.toList( ", " ) )
		}
		return this
	}

	/**
	 * links( { next: "/items?page=3", last: "/items?page=9" } ) -> a Link
	 * header, added to any already set.
	 */
	function links( linkMap ) {
		var parts = []
		for ( var rel in linkMap ) {
			parts.append( "<" & linkMap[ rel ] & '>; rel="' & _sanitizeHeaderToken( rel ) & '"' )
		}
		return parts.len() ? append( "Link", parts.toList( ", " ) ) : this
	}

	/**
	 * Content-Disposition: attachment, with no file involved — for a body
	 * the handler builds itself. A filename also sets Content-Type from its
	 * extension when that's known.
	 */
	function attachment( filename = "" ) {
		if ( !len( filename ) ) {
			return set( "Content-Disposition", "attachment" )
		}
		var known = new MimeTypes().forExtension( listLast( filename, "." ) )
		if ( len( known ) ) {
			set( "Content-Type", known )
		}
		return set( "Content-Disposition", 'attachment; filename="#_sanitizeHeaderToken( filename )#"' )
	}

	/**
	 * Runs the handler for the type the request's Accept header prefers:
	 *
	 *   res.format( [
	 *     html: () => res.send( "<p>hi</p>" ),
	 *     json: () => res.json( { hi: true } ),
	 *     default: () => res.status( 406 ).send( "Not Acceptable" )
	 *   ] )
	 *
	 * Keys are extensions or full MIME types. Content-Type is set to the
	 * chosen one and Accept is added to Vary. With no match and no
	 * `default`, the response is a 406. When the client has no preference
	 * the first key wins — which is only "the first one written" for an
	 * ordered struct ( [ ... ] ); a plain { ... } has no key order.
	 */
	function format( handlers ) {
		var offered = []
		for ( var key in handlers ) {
			if ( compareNoCase( key, "default" ) != 0 ) {
				offered.append( key )
			}
		}

		vary( "Accept" )

		var chosen = offered.len() ? new Negotiator().mediaType( variables.exchangeAdapter.getRequestHeader( "Accept" ), offered ) : ""
		if ( len( chosen ) ) {
			set( "Content-Type", new MimeTypes().contentType( chosen ) )
			var chosenHandler = handlers[ chosen ]
			chosenHandler()
		} else if ( structKeyExists( handlers, "default" ) ) {
			var defaultHandler = handlers[ "default" ]
			defaultHandler()
		} else {
			sendStatus( 406 )
		}
		return this
	}

	/**
	 * options: path ("/"), domain, maxAge (seconds), expires (a date),
	 * httpOnly (true), secure (false), sameSite ("Lax"; false sends no
	 * SameSite attribute, true means "Strict"), signed (false — needs
	 * app.set( "cookie secret" ); read it back from req.signedCookies).
	 */
	function cookie( name, value, options = {} ) {
		var cookieValue = value
		if ( options.signed ?: false ) {
			var signer = variables.settings[ "cookie signer" ] ?: ""
			if ( isSimpleValue( signer ) ) {
				throw(
					message = "res.cookie() with signed: true needs a secret — call app.set( ""cookie secret"", ... ) first",
					type = "BoxExpress.NoCookieSecret"
				)
			}
			cookieValue = signer.sign( toString( value ) )
		}
		var parts = [ name & "=" & urlEncodedFormat( cookieValue ) ]
		parts.append( "Path=" & ( options.path ?: "/" ) )
		if ( !isNull( options.domain ) ) {
			parts.append( "Domain=" & options.domain )
		}
		if ( !isNull( options.maxAge ) ) {
			parts.append( "Max-Age=" & options.maxAge )
		}
		if ( !isNull( options.expires ) ) {
			parts.append( "Expires=" & dateTimeFormat( options.expires, "EEE, dd MMM yyyy HH:mm:ss", "UTC" ) & " GMT" )
		}
		if ( options.httpOnly ?: true ) {
			parts.append( "HttpOnly" )
		}
		if ( options.secure ?: false ) {
			parts.append( "Secure" )
		}
		var sameSite = options.sameSite ?: "Lax"
		if ( isBoolean( sameSite ) ) {
			sameSite = sameSite ? "Strict" : ""
		}
		if ( len( sameSite ) ) {
			parts.append( "SameSite=" & sameSite )
		}
		variables.exchangeAdapter.addHeader( "Set-Cookie", parts.toList( "; " ) )
		return this
	}

	/**
	 * Tells the browser to drop a cookie. A browser only removes the cookie
	 * whose path and domain match, so pass the same `path`/`domain` (and
	 * `secure`/`sameSite`) options it was set with.
	 */
	function clearCookie( name, options = {} ) {
		var clearOptions = {}
		clearOptions.append( options )
		clearOptions.signed = false
		clearOptions.maxAge = 0
		clearOptions.expires = createDateTime( 1970, 1, 1, 0, 0, 0, 0, "UTC" )
		return cookie( name, "", clearOptions )
	}

	function send( data ) {
		if ( isStruct( data ) || isArray( data ) ) {
			return json( data )
		}

		var body = isNull( data ) ? "" : toString( data )

		if ( isNull( variables.exchangeAdapter.getHeader( "Content-Type" ) ) ) {
			type( "text/html; charset=utf-8" )
		}

		return _end( body.getBytes( "UTF-8" ) )
	}

	function json( data ) {
		type( "application/json; charset=utf-8" )
		return _end( JSONSerialize( data ).getBytes( "UTF-8" ) )
	}

	function sendStatus( code ) {
		status( code )
		var text = static.STATUS_TEXT[ code ] ?: toString( code )
		type( "text/plain; charset=utf-8" )
		return _end( text.getBytes( "UTF-8" ) )
	}

	function redirect( targetUrl, code = 302 ) {
		status( code )
		location( targetUrl )
		return _end( [] )
	}

	function end( data = "" ) {
		return _end( toString( data ).getBytes( "UTF-8" ) )
	}

	/**
	 * Send raw bytes (e.g. from a file read) with an explicit content type,
	 * bypassing the string/UTF-8 round trip so binary payloads aren't corrupted.
	 */
	function sendBytes( bytes, contentType ) {
		if ( !isNull( contentType ) ) {
			type( contentType )
		}
		return _end( bytes, "" )
	}

	/**
	 * Send a file from disk. Any path is allowed (unlike static middleware, this is
	 * driven by server-side route code, not user-supplied request paths) but a
	 * root-relative escape check still runs when options.root is given, so a caller
	 * building the path from user input (e.g. req.params) gets the same containment
	 * guarantee as express.static(). options.maxAge (seconds) sets Cache-Control:
	 * public, max-age=<n> alongside the ETag/Last-Modified this always sets.
	 */
	function sendFile( filePath, options = {} ) {
		var target = filePath

		if ( !isNull( options.root ) ) {
			var rootPath = createObject( "java", "java.io.File" ).init( options.root ).getCanonicalFile().toPath()
			var candidate = rootPath.resolve( filePath ).normalize()
			var realRoot = ""
			var realCandidate = ""
			try {
				realRoot = rootPath.toRealPath()
				realCandidate = candidate.toRealPath()
			} catch ( any e ) {
				throw( message = "File not found: #filePath#", type = "BoxExpress.FileNotFound" )
			}
			if ( !realCandidate.startsWith( realRoot ) ) {
				throw( message = "Invalid file path: #filePath#", type = "BoxExpress.InvalidFilePath" )
			}
			target = realCandidate.toString()
		}

		var fileObj = createObject( "java", "java.io.File" ).init( target )
		if ( !fileObj.exists() || !fileObj.isFile() ) {
			throw( message = "File not found: #filePath#", type = "BoxExpress.FileNotFound" )
		}

		var conditional = static.CONDITIONAL
		var etag = conditional.etagFor( fileObj )
		set( "ETag", etag )
		set( "Last-Modified", conditional.lastModifiedHeader( fileObj ) )
		if ( !isNull( options.maxAge ) ) {
			set( "Cache-Control", "public, max-age=" & options.maxAge )
		}

		var ifNoneMatch = variables.exchangeAdapter.getRequestHeader( "If-None-Match" )
		var ifModifiedSince = variables.exchangeAdapter.getRequestHeader( "If-Modified-Since" )
		if ( conditional.isNotModified( ifNoneMatch, ifModifiedSince, etag, fileObj, variables.exchangeAdapter.getRequestHeader( "Cache-Control" ) ) ) {
			return status( 304 ).end()
		}

		var contentType = options.contentType ?: _guessMimeType( fileObj.getName() )

		if ( options.download ?: false ) {
			var downloadName = !isNull( options.filename ) ? options.filename : fileObj.getName()
			set( "Content-Disposition", 'attachment; filename="#_sanitizeHeaderToken( downloadName )#"' )
		}

		return sendFileRange( fileObj, contentType )
	}

	/**
	 * Sends a file from disk, honoring a Range request header (RFC 7233) for
	 * partial content — the shared mechanics behind both sendFile()/download()
	 * and the static-file middleware (StaticFiles.bx calls this directly),
	 * so range-parsing and partial reads live in one place. Always sets
	 * Accept-Ranges, even for a full response, so a client knows it can send
	 * a Range request next time (e.g. to seek a video before it's finished
	 * downloading).
	 *
	 * Scope limits inherited from RangeParser.bx: a request naming more than
	 * one range falls back to a full response instead of a multipart/
	 * byteranges reply, and If-Range isn't supported — a Range request is
	 * always attempted regardless of freshness. Call this after any
	 * conditional-GET (304) check, since a range is meaningless once the
	 * response has already ended.
	 */
	function sendFileRange( fileObj, contentType ) {
		var totalSize = fileObj.length()
		var rangeHeader = variables.exchangeAdapter.getRequestHeader( "Range" )
		var range = new RangeParser().parse( rangeHeader, totalSize )

		type( contentType )
		set( "Accept-Ranges", "bytes" )

		if ( range.type == "unsatisfiable" ) {
			set( "Content-Range", "bytes */#totalSize#" )
			return status( 416 ).end()
		}

		if ( range.type != "satisfiable" ) {
			return _streamFile( fileObj, 0, totalSize )
		}

		set( "Content-Range", "bytes #range.start#-#range.end#/#totalSize#" )
		status( 206 )
		return _streamFile( fileObj, range.start, range.end - range.start + 1 )
	}

	/**
	 * Sends `length` bytes of the file starting at `start`, copied from disk to
	 * the connection by the JDK (FileChannel.transferTo) rather than read into
	 * memory first — so serving a large file costs a fixed amount of memory
	 * per request, not the file's size, and files over 2 GB work. A HEAD
	 * request gets the headers only, without touching the file's contents.
	 */
	private function _streamFile( fileObj, start, length ) {
		if ( variables.sent ) {
			throw( message = "Response already sent for this request", type = "BoxExpress.ResponseAlreadySent" )
		}
		variables.sent = true
		for ( var callback in variables.beforeSendCallbacks ) {
			callback()
		}
		variables.bytesWritten = length

		if ( length == 0 ) {
			variables.exchangeAdapter.sendHeadersOnly( variables.statusCode )
			return this
		}
		set( "Content-Length", toString( length ) )
		if ( variables.exchangeAdapter.getMethod() == "HEAD" ) {
			variables.exchangeAdapter.sendHeadersOnly( variables.statusCode )
			return this
		}

		variables.exchangeAdapter.setStatusCode( variables.statusCode )
		var out = variables.exchangeAdapter.getResponseOutputStream()
		var channel = createObject( "java", "java.io.FileInputStream" ).init( fileObj ).getChannel()
		try {
			var target = createObject( "java", "java.nio.channels.Channels" ).newChannel( out )
			var position = start
			var remaining = length
			while ( remaining > 0 ) {
				var sent = channel.transferTo( javacast( "long", position ), javacast( "long", remaining ), target )
				if ( sent <= 0 ) {
					break
				}
				position += sent
				remaining -= sent
			}
		} finally {
			channel.close()
			out.close()
		}
		return this
	}

	private function _sanitizeHeaderToken( value ) {
		return reReplace( value, "[""\r\n\x00-\x1F]", "", "all" )
	}

	/**
	 * Force-download variant of sendFile() — always sets Content-Disposition: attachment,
	 * defaulting the downloaded filename to the source file's own name.
	 */
	function download( filePath, filename ) {
		var options = { download: true }
		if ( !isNull( filename ) ) {
			options.filename = filename
		}
		return sendFile( filePath, options )
	}

	private function _guessMimeType( fileName ) {
		var known = new MimeTypes().forExtension( listLast( fileName, "." ) )
		return len( known ) ? known : "application/octet-stream"
	}

	/**
	 * Render a view from the configured views directory (app.set("views", dir)) and
	 * send it as the response body. Views are native BoxLang templates (.bxm, run
	 * via include + savecontent); `data` is available inside one as the `data`
	 * struct, and interpolation needs a <bx:output> block, same as classic CFML
	 * <cfoutput>. A view with no extension gets ".bxm" appended.
	 *
	 * `data` is merged with `app.locals` and `res.locals` before it reaches the
	 * template — app.locals first, res.locals next (overriding app.locals), then
	 * `data` last (overriding both) — same precedence Express uses, so values a
	 * route doesn't set explicitly (site name, a per-request user, etc.) don't
	 * have to be threaded through every render() call.
	 */
	function render( view, data = {} ) {
		// app.locals < res.locals < the data passed here, each overriding the last —
		// same precedence as Express.
		var mergedData = {}
		mergedData.append( variables.appLocals )
		mergedData.append( this.locals )
		mergedData.append( data )

		var output = _renderToString( view, mergedData )

		// The view has run by now, so anything it set on `data` (a page
		// title, extra scripts) is there for the layout to read.
		// data.layout: a view name picks a layout for this render, false
		// turns the app's default off.
		var layout = variables.settings[ "view layout" ] ?: ""
		var requested = mergedData.layout ?: true
		if ( isSimpleValue( requested ) ) {
			if ( !isBoolean( requested ) ) {
				layout = requested
			} else if ( !requested ) {
				layout = ""
			}
		}
		if ( len( layout ) ) {
			mergedData.body = output
			output = _renderToString( layout, mergedData )
		}

		type( "text/html; charset=utf-8" )
		return _end( output.getBytes( "UTF-8" ) )
	}

	/**
	 * Renders another view and returns its HTML, for use inside a view or
	 * layout: #partial( "partials/nav" )#. It sees the same `data` as the
	 * view calling it, plus anything passed here.
	 */
	function partial( view, data = {} ) {
		var partialData = {}
		partialData.append( variables.renderData ?: {} )
		partialData.append( data )
		return _renderToString( view, partialData )
	}

	/**
	 * Runs one .bxm file from the views directory and returns its output.
	 * The parameter has to be called `data`: the include below shares this
	 * function's scope, and that's the name templates read.
	 */
	private function _renderToString( view, data ) {
		var viewsDir = variables.settings[ "views" ] ?: javacast( "null", "" )
		if ( isNull( viewsDir ) ) {
			throw(
				message = "No views directory configured — call app.set( ""views"", expandPath( ""./views"" ) ) before using res.render()",
				type = "BoxExpress.NoViewsDir"
			)
		}

		var viewFile = view
		if ( lCase( viewFile.right( 4 ) ) == ".hbs" || lCase( variables.settings[ "view engine" ] ?: "bxm" ) == "hbs" ) {
			throw(
				message = "Handlebars (.hbs) views were removed in 0.2.20 — convert the view to .bxm",
				type = "BoxExpress.UnsupportedViewEngine"
			)
		}
		if ( lCase( viewFile.right( 4 ) ) != ".bxm" ) {
			viewFile &= ".bxm"
		}

		var viewsRoot = createObject( "java", "java.io.File" ).init( viewsDir ).getCanonicalFile().toPath()
		var candidate = viewsRoot.resolve( viewFile ).normalize()
		var realCandidate = ""
		var realRoot = ""

		try {
			realCandidate = candidate.toRealPath()
			realRoot = viewsRoot.toRealPath()
		} catch ( any e ) {
			throw( message = "View not found: #view#", type = "BoxExpress.ViewNotFound" )
		}

		if ( !realCandidate.startsWith( realRoot ) ) {
			throw( message = "Invalid view path: #view#", type = "BoxExpress.InvalidViewPath" )
		}

		var templatePath = realCandidate.toString()
		var output = ""
		// What partial() merges its own data over. Saved and restored so a
		// partial's data doesn't leak back into the view that called it.
		var outerRenderData = variables.renderData ?: {}
		variables.renderData = data

		try {
			bx:savecontent variable="output" {
				include "#templatePath#"
			}
		} finally {
			variables.renderData = outerRenderData
		}

		return output
	}

	/**
	 * Sends BoxLang's rich HTML dump() view of a variable as the response —
	 * dump( format = "html" ) only ever writes to the process console under
	 * BoxExpress's CLI-based HttpServer (there's no per-request page buffer for
	 * it to land in, even inside res.render()'s bx:savecontent), so this
	 * round-trips the markup through a temp file to get it into the response
	 * body instead.
	 */
	function dump( data ) {
		var tmpFile = getTempDirectory() & "boxexpress-dump-" & createUUID() & ".html"
		dump( var = data, format = "html", output = tmpFile )
		var dumpHtml = fileRead( tmpFile )
		fileDelete( tmpFile )

		type( "text/html; charset=utf-8" )
		return _end( dumpHtml.getBytes( "UTF-8" ) )
	}

	/**
	 * Server-Sent Events. Bypasses the normal buffered send entirely — every
	 * other terminal method builds one byte array and funnels through _end()
	 * for a single write, but an SSE response stays open and writes
	 * incrementally as callback calls emitter.send(). callback receives an
	 * SseEmitter (send/comment/close/isClosed()) and is expected to close()
	 * it when done; sse() also closes it in a finally, so a callback that
	 * throws or just returns without calling close() itself still ends the
	 * stream cleanly rather than leaking an open connection.
	 *
	 * Sets Content-Type/Cache-Control/Connection plus X-Accel-Buffering: no,
	 * the header that stops a reverse proxy (nginx, Cloudflare) from
	 * buffering the stream and defeating the whole point of it — same
	 * header BoxLang's own SSE() BIF sets, though that BIF itself isn't
	 * usable here: it lives in the boxlang-web-support runtime module
	 * (MiniServer/CommandBox/servlet deployments), which BoxExpress doesn't
	 * load — confirmed directly that calling SSE() from a route handler
	 * throws "Function [SSE] not found".
	 */
	function sse( callback ) {
		if ( variables.sent ) {
			throw( message = "Response already sent for this request", type = "BoxExpress.ResponseAlreadySent" )
		}
		variables.sent = true

		for ( var beforeSendCallback in variables.beforeSendCallbacks ) {
			beforeSendCallback()
		}

		variables.exchangeAdapter.setStatusCode( variables.statusCode )
		set( "Content-Type", "text/event-stream" )
		set( "Cache-Control", "no-cache" )
		set( "Connection", "keep-alive" )
		set( "X-Accel-Buffering", "no" )

		var outStream = variables.exchangeAdapter.getResponseOutputStream()
		var emitter = new SseEmitter( outStream )

		try {
			callback( emitter )
		} finally {
			emitter.close()
		}

		return this
	}

	/**
	 * Marks the response as taken over by a WebSocket handshake, running
	 * the before-send callbacks first — the handshake writes its own 101,
	 * so nothing else would run them.
	 */
	function _beginUpgrade() {
		if ( variables.sent ) {
			throw( message = "Response already sent for this request", type = "BoxExpress.ResponseAlreadySent" )
		}
		variables.sent = true
		for ( var callback in variables.beforeSendCallbacks ) {
			callback()
		}
		return this
	}

	private function _end( bodyBytes, encoding = "utf-8" ) {
		if ( variables.sent ) {
			throw( message = "Response already sent for this request", type = "BoxExpress.ResponseAlreadySent" )
		}
		variables.sent = true

		for ( var callback in variables.beforeSendCallbacks ) {
			callback()
		}

		// A HEAD response must never have a body, even though every handler
		// above this (res.json(), res.sendFile(), etc.) still built one the
		// normal way — HEAD reuses the same GET route/handler and just has its
		// body thrown away here. Content-Length is set explicitly first so a
		// HEAD response still reports the size a GET would have sent; the
		// adapter's sendHeadersOnly() then tells the underlying engine not to
		// expect (or wait for) an actual body write.
		var method = variables.exchangeAdapter.getMethod()
		var isHead = method == "HEAD"

		if ( method == "GET" || isHead ) {
			var conditional = static.CONDITIONAL
			var isSuccess = variables.statusCode >= 200 && variables.statusCode < 300
			if ( isSuccess && bodyBytes.len() && isNull( variables.exchangeAdapter.getHeader( "ETag" ) ) ) {
				var etag = conditional.bodyEtag( variables.settings[ "etag" ] ?: false, bodyBytes, encoding )
				if ( len( etag ) ) {
					set( "ETag", etag )
				}
			}
			if ( conditional.isFresh( variables.exchangeAdapter, variables.statusCode ) ) {
				variables.statusCode = 304
			}
		}
		if ( variables.statusCode == 304 ) {
			variables.exchangeAdapter.removeHeader( "Content-Type" )
			variables.exchangeAdapter.removeHeader( "Content-Length" )
			variables.exchangeAdapter.removeHeader( "Transfer-Encoding" )
			bodyBytes = "".getBytes( "UTF-8" )
		}

		variables.bytesWritten = bodyBytes.len()

		if ( bodyBytes.len() == 0 ) {
			variables.exchangeAdapter.sendHeadersOnly( variables.statusCode )
		} else if ( isHead ) {
			set( "Content-Length", toString( bodyBytes.len() ) )
			variables.exchangeAdapter.sendHeadersOnly( variables.statusCode )
		} else {
			variables.exchangeAdapter.sendBody( variables.statusCode, bodyBytes )
		}

		return this
	}

}
