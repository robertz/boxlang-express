/**
 * Opt-in multipart/form-data parsing middleware, mirroring multer's basic usage.
 * Usage:
 *   multipart = new middleware.Multipart()
 *   app.use( multipart.upload() )                        // in-memory buffers only
 *   app.use( multipart.upload( { dest: expandPath( "./uploads" ) } ) )  // also saved to disk
 *
 * Populates req.body with the non-file fields and req.files with a struct keyed by
 * field name, each value an array of file structs:
 *   { fieldName, filename, contentType, size, buffer, path (only if dest was given) }
 *
 * The client-supplied filename is never used to build a disk path — saved files get
 * a generated name, sidestepping path-traversal/collision entirely.
 */
class {

	function upload( options = {} ) {
		var limit = options.limit ?: 10485760
		var dest = options.dest ?: javacast( "null", "" )

		return function( req, res, next ) {
			var contentType = req.headers[ "Content-Type" ] ?: ""
			if ( !contentType.findNoCase( "multipart/form-data" ) ) {
				return next()
			}

			var boundary = _extractBoundary( contentType )
			if ( isNull( boundary ) ) {
				return next( { message: "Missing multipart boundary", type: "BoxExpress.MultipartError" } )
			}

			var inStream = req.bodyStream()
			var bodyBytes = inStream.readNBytes( limit + 1 )
			if ( bodyBytes.len() > limit ) {
				return res.status( 413 ).json( { error: true, message: "Upload exceeds the #limit#-byte limit" } )
			}

			var parsed = ""
			try {
				parsed = _parseMultipart( bodyBytes, boundary )
			} catch ( any e ) {
				return next( e )
			}

			req.body = parsed.fields

			if ( !isNull( dest ) ) {
				_persistFiles( parsed.files, dest )
			}
			req.files = parsed.files

			next()
		}
	}

	private function _extractBoundary( contentType ) {
		var marker = "boundary="
		var pos = contentType.findNoCase( marker )
		if ( !pos ) {
			return javacast( "null", "" )
		}
		// mid(), not right() — an empty boundary ("...boundary=", nothing after
		// it) makes the count 0, which right() throws on but mid() handles fine.
		var boundaryStart = pos + marker.len()
		var boundary = contentType.mid( boundaryStart, contentType.len() - boundaryStart + 1 )
		boundary = boundary.listFirst( ";" )
		if ( len( boundary ) >= 2 && boundary.left( 1 ) == '"' && boundary.right( 1 ) == '"' ) {
			boundary = boundary.mid( 2, boundary.len() - 2 )
		}
		return boundary
	}

	/**
	 * Locates the parts by searching an ISO-8859-1 view of the body — one char
	 * per byte, so a char index is also a byte index — and then copies each
	 * part's content straight out of the original byte array. That keeps the
	 * work to one search view plus the parts themselves, rather than the
	 * several whole-body copies a split() and per-part substrings made.
	 */
	private function _parseMultipart( bodyBytes, boundary ) {
		// RFC 2046 caps a boundary at 70 characters; an empty one can't delimit
		// anything. Either way there's nothing to parse — same lenient outcome
		// as a body with no parts.
		if ( !len( boundary ) || len( boundary ) > 70 ) {
			return { fields: {}, files: {} }
		}
		var content = createObject( "java", "java.lang.String" ).init( bodyBytes, "ISO-8859-1" )
		var arrays = createObject( "java", "java.util.Arrays" )
		var crlf = char( 13 ) & char( 10 )
		var delimiter = "--" & boundary
		var nextDelimiter = crlf & delimiter

		var fields = {}
		var files = {}

		// regionMatches(), not startsWith( prefix, offset ): the latter doesn't
		// reach Java's two-argument overload from BoxLang and always compares
		// from offset 0.
		var pos = content.indexOf( delimiter )
		while ( pos >= 0 ) {
			var partStart = pos + len( delimiter )
			if ( content.regionMatches( javacast( "int", partStart ), "--", javacast( "int", 0 ), javacast( "int", 2 ) ) ) {
				// the closing delimiter
				break
			}
			if ( content.regionMatches( javacast( "int", partStart ), crlf, javacast( "int", 0 ), javacast( "int", 2 ) ) ) {
				partStart += 2
			}
			var partEnd = content.indexOf( nextDelimiter, javacast( "int", partStart ) )
			if ( partEnd < 0 ) {
				// a truncated body: no closing delimiter for this part
				break
			}
			pos = partEnd + 2

			var headerEnd = content.indexOf( crlf & crlf, javacast( "int", partStart ) )
			if ( headerEnd < 0 || headerEnd > partEnd ) {
				continue
			}
			var headers = _parsePartHeaders( content.substring( javacast( "int", partStart ), javacast( "int", headerEnd ) ) )
			var disposition = headers[ "content-disposition" ] ?: ""
			if ( !len( disposition ) ) {
				continue
			}
			var fieldName = _extractDispositionParam( disposition, "name" )
			var filename = _extractDispositionParam( disposition, "filename" )
			// An empty part body shares its header terminator's last CRLF with
			// the next delimiter, which puts headerEnd + 4 past partEnd.
			var bodyStart = min( headerEnd + 4, partEnd )

			if ( !isNull( filename ) ) {
				if ( !len( filename ) ) {
					continue
				}
				var fileBytes = arrays.copyOfRange( bodyBytes, javacast( "int", bodyStart ), javacast( "int", partEnd ) )
				var fileStruct = {
					fieldName: fieldName,
					filename: filename,
					contentType: headers[ "content-type" ] ?: "application/octet-stream",
					size: fileBytes.len(),
					buffer: fileBytes
				}
				if ( isNull( files[ fieldName ] ) ) {
					files[ fieldName ] = []
				}
				files[ fieldName ].append( fileStruct )
			} else {
				fields[ fieldName ] = createObject( "java", "java.lang.String" ).init( bodyBytes, javacast( "int", bodyStart ), javacast( "int", partEnd - bodyStart ), "UTF-8" )
			}
		}

		return { fields: fields, files: files }
	}

	private function _parsePartHeaders( headerBlock ) {
		var headers = {}
		for ( var line in headerBlock.listToArray( char( 13 ) & char( 10 ) ) ) {
			var colonPos = line.find( ":" )
			if ( colonPos ) {
				// Same zero-count left()/right() guard as Request.bx/BodyParsers.bx —
				// a header with no name (":value") or no value ("Header:") is
				// malformed but shouldn't crash the parser.
				var key = ( colonPos == 1 ? "" : line.left( colonPos - 1 ) ).trim().lcase()
				var value = ( colonPos == line.len() ? "" : line.right( line.len() - colonPos ) ).trim()
				headers[ key ] = value
			}
		}
		return headers
	}

	private function _extractDispositionParam( disposition, paramName ) {
		var marker = paramName & '="'
		var pos = disposition.findNoCase( marker )
		if ( !pos ) {
			return javacast( "null", "" )
		}
		// mid(), not right()/left() — an empty param value (name="", the
		// filename a browser sends for a file input submitted with nothing
		// selected being the common real-world case) makes one of these
		// counts 0, which right()/left() throw on but mid() handles fine.
		var restStart = pos + marker.len()
		var rest = disposition.mid( restStart, disposition.len() - restStart + 1 )
		var endPos = rest.find( '"' )
		if ( !endPos ) {
			return javacast( "null", "" )
		}
		return rest.mid( 1, endPos - 1 )
	}

	private function _persistFiles( files, dest ) {
		var destDir = createObject( "java", "java.io.File" ).init( dest )
		if ( !destDir.exists() ) {
			destDir.mkdirs()
		}
		var destPath = destDir.getCanonicalFile().toPath()

		for ( var fieldName in files ) {
			for ( var fileStruct in files[ fieldName ] ) {
				// The extension comes from the client, so keep it only if it's a
				// plain short alphanumeric one — anything else is dropped rather
				// than written into a filename.
				var ext = listLen( fileStruct.filename, "." ) > 1 ? listLast( fileStruct.filename, "." ) : ""
				ext = reFind( "^[A-Za-z0-9]{1,10}$", ext ) ? "." & lCase( ext ) : ""
				var generatedName = createObject( "java", "java.util.UUID" ).randomUUID().toString() & ext
				var outPath = destPath.resolve( generatedName ).normalize()
				if ( !outPath.getParent().equals( destPath ) ) {
					throw( type = "BoxExpress.MultipartError", message = "Refusing to write an upload outside the destination directory" )
				}
				createObject( "java", "java.nio.file.Files" ).write( outPath, fileStruct.buffer )
				fileStruct.path = outPath.toString()
			}
		}
	}

}
