/**
 * Fixed-window rate-limiting middleware, mirroring the npm
 * `express-rate-limit` package's most commonly used options:
 *   app.use( boxExpressRateLimit() )                                      // 100 req/min per IP
 *   app.use( boxExpressRateLimit( { windowMs: 15 * 60000, max: 20 } ) )   // 20 req/15min
 *
 * Fixed window, not a sliding one or a token bucket: each key gets a
 * counter that resets to 0 the first time it's hit after its window
 * expires, same trade-off most minimal in-memory rate limiters make — a
 * client can get up to 2x `max` requests through right at a window
 * boundary, in exchange for O(1) bookkeeping per request instead of a
 * timestamp log per key.
 *
 * The default key is `req.ip` — same caveat as `req.ip` itself: behind a
 * reverse proxy without `app.set("trust proxy", true)`, every request
 * shares the proxy's own IP as the key, effectively rate-limiting the
 * whole app together rather than per client. Pass `{ keyGenerator: (req)
 * => ... }` to key on something else (an API key, `req.session.userId`,
 * etc).
 *
 * A limited request gets `message` as JSON. Pass `{ handler: ( req, res,
 * next, info ) => ... }` to answer it yourself — the status and
 * Retry-After are already set — e.g. to render an HTML page.
 *
* The default store is in-memory on this instance (so it doesn't survive a
* restart and isn't shared across processes) — same trade-off as
* Session.bx's default MemoryStore, for the same reason: fine for a
* single-process app, not for a cluster. For a cluster, pass
* { cache: "name" } (a registered BoxLang cache — see CacheRateLimitStore.bx,
* which also covers what happens when that cache isn't durable or goes
* away) or { store: myStore } for your own.
 */
class {

	function init() {
		variables.OVERFLOW_KEY = "boxexpress:overflow"
		variables.entries = createObject( "java", "java.util.concurrent.ConcurrentHashMap" ).init()
		variables.hitsSinceSweep = 0
		variables.lastFullSweepMs = 0
		variables.lastFullWarningMs = 0
		return this
	}

	function limit( options = {} ) {
		var windowMs = options.windowMs ?: 60000
		var maxRequests = options.max ?: 100
		var statusCode = options.statusCode ?: 429
		var message = options.message ?: { error: true, message: "Too many requests, please try again later." }
		var standardHeaders = options.standardHeaders ?: true
		var keyGenerator = options.keyGenerator ?: ( ( req ) => req.ip )
		// Only bounds the built-in in-memory store: once this many keys are
		// being counted, a key not already among them is counted in one shared
		// bucket, so a flood of distinct keys can't grow memory without limit
		// and can't dodge the limit either. 0 turns the cap off.
		var maxKeys = options.maxKeys ?: 100000
		if ( !isSimpleValue( maxKeys ) || !isNumeric( maxKeys ) || maxKeys < 0 || maxKeys != int( maxKeys ) ) {
			throw( type = "BoxExpress.InvalidArgument", message = "boxExpressRateLimit: maxKeys must be a whole number, 0 or more" )
		}
		// ( req, res, next, info ) => ... answers a limited request in place
		// of the JSON `message`. "" for "none" — see StompMessage.bx's init().
		var limitHandler = options.handler ?: ""
		var useHandler = structKeyExists( options, "handler" ) && !isNull( options.handler )
		if ( useHandler && !( isCustomFunction( limitHandler ) || isClosure( limitHandler ) ) ) {
			throw( type = "BoxExpress.InvalidArgument", message = "boxExpressRateLimit: handler must be a function ( req, res, next, info )" )
		}

		// options.store (anything with hit( key, windowMs ) -> { count, resetAt })
		// or options.cache (a named BoxLang cache) share the count across
		// instances; without either, counts live in this process. "" rather than
		// null for "none" — see StompMessage.bx's init() on why.
		var sharedStore = options.store ?: ""
		if ( isSimpleValue( sharedStore ) && len( options.cache ?: "" ) ) {
		sharedStore = new "../stores/CacheRateLimitStore"( options.cache, {
		fallback: options.fallback ?: true,
		requireDurable: options.requireDurable ?: false
		} )
		}
		var useSharedStore = !isSimpleValue( sharedStore )

		return function( req, res, next ) {
			var key = keyGenerator( req )
			var entry = useSharedStore ? sharedStore.hit( key, windowMs ) : _hit( key, windowMs, maxKeys )
			var remaining = max( 0, maxRequests - entry.count )
			var resetSeconds = int( ( entry.resetAt - _now() ) / 1000 )

			if ( standardHeaders ) {
				res.set( "RateLimit-Limit", toString( maxRequests ) )
				res.set( "RateLimit-Remaining", toString( remaining ) )
				res.set( "RateLimit-Reset", toString( resetSeconds ) )
			}

			if ( entry.count > maxRequests ) {
				if ( standardHeaders ) {
					res.set( "Retry-After", toString( resetSeconds ) )
				}
				res.status( statusCode )
				if ( useHandler ) {
					return limitHandler( req, res, next, { limit: maxRequests, remaining: remaining, resetSeconds: resetSeconds, key: key } )
				}
				return res.json( message )
			}

			next()
		}
	}

	private function _hit( key, windowMs, maxKeys = 0 ) {
		var now = _now()
		if ( maxKeys > 0 && variables.entries.size() >= maxKeys && !variables.entries.containsKey( key ) ) {
			// Expired keys may be all that's filling it — but don't rescan
			// more than once a second while it stays full.
			if ( now - variables.lastFullSweepMs >= 1000 ) {
				variables.lastFullSweepMs = now
				_sweep( now )
			}
			if ( variables.entries.size() >= maxKeys ) {
				if ( now - variables.lastFullWarningMs > 60000 ) {
					variables.lastFullWarningMs = now
					println( "[BoxExpress] rate limiter is tracking its maximum of #maxKeys# keys — new keys share one counter until some expire. Raise maxKeys, or use a cache-backed store." )
				}
				key = variables.OVERFLOW_KEY
			}
		}
		// compute() runs atomically per key — a separate get() and put() let
		// concurrent requests read the same count and each write back count + 1.
		var entry = variables.entries.compute( key, ( mapKey, current ) => {
			if ( isNull( current ) || current.resetAt <= now ) {
				return { count: 1, resetAt: now + windowMs }
			}
			return { count: current.count + 1, resetAt: current.resetAt }
		} )

		// Cheap amortized cleanup instead of a background thread — same
		// approach as Session.bx's sweep, just on a hit-count trigger.
		variables.hitsSinceSweep++
		if ( variables.hitsSinceSweep >= 1000 ) {
			variables.hitsSinceSweep = 0
			_sweep( now )
		}

		return entry
	}

	private function _now() {
		return createObject( "java", "java.lang.System" ).currentTimeMillis()
	}

	private function _sweep( now ) {
		for ( var key in variables.entries.keySet().toArray() ) {
			var entry = variables.entries.get( key )
			if ( !isNull( entry ) && entry.resetAt <= now ) {
				variables.entries.remove( key )
			}
		}
	}

}
