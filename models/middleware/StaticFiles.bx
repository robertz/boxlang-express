/**
 * Static file serving middleware, mirroring express.static().
 * Usage:
 *   staticFiles = new middleware.StaticFiles()
 *   app.use( "/public", staticFiles.serve( "./public" ) )
 *   app.use( "/public", staticFiles.serve( "./public", { maxAge: 86400 } ) )  // Cache-Control, 1 day
 */
class {

	function serve( rootDir, options = {} ) {
		var rootPath = createObject( "java", "java.io.File" ).init( rootDir ).getCanonicalFile().toPath()
		var realRootPath = rootPath.toRealPath()
		var indexFile = options.index ?: "index.html"
		var maxAge = options.maxAge ?: javacast( "null", "" )
		// "ignore" (default): a path with any segment starting with "." falls
		// through to next(), as if the file weren't there — so a stray .env or
		// .git/ in the public directory isn't served. "deny" answers 403
		// instead; "allow" serves them. /.well-known/ is always allowed, since
		// ACME challenges and similar standards live there.
		var dotfiles = lCase( options.dotfiles ?: "ignore" )
		if ( !listFind( "ignore,deny,allow", dotfiles ) ) {
			throw( type = "BoxExpress.InvalidOption", message = "boxExpressStatic dotfiles must be ""ignore"", ""deny"" or ""allow"", not ""#dotfiles#""" )
		}
		var conditional = new "../ConditionalGet"()
		var mimeTypes = {
			html: "text/html; charset=utf-8", htm: "text/html; charset=utf-8",
			css: "text/css; charset=utf-8", js: "text/javascript; charset=utf-8",
			mjs: "text/javascript; charset=utf-8", map: "application/json; charset=utf-8",
			json: "application/json; charset=utf-8", txt: "text/plain; charset=utf-8",
			xml: "application/xml; charset=utf-8", webmanifest: "application/manifest+json",
			png: "image/png", jpg: "image/jpeg", jpeg: "image/jpeg", gif: "image/gif",
			svg: "image/svg+xml", ico: "image/x-icon", webp: "image/webp", avif: "image/avif",
			woff: "font/woff", woff2: "font/woff2", ttf: "font/ttf", otf: "font/otf",
			wasm: "application/wasm", pdf: "application/pdf",
			mp4: "video/mp4", webm: "video/webm", mp3: "audio/mpeg", ogg: "audio/ogg"
		}

		return function( req, res, next ) {
			if ( req.method != "GET" && req.method != "HEAD" ) {
				return next()
			}

			var relativePath = req.path.left( 1 ) == "/" ? req.path.mid( 2, req.path.len() - 1 ) : req.path

			if ( dotfiles != "allow" && _hasDotSegment( relativePath ) ) {
				return dotfiles == "deny" ? res.sendStatus( 403 ) : next()
			}

			// Mirror express.static(): a request for a directory *without* the
			// trailing slash (e.g. "/games/void-harvest") gets redirected to the
			// slash-suffixed URL rather than 404ing — the slash version is the
			// canonical one, since relative asset links inside the served HTML
			// resolve against it correctly and wouldn't against the bare path.
			if ( len( relativePath ) && relativePath.right( 1 ) != "/" ) {
				var dirCandidate = rootPath.resolve( relativePath ).normalize()
				if ( dirCandidate.startsWith( rootPath ) && dirCandidate.toFile().isDirectory() ) {
					// req.path may have already had a mount prefix (e.g. "/public")
					// stripped by Router.bx by the time this middleware runs — the
					// redirect target needs the *original*, still-prefixed URL, which
					// only req.originalUrl (captured once at request construction,
					// never mutated by mount-prefix stripping) still has.
					var qIndex = req.originalUrl.find( "?" )
					var pathPart = qIndex ? req.originalUrl.left( qIndex - 1 ) : req.originalUrl
					var queryPart = qIndex ? req.originalUrl.mid( qIndex, req.originalUrl.len() - qIndex + 1 ) : ""
					return res.redirect( pathPart & "/" & queryPart, 301 )
				}
			}

			if ( !len( relativePath ) || relativePath.right( 1 ) == "/" ) {
				relativePath &= indexFile
			}

			var candidate = rootPath.resolve( relativePath ).normalize()

			if ( !candidate.startsWith( rootPath ) ) {
				return next()
			}

			var fileObj = candidate.toFile()
			if ( !fileObj.exists() || !fileObj.isFile() ) {
				return next()
			}

			// Re-check containment against the *real* (symlink-resolved) paths — normalize()
			// above is purely lexical and won't catch a symlink inside rootDir that points
			// outside it.
			var realCandidate = candidate.toRealPath()
			if ( !realCandidate.startsWith( realRootPath ) ) {
				return next()
			}

			var etag = conditional.etagFor( fileObj )
			res.set( "ETag", etag )
			res.set( "Last-Modified", conditional.lastModifiedHeader( fileObj ) )
			if ( !isNull( maxAge ) ) {
				res.set( "Cache-Control", "public, max-age=" & maxAge )
			}

			if ( conditional.isNotModified( req.headers[ "If-None-Match" ] ?: "", req.headers[ "If-Modified-Since" ] ?: "", etag, fileObj ) ) {
				return res.status( 304 ).end()
			}

			var ext = listLast( fileObj.getName(), "." ).lcase()
			var contentType = mimeTypes[ ext ] ?: "application/octet-stream"

			res.sendFileRange( fileObj, contentType )
		}
	}

	private function _hasDotSegment( relativePath ) {
		var segments = relativePath.listToArray( "/\" )
			for ( var i = 1; i <= segments.len(); i++ ) {
				if ( left( segments[ i ], 1 ) == "." && !( i == 1 && segments[ i ] == ".well-known" ) ) {
					return true
				}
			}
			return false
		}

	}
