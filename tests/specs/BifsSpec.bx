/**
 * Exercises the global BIFs (boxExpress, boxExpressJSON, boxExpressUrlencoded,
 * boxExpressStatic, boxExpressUpload, boxExpressSession) for real — a running
 * server built entirely through the BIFs,
 * not the bxModules.boxexpress.models.* classes directly. These only resolve as
 * global functions once BoxLang has loaded this project as an actual module, which
 * run-tests.bxs sets up via a self-referencing boxlang_modules/boxexpress symlink.
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		variables.testPort = 4322
		variables.baseUrl = "http://localhost:#variables.testPort#"
		variables.client = new "../helpers/HttpClient"()

		variables.uploadDest = expandPath( "tests/fixtures/bif-uploads" )

		variables.app = boxExpress()
		variables.app.use( boxExpressJSON() )
		variables.app.use( boxExpressUrlencoded() )
		variables.app.use( "/public", boxExpressStatic( expandPath( "tests/fixtures/public" ) ) )
		variables.app.use( boxExpressSession() )

		variables.app.get( "/", ( req, res ) => {
			res.send( "Hello via BIFs!" )
		} )

		variables.app.get( "/session-count", ( req, res ) => {
			req.session.views = ( req.session.views ?: 0 ) + 1
			res.json( { views: req.session.views } )
		} )

		variables.app.post( "/echo", ( req, res ) => {
			res.json( { youSent: req.body } )
		} )

		variables.app.get( "/download", ( req, res ) => {
			res.download( expandPath( "tests/fixtures/public/hello.txt" ) )
		} )

		variables.app.post( "/upload", boxExpressUpload( { dest: variables.uploadDest } ), ( req, res ) => {
			res.json( { files: req.files } )
		} )

		variables.app.listen( port = variables.testPort, options = { block: false } )
		sleep( 300 )
	}

	function afterAll() {
		variables.app.close()
		if ( directoryExists( variables.uploadDest ) ) {
			directoryDelete( variables.uploadDest, true )
		}
	}

	function run() {
		describe( "BoxExpress global BIFs", function() {

			it( "boxExpress() returns a working app", function() {
				var result = variables.client.get( variables.baseUrl & "/" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toBe( "Hello via BIFs!" )
			} )

			it( "boxExpressJSON() parses application/json bodies", function() {
				var result = variables.client.post( variables.baseUrl & "/echo", '{"a":1}', "application/json" )
				expect( JSONDeserialize( result.body ).youSent.a ).toBe( 1 )
			} )

			it( "boxExpressUrlencoded() parses form bodies", function() {
				var result = variables.client.post( variables.baseUrl & "/echo", "x=1&y=2", "application/x-www-form-urlencoded" )
				expect( JSONDeserialize( result.body ).youSent.x ).toBe( "1" )
			} )

			it( "boxExpressStatic() serves files", function() {
				var result = variables.client.get( variables.baseUrl & "/public/hello.txt" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toInclude( "static fixture" )
			} )

			it( "res.download() sends an attachment", function() {
				var result = variables.client.get( variables.baseUrl & "/download" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.contentDisposition ).toInclude( "attachment;" )
			} )

			it( "boxExpressSession() persists session data across requests via the session cookie", function() {
				var first = variables.client.get( variables.baseUrl & "/session-count" )
				expect( JSONDeserialize( first.body ).views ).toBe( 1 )

				var sessionCookie = listFirst( first.setCookie, ";" )
				var second = variables.client.getWithHeaders( variables.baseUrl & "/session-count", { "Cookie": sessionCookie } )
				expect( JSONDeserialize( second.body ).views ).toBe( 2 )
			} )

			it( "boxExpressUpload() parses a multipart upload", function() {
				var result = variables.client.postMultipart(
					variables.baseUrl & "/upload",
					{},
					[ { field: "doc", filename: "doc.txt", contentType: "text/plain", content: "via bif" } ]
				)
				expect( result.statusCode ).toBe( 200 )
				var parsed = JSONDeserialize( result.body )
				expect( parsed.files.doc[ 1 ].filename ).toBe( "doc.txt" )
				expect( fileRead( parsed.files.doc[ 1 ].path ) ).toBe( "via bif" )
			} )

		} )
	}

}
