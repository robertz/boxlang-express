/**
 * Phase 4 of the Undertow-adapter plan: app.set("server.engine", "jdk" |
 * "undertow") selects the HttpServerAdapter at listen() time. Covers the
 * config-driven path specifically — the adapters' own behavior (parity,
 * body reading, etc.) is covered by UndertowAdapterSpec.bx and the rest of
 * the suite running against the JDK default.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( 'app.set("server.engine", ...)', function() {

			it( "defaults to the JDK adapter when server.engine is never set", function() {
				var port = 4801
				var app = new "../../models/BoxExpress"()
				app.get( "/", ( req, res ) => res.send( "jdk-default" ) )
				app.listen( port = port, options = { block: false } )

				try {
					expect( _get( port ) ).toBe( "jdk-default" )
				} finally {
					app.close()
				}
			} )

			it( 'uses the Undertow adapter when server.engine is set to "undertow"', function() {
				var port = 4802
				var app = new "../../models/BoxExpress"()
				app.set( "server.engine", "undertow" )
				app.get( "/", ( req, res ) => res.send( "undertow-via-config" ) )
				app.listen( port = port, options = { block: false } )

				try {
					expect( _get( port ) ).toBe( "undertow-via-config" )
				} finally {
					app.close()
				}
			} )

			it( "an explicit constructor-injected adapter wins over server.engine", function() {
				var port = 4803
				var app = new "../../models/BoxExpress"( new "../../models/adapters/UndertowHttpServerAdapter"() )
				app.set( "server.engine", "jdk" )   // should be ignored — constructor already decided
				app.get( "/", ( req, res ) => res.send( "constructor-wins" ) )
				app.listen( port = port, options = { block: false } )

				try {
					expect( _get( port ) ).toBe( "constructor-wins" )
				} finally {
					app.close()
				}
			} )

			it( "throws BoxExpress.UnknownServerEngine immediately for an unrecognized engine name", function() {
				var app = new "../../models/BoxExpress"()
				app.set( "server.engine", "nonsense" )
				app.get( "/", ( req, res ) => res.send( "should never bind" ) )

				expect( function() {
					app.listen( port = 4804, options = { block: false } )
				} ).toThrow( "BoxExpress.UnknownServerEngine" )
			} )

			it( "PortInUse detection works across engines — a JDK server holding the port blocks an Undertow one", function() {
				// Testing the Undertow adapter's own start() directly, not
				// app.listen() — same reason as UndertowAdapterSpec's
				// equivalent test: listen() catches this error type and
				// calls System.exit(1), which would kill the test runner
				// itself if triggered in-process.
				var port = 4805
				var jdkApp = new "../../models/BoxExpress"()
				jdkApp.get( "/", ( req, res ) => res.send( "jdk holds this port" ) )
				jdkApp.listen( port = port, options = { block: false } )

				try {
					var undertowAdapter = new "../../models/adapters/UndertowHttpServerAdapter"()
					var noopBridge = new "../../models/HttpBridge"( new "../../models/Router"( {} ), {}, {} )

					expect( function() {
						undertowAdapter.start( port, 1024, noopBridge )
					} ).toThrow( "BoxExpress.PortInUse" )
				} finally {
					jdkApp.close()
				}
			} )

		} )
	}

	private function _get( targetPort ) {
		var httpClient = createObject( "java", "java.net.http.HttpClient" ).newHttpClient()
		var req = createObject( "java", "java.net.http.HttpRequest" ).newBuilder()
			.uri( createObject( "java", "java.net.URI" ).init( "http://localhost:#targetPort#/" ) )
			.GET()
			.build()
		var response = httpClient.send( req, createObject( "java", "java.net.http.HttpResponse$BodyHandlers" ).ofString() )
		return response.body()
	}

}
