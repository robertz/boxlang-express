/**
 * Unit tests for CacheStore — the Session-compatible store adapter backed by
 * BoxLang's own cache() service. Runs against the "default" cache, which
 * exists in every BoxLang environment with no extra config (unlike a
 * JDBCStore-backed cache, which needs a registered datasource) — see
 * README.md for the JDBCStore wiring, verified manually there.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "CacheStore", function() {

			it( 'defaults to the "default" cache when no name is given', function() {
				var store = new "../../models/stores/CacheStore"()
				var id = "cachestore-test-#createUUID()#"
				store.set( id, { views: 1 }, 60 )

				expect( cache( "default" ).get( id ).isPresent() ).toBeTrue()
				store.destroy( id )
			} )

			it( "round-trips data through set()/get()", function() {
				var store = new "../../models/stores/CacheStore"( "default" )
				var id = "cachestore-test-#createUUID()#"
				store.set( id, { views: 3, name: "ada" }, 60 )

				var data = store.get( id )
				expect( data.views ).toBe( 3 )
				expect( data.name ).toBe( "ada" )
				store.destroy( id )
			} )

			it( "returns null for an id that was never set", function() {
				var store = new "../../models/stores/CacheStore"( "default" )
				expect( isNull( store.get( "cachestore-never-set-#createUUID()#" ) ) ).toBeTrue()
			} )

			it( "expires an entry after its maxAge", function() {
				var store = new "../../models/stores/CacheStore"( "default" )
				var id = "cachestore-test-#createUUID()#"
				store.set( id, { views: 1 }, 1 )
				expect( isNull( store.get( id ) ) ).toBeFalse()

				sleep( 1500 )
				expect( isNull( store.get( id ) ) ).toBeTrue()
			} )

			it( "removes an entry on destroy()", function() {
				var store = new "../../models/stores/CacheStore"( "default" )
				var id = "cachestore-test-#createUUID()#"
				store.set( id, { views: 1 }, 60 )
				store.destroy( id )

				expect( isNull( store.get( id ) ) ).toBeTrue()
			} )

			it( "throws when the named cache doesn't exist", function() {
				var store = new "../../models/stores/CacheStore"( "not-a-real-cache" )
				expect( function() {
					store.set( "x", {}, 60 )
				} ).toThrow()
			} )

			it( "works as Session's store option end-to-end", function() {
				var store = new "../../models/stores/CacheStore"( "default" )
				var handler = new "../../models/middleware/Session"().session( { store: store } )

				var req1 = { cookies: {} }
				handler( req1, _fakeRes(), function() {} )
				req1.session.views = 1

				// Same store, simulating a second request presenting the
				// sessionID cookie the first response set.
				var req2 = { cookies: { "connect.sid": req1.sessionID } }
				handler( req2, _fakeRes(), function() {} )

				expect( req2.session.views ).toBe( 1 )

				req1.destroySession()
			} )

			it( "persists a mutation made *during* the request (inside next()), not just before it, against a store that doesn't share object references", function() {
				// BoxLang's in-memory "default" cache may well hold the same
				// struct reference it was given, which would make this pass
				// even with the bug this guards against (Session.bx used to
				// call store.set() *before* next(), so anything the request
				// mutated on req.session afterwards — a CSRF token, a login
				// setting the user — was silently lost the moment the store
				// actually serializes on write, e.g. a JDBCStore-backed cache
				// or Redis). This store double duplicates on both set() and
				// get(), the same as any real out-of-process store would, so
				// the test can't accidentally pass via reference-sharing.
				var entries = {}
				var store = {
					get: function( id ) { return structKeyExists( entries, id ) ? duplicate( entries[ id ] ) : javacast( "null", "" ) },
					set: function( id, data, maxAge ) { entries[ id ] = duplicate( data ) },
					destroy: function( id ) { structDelete( entries, id ) }
				}
				var handler = new "../../models/middleware/Session"().session( { store: store } )

				var req1 = { cookies: {} }
				handler( req1, _fakeRes(), function() { req1.session.views = 1 } )

				var req2 = { cookies: { "connect.sid": req1.sessionID } }
				handler( req2, _fakeRes(), function() {} )

				expect( req2.session.views ).toBe( 1 )
			} )

		} )
	}

	private function _fakeRes() {
		var res = {}
		res.cookie = function( name, value, options = {} ) { return res }
		// Simulates a response actually being sent right away — good enough
		// for these tests, which exercise Session's store behavior, not its
		// cookie timing (see BoxExpressIntegrationSpec for that, against a
		// real Response and real HTTP requests).
		res.onBeforeSend = function( callback ) { callback() }
		return res
	}

}
