/**
 * Unit tests for CacheStore — the Session-compatible store adapter backed by
 * BoxLang's own cache() service. Runs against the "default" cache, which
 * exists in every BoxLang environment with no extra config (unlike a
 * JDBCStore-backed cache, which needs a registered datasource) — see
 * README.md for the JDBCStore wiring, verified manually there.
 */
class extends="testbox.system.BaseSpec" {

	function run() {
		describe( "CacheStore", function() {

			it( 'defaults to the "default" cache when no name is given', function() {
				var store = new "../../models/stores/CacheStore"()
				var id = "cachestore-test-#createUUID()#"
				store.set( id, { views: 1 }, 60 )

				expect( cache( "default" ).get( id ).isPresent() ).toBeTrue()
				store.destroy( id )
			} )

			it( "round-trips data through set()/get()", function() {
				var store = new "../../models/stores/CacheStore"( "default" )
				var id = "cachestore-test-#createUUID()#"
				store.set( id, { views: 3, name: "ada" }, 60 )

				var data = store.get( id )
				expect( data.views ).toBe( 3 )
				expect( data.name ).toBe( "ada" )
				store.destroy( id )
			} )

			it( "returns null for an id that was never set", function() {
				var store = new "../../models/stores/CacheStore"( "default" )
				expect( isNull( store.get( "cachestore-never-set-#createUUID()#" ) ) ).toBeTrue()
			} )

			it( "expires an entry after its maxAge", function() {
				var store = new "../../models/stores/CacheStore"( "default" )
				var id = "cachestore-test-#createUUID()#"
				store.set( id, { views: 1 }, 1 )
				expect( isNull( store.get( id ) ) ).toBeFalse()

				sleep( 1500 )
				expect( isNull( store.get( id ) ) ).toBeTrue()
			} )

			it( "removes an entry on destroy()", function() {
				var store = new "../../models/stores/CacheStore"( "default" )
				var id = "cachestore-test-#createUUID()#"
				store.set( id, { views: 1 }, 60 )
				store.destroy( id )

				expect( isNull( store.get( id ) ) ).toBeTrue()
			} )

			it( "falls back to per-process memory when the named cache doesn't exist", function() {
				var store = new "../../models/stores/CacheStore"( "not-a-real-cache" )
				store.set( "x", { views: 2 }, 60 )

				assertAll( [
					() => expect( store.getMode() ).toBe( "local" ),
					() => expect( store.isDurable() ).toBeFalse(),
					() => expect( store.get( "x" ).views ).toBe( 2 )
				] )
				store.destroy( "x" )
				expect( isNull( store.get( "x" ) ) ).toBeTrue()
			} )

			it( "still expires entries in the fallback", function() {
				var store = new "../../models/stores/CacheStore"( "not-a-real-cache" )
				store.set( "x", { v: 1 }, 1 )
				expect( isNull( store.get( "x" ) ) ).toBeFalse()
				sleep( 1300 )
				expect( isNull( store.get( "x" ) ) ).toBeTrue()
			} )

			it( "throws at construction for a missing cache when fallback is false", function() {
				expect( function() {
					new "../../models/stores/CacheStore"( "not-a-real-cache", { fallback: false } )
				} ).toThrow( "BoxExpress.CacheStoreError" )
			} )

			it( "throws at construction for a non-durable cache when requireDurable is true", function() {
				expect( function() {
					new "../../models/stores/CacheStore"( "default", { requireDurable: true } )
				} ).toThrow( "BoxExpress.CacheStoreError" )
			} )

			it( "uses an in-memory cache as-is, reporting it as non-durable", function() {
				var store = new "../../models/stores/CacheStore"( "default" )
				assertAll( [
					() => expect( store.getMode() ).toBe( "cache" ),
					() => expect( store.isDurable() ).toBeFalse()
				] )
			} )

			describe( "with a durable (FileSystemStore) cache", function() {

				beforeEach( function() {
					variables.dir = expandPath( "./tmp-cachestore-spec-" & createUUID() )
					variables.name = "cacheStoreSpec" & createUUID().replace( "-", "", "all" )
					cacheService().createCache( variables.name, "BoxCacheProvider", { objectStore: "FileSystemStore", directory: variables.dir } )
				} )

				afterEach( function() {
					try { cacheService().shutdownCache( variables.name ) } catch ( any e ) {}
					try { directoryDelete( variables.dir, true ) } catch ( any e ) {}
				} )

				it( "is detected as durable and shares entries between two store instances", function() {
					var nodeA = new "../../models/stores/CacheStore"( variables.name )
					var nodeB = new "../../models/stores/CacheStore"( variables.name )
					nodeA.set( "sess1", { user: "ada" }, 60 )

					assertAll( [
						() => expect( nodeA.isDurable() ).toBeTrue(),
						() => expect( nodeA.getMode() ).toBe( "cache" ),
						() => expect( nodeB.get( "sess1" ).user ).withContext( "read by a second instance" ).toBe( "ada" )
					] )

					nodeB.destroy( "sess1" )
					expect( isNull( nodeA.get( "sess1" ) ) ).toBeTrue()
				} )

				it( "accepts requireDurable", function() {
					var store = new "../../models/stores/CacheStore"( variables.name, { requireDurable: true } )
					expect( store.isDurable() ).toBeTrue()
				} )

				it( "degrades to memory when the cache disappears mid-run, and recovers when it returns", function() {
					var store = new "../../models/stores/CacheStore"( variables.name )
					store.set( "before", { n: 1 }, 60 )

					cacheService().shutdownCache( variables.name )
					store.set( "during", { n: 2 }, 60 )
					assertAll( [
						() => expect( store.get( "during" ).n ).withContext( "written while the cache was gone" ).toBe( 2 ),
						() => expect( isNull( store.get( "before" ) ) ).withContext( "the durable entry is unreachable until it returns" ).toBeTrue()
					] )

					cacheService().createCache( variables.name, "BoxCacheProvider", { objectStore: "FileSystemStore", directory: variables.dir } )
					assertAll( [
						() => expect( store.get( "before" ).n ).withContext( "durable entries come back" ).toBe( 1 ),
						() => expect( store.get( "during" ).n ).withContext( "and the outage-time entry is still readable" ).toBe( 2 )
					] )
					store.set( "after", { n: 3 }, 60 )
					expect( cache( variables.name ).get( "after" ).isPresent() ).withContext( "writes reach the cache again" ).toBeTrue()
				} )

				it( "propagates runtime failures when fallback is false", function() {
					var store = new "../../models/stores/CacheStore"( variables.name, { fallback: false } )
					cacheService().shutdownCache( variables.name )
					expect( function() {
						store.set( "x", {}, 60 )
					} ).toThrow()
				} )

			} )

			it( "Session's cache option builds a fallback-safe store, so a missing cache never breaks a request", function() {
				var handler = new "../../models/middleware/Session"().session( { cache: "no-such-cache-" & createUUID() } )

				var req1 = { cookies: {} }
				handler( req1, _fakeRes(), function() {} )
				req1.session.views = 1
				var req2 = { cookies: { "connect.sid": req1.sessionID } }
				handler( req2, _fakeRes(), function() {} )

				expect( req2.session.views ).toBe( 1 )
			} )

			it( "works as Session's store option end-to-end", function() {
				var store = new "../../models/stores/CacheStore"( "default" )
				var handler = new "../../models/middleware/Session"().session( { store: store } )

				var req1 = { cookies: {} }
				handler( req1, _fakeRes(), function() {} )
				req1.session.views = 1

				// Same store, simulating a second request presenting the
				// sessionID cookie the first response set.
				var req2 = { cookies: { "connect.sid": req1.sessionID } }
				handler( req2, _fakeRes(), function() {} )

				expect( req2.session.views ).toBe( 1 )

				req1.destroySession()
			} )

			it( "persists a mutation made *during* the request (inside next()), not just before it, against a store that doesn't share object references", function() {
				// BoxLang's in-memory "default" cache may well hold the same
				// struct reference it was given, which would make this pass
				// even with the bug this guards against (Session.bx used to
				// call store.set() *before* next(), so anything the request
				// mutated on req.session afterwards — a CSRF token, a login
				// setting the user — was silently lost the moment the store
				// actually serializes on write, e.g. a JDBCStore-backed cache
				// or Redis). This store double duplicates on both set() and
				// get(), the same as any real out-of-process store would, so
				// the test can't accidentally pass via reference-sharing.
				var entries = {}
				var store = {
					get: function( id ) { return structKeyExists( entries, id ) ? duplicate( entries[ id ] ) : javacast( "null", "" ) },
					set: function( id, data, maxAge ) { entries[ id ] = duplicate( data ) },
					destroy: function( id ) { structDelete( entries, id ) }
				}
				var handler = new "../../models/middleware/Session"().session( { store: store } )

				var req1 = { cookies: {} }
				handler( req1, _fakeRes(), function() { req1.session.views = 1 } )

				var req2 = { cookies: { "connect.sid": req1.sessionID } }
				handler( req2, _fakeRes(), function() {} )

				expect( req2.session.views ).toBe( 1 )
			} )

		} )
	}

	private function _fakeRes() {
		var res = {}
		res.cookie = function( name, value, options = {} ) { return res }
		// Simulates a response actually being sent right away — good enough
		// for these tests, which exercise Session's store behavior, not its
		// cookie timing (see BoxExpressIntegrationSpec for that, against a
		// real Response and real HTTP requests).
		res.onBeforeSend = function( callback ) { callback() }
		return res
	}

}
