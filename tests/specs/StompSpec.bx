/**
 * Regression coverage for models/middleware/Stomp.bx — STOMP 1.2 pub/sub on
 * top of app.ws(). Each behavior here was first verified live against a
 * real running server before being written up as a permanent test, the
 * same discipline as the rest of this project's WebSocket/SSE work.
 *
 * Two real bugs were found and fixed while building this, both worth
 * knowing about if you touch this file or Stomp.bx itself:
 *
 * - A `private` method defined in a class is not reachable from a closure
 *   that class hands to something else (app.ws()'s connection handler,
 *   here) once that closure is invoked from outside the class — confirmed
 *   directly with a minimal repro. Every helper Stomp.bx's handler()
 *   closures call is a plain (non-private) method because of this.
 * - duplicate() doesn't know how to deep-copy a struct holding
 *   WebSocketConnection objects (it tries to duplicate the underlying
 *   Java channel too and fails) — structCopy() (shallow) is what
 *   _deliver() actually needs, a new struct with the same connection
 *   references, not new connections.
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		variables.testPort = 4940
		variables.codec = new "../../models/StompFrameCodec"()

		variables.app = new "../../models/BoxExpress"()
		variables.stomp = new "../../models/middleware/Stomp"( { heartbeatMs: 0 } )
		variables.app.ws( "/stomp", variables.stomp.handler() )

		variables.authApp = new "../../models/BoxExpress"()
		variables.authPort = 4941
		variables.authStomp = new "../../models/middleware/Stomp"( {
			authenticate: ( login, passcode, host, connection ) => login == "demo" && passcode == "secret",
			authorize: ( login, destination, access, connection ) => destination != "/topic/forbidden"
		} )
		variables.authApp.ws( "/stomp", variables.authStomp.handler() )

		variables.hbApp = new "../../models/BoxExpress"()
		variables.hbPort = 4942
		variables.hbStomp = new "../../models/middleware/Stomp"( { heartbeatMs: 200 } )
		variables.hbApp.ws( "/stomp", variables.hbStomp.handler() )

		variables.app.listen( port = variables.testPort, options = { block: false } )
		variables.authApp.listen( port = variables.authPort, options = { block: false } )
		variables.hbApp.listen( port = variables.hbPort, options = { block: false } )
		sleep( 300 )
	}

	function afterAll() {
		variables.app.close()
		variables.authApp.close()
		variables.hbApp.close()
	}

	private function _connectedClient( port ) {
		var client = new "../helpers/WebSocketTestClient"()
		client.connect( "localhost", port, "/stomp" )
		client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "CONNECT", { "accept-version": "1.2" } ) ) )
		var connectedFrame = variables.codec.parse( client.readTextFrame() )
		return { client: client, connectedFrame: connectedFrame }
	}

	function run() {
		describe( "Stomp middleware", function() {

			it( "sends CONNECTED in response to CONNECT", function() {
				var conn = _connectedClient( variables.testPort )
				expect( conn.connectedFrame.getCommand() ).toBe( "CONNECTED" )
				expect( conn.connectedFrame.getHeader( "version" ) ).toBe( "1.2" )
				conn.client.close()
			} )

			it( "delivers a SEND to a SUBSCRIBEd destination as a MESSAGE with the subscriber's own subscription id", function() {
				var conn = _connectedClient( variables.testPort )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/a", id: "sub-1" } ) ) )
				sleep( 100 )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: "/topic/a" }, "hello" ) ) )
				var msg = variables.codec.parse( conn.client.readTextFrame() )

				expect( msg.getCommand() ).toBe( "MESSAGE" )
				expect( msg.getHeader( "destination" ) ).toBe( "/topic/a" )
				expect( msg.getHeader( "subscription" ) ).toBe( "sub-1" )
				expect( msg.getBody() ).toBe( "hello" )

				conn.client.close()
			} )

			it( "delivers to every current subscriber of a destination, not just the sender", function() {
				var subscriber = _connectedClient( variables.testPort )
				subscriber.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/broadcast-test", id: "sub-only" } ) ) )
				sleep( 100 )

				var sender = _connectedClient( variables.testPort )
				sender.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: "/topic/broadcast-test" }, "from another connection" ) ) )

				var msg = variables.codec.parse( subscriber.client.readTextFrame() )
				expect( msg.getBody() ).toBe( "from another connection" )

				subscriber.client.close()
				sender.client.close()
			} )

			it( "keeps two different connections' subscriptions independent even when they choose the identical subscription id", function() {
				// Regression test for a real HIGH-severity finding from a
				// security review: the subscriber registry used to be keyed
				// on the client-supplied SUBSCRIBE id alone, shared across
				// every connection — a second connection subscribing with
				// the same id (not secret, and commonly sequential per
				// client library, e.g. "sub-0") silently overwrote the
				// first connection's entry, redirecting their messages and
				// letting the second connection's UNSUBSCRIBE delete the
				// first connection's subscription.
				var connA = _connectedClient( variables.testPort )
				connA.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/collision-test", id: "sub-0" } ) ) )
				sleep( 100 )

				var connB = _connectedClient( variables.testPort )
				connB.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/collision-test", id: "sub-0" } ) ) )
				sleep( 100 )

				variables.stomp.send( "/topic/collision-test", "broadcast" )

				var msgA = variables.codec.parse( connA.client.readTextFrame() )
				var msgB = variables.codec.parse( connB.client.readTextFrame() )
				expect( msgA.getBody() ).toBe( "broadcast" )
				expect( msgB.getBody() ).toBe( "broadcast" )

				// B's UNSUBSCRIBE with the colliding id must not touch A's
				// subscription.
				connB.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "UNSUBSCRIBE", { id: "sub-0" } ) ) )
				sleep( 100 )
				variables.stomp.send( "/topic/collision-test", "after-b-unsubscribed" )
				var msgAAfter = variables.codec.parse( connA.client.readTextFrame() )
				expect( msgAAfter.getBody() ).toBe( "after-b-unsubscribed" )

				connA.client.close()
				connB.client.close()
			} )

			it( "stops delivering to a connection after UNSUBSCRIBE", function() {
				var conn = _connectedClient( variables.testPort )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/unsub-test", id: "sub-2" } ) ) )
				sleep( 100 )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "UNSUBSCRIBE", { id: "sub-2" } ) ) )
				sleep( 100 )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: "/topic/unsub-test" }, "should not arrive" ) ) )

				// Prove nothing arrives by sending a second, real, subscribed
				// message and confirming THAT'S what shows up first — not a
				// sleep-and-hope, an actual observable ordering check.
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/unsub-test-confirm", id: "sub-3" } ) ) )
				sleep( 100 )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: "/topic/unsub-test-confirm" }, "this one should arrive" ) ) )

				var msg = variables.codec.parse( conn.client.readTextFrame() )
				expect( msg.getBody() ).toBe( "this one should arrive" )

				conn.client.close()
			} )

			it( "app code can broadcast via stomp.send() from outside any connection's own handler", function() {
				var conn = _connectedClient( variables.testPort )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/server-push", id: "sub-4" } ) ) )
				sleep( 100 )

				variables.stomp.send( "/topic/server-push", { pushed: true } )

				var msg = variables.codec.parse( conn.client.readTextFrame() )
				expect( msg.getBody() ).toBe( '{"pushed":true}' )

				conn.client.close()
			} )

			it( "sends a RECEIPT and closes on DISCONNECT when a receipt header is present", function() {
				var conn = _connectedClient( variables.testPort )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "DISCONNECT", { receipt: "bye-1" } ) ) )

				var receipt = variables.codec.parse( conn.client.readTextFrame() )
				expect( receipt.getCommand() ).toBe( "RECEIPT" )
				expect( receipt.getHeader( "receipt-id" ) ).toBe( "bye-1" )

				conn.client.close()
			} )

			it( "rejects SUBSCRIBE/SEND before CONNECT with an ERROR", function() {
				var client = new "../helpers/WebSocketTestClient"()
				client.connect( "localhost", variables.testPort, "/stomp" )
				client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/a", id: "s1" } ) ) )

				var errorFrame = variables.codec.parse( client.readTextFrame() )
				expect( errorFrame.getCommand() ).toBe( "ERROR" )

				client.close()
			} )

			it( "rejects CONNECT when authenticate() returns false, and never sends CONNECTED", function() {
				var client = new "../helpers/WebSocketTestClient"()
				client.connect( "localhost", variables.authPort, "/stomp" )
				client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "CONNECT", { "accept-version": "1.2", login: "wrong", passcode: "bad" } ) ) )

				var response = variables.codec.parse( client.readTextFrame() )
				expect( response.getCommand() ).toBe( "ERROR" )

				client.close()
			} )

			it( "accepts CONNECT when authenticate() returns true, and rejects SUBSCRIBE when authorize() returns false", function() {
				var client = new "../helpers/WebSocketTestClient"()
				client.connect( "localhost", variables.authPort, "/stomp" )
				client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "CONNECT", { "accept-version": "1.2", login: "demo", passcode: "secret" } ) ) )
				var connectedFrame = variables.codec.parse( client.readTextFrame() )
				expect( connectedFrame.getCommand() ).toBe( "CONNECTED" )

				client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/forbidden", id: "s1" } ) ) )
				var errorFrame = variables.codec.parse( client.readTextFrame() )
				expect( errorFrame.getCommand() ).toBe( "ERROR" )

				client.close()
			} )

			it( "advertises heart-beat in CONNECTED and sends periodic keep-alives once the client says it wants them", function() {
				var client = new "../helpers/WebSocketTestClient"()
				client.connect( "localhost", variables.hbPort, "/stomp" )
				// "0,100": can't send heartbeats itself, wants them from the
				// server at ~100ms — negotiated outgoing = max(server's 200,
				// client's 100) = 200, same cadence the wait below expects.
				client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "CONNECT", { "accept-version": "1.2", "heart-beat": "0,100" } ) ) )
				var connectedFrame = variables.codec.parse( client.readTextFrame() )
				// The server's own advertised capability (sx,sy) — both
				// halves of the same configured heartbeatMs, not the
				// negotiated value each side computes independently.
				expect( connectedFrame.getHeader( "heart-beat" ) ).toBe( "200,200" )

				var heartbeat = client.readTextFrame()
				expect( heartbeat ).toBe( char( 10 ) )

				client.close()
			} )

			it( "sends no heartbeat once the client says it doesn't want any, even though heartbeatMs is configured", function() {
				var client = new "../helpers/WebSocketTestClient"()
				client.connect( "localhost", variables.hbPort, "/stomp" )
				// "0,0": explicit opt-out — a client with no heart-beat
				// header at all defaults to this same "0,0", so this also
				// covers that (more common) case.
				client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "CONNECT", { "accept-version": "1.2", "heart-beat": "0,0" } ) ) )
				variables.codec.parse( client.readTextFrame() )   // CONNECTED

				// Prove nothing arrives on its own by sending a real message
				// and confirming THAT'S what shows up — not a sleep-and-hope.
				client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/hb-optout", id: "sub-hb" } ) ) )
				sleep( 100 )
				variables.hbStomp.send( "/topic/hb-optout", "confirm" )
				var msg = variables.codec.parse( client.readTextFrame() )
				expect( msg.getBody() ).toBe( "confirm" )

				client.close()
			} )

			it( "closes the connection with an ERROR when a client that promised heartbeats stops sending them", function() {
				var client = new "../helpers/WebSocketTestClient"()
				client.connect( "localhost", variables.hbPort, "/stomp" )
				// "50,0": promises to send every 50ms, doesn't need any from
				// the server — negotiated incoming = max(client's 50,
				// server's 200) = 200, so the monitor's ~2x grace window is
				// ~400ms with nothing at all sent after CONNECT.
				client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "CONNECT", { "accept-version": "1.2", "heart-beat": "50,0" } ) ) )
				variables.codec.parse( client.readTextFrame() )   // CONNECTED

				sleep( 600 )
				var errorFrame = variables.codec.parse( client.readTextFrame() )
				expect( errorFrame.getCommand() ).toBe( "ERROR" )
				expect( errorFrame.getHeader( "message" ) ).toBe( "Heart-beat timeout" )

				client.close()
			} )

			it( "sends a RECEIPT for SUBSCRIBE/SEND/UNSUBSCRIBE when a receipt header is present, not just DISCONNECT", function() {
				var conn = _connectedClient( variables.testPort )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/receipt-test", id: "sub-r", receipt: "r-1" } ) ) )
				var subReceipt = variables.codec.parse( conn.client.readTextFrame() )
				expect( subReceipt.getCommand() ).toBe( "RECEIPT" )
				expect( subReceipt.getHeader( "receipt-id" ) ).toBe( "r-1" )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: "/topic/receipt-test", receipt: "r-2" }, "hi" ) ) )

				// The SEND delivers a MESSAGE to this same connection's own
				// subscription before the RECEIPT for the SEND frame itself
				// — _deliver() runs inside _handleSend(), which returns
				// before the switch calls _maybeReceipt(). Drain it first.
				variables.codec.parse( conn.client.readTextFrame() )

				var sendReceipt = variables.codec.parse( conn.client.readTextFrame() )
				expect( sendReceipt.getCommand() ).toBe( "RECEIPT" )
				expect( sendReceipt.getHeader( "receipt-id" ) ).toBe( "r-2" )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "UNSUBSCRIBE", { id: "sub-r", receipt: "r-3" } ) ) )
				var unsubReceipt = variables.codec.parse( conn.client.readTextFrame() )
				expect( unsubReceipt.getCommand() ).toBe( "RECEIPT" )
				expect( unsubReceipt.getHeader( "receipt-id" ) ).toBe( "r-3" )

				conn.client.close()
			} )

			it( "requires a client ACK before a client-individual message is considered handled, and rejects an unknown ack id", function() {
				var conn = _connectedClient( variables.testPort )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/ack-test", id: "sub-ack", ack: "client-individual" } ) ) )
				sleep( 100 )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: "/topic/ack-test" }, "needs-ack" ) ) )
				var msg = variables.codec.parse( conn.client.readTextFrame() )
				var ackId = msg.getHeader( "ack", "" )
				expect( len( ackId ) ).toBeTrue()

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "ACK", { id: ackId, receipt: "ack-1" } ) ) )
				var ackReceipt = variables.codec.parse( conn.client.readTextFrame() )
				expect( ackReceipt.getCommand() ).toBe( "RECEIPT" )

				// Acking the same id again has nothing left to reference.
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "ACK", { id: ackId } ) ) )
				var errorFrame = variables.codec.parse( conn.client.readTextFrame() )
				expect( errorFrame.getCommand() ).toBe( "ERROR" )

				conn.client.close()
			} )

			it( "client ack mode acknowledges cumulatively — one ACK clears every earlier pending message on that subscription", function() {
				var conn = _connectedClient( variables.testPort )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/cumulative-ack", id: "sub-cum", ack: "client" } ) ) )
				sleep( 100 )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: "/topic/cumulative-ack" }, "one" ) ) )
				var first = variables.codec.parse( conn.client.readTextFrame() )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: "/topic/cumulative-ack" }, "two" ) ) )
				var second = variables.codec.parse( conn.client.readTextFrame() )

				// Acking the SECOND message should also clear the first —
				// neither ack id should be independently referenceable
				// afterward.
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "ACK", { id: second.getHeader( "ack" ), receipt: "cum-1" } ) ) )
				var receipt = variables.codec.parse( conn.client.readTextFrame() )
				expect( receipt.getCommand() ).toBe( "RECEIPT" )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "ACK", { id: first.getHeader( "ack" ) } ) ) )
				var errorFrame = variables.codec.parse( conn.client.readTextFrame() )
				expect( errorFrame.getCommand() ).toBe( "ERROR" )

				conn.client.close()
			} )

			it( "buffers a transactional SEND until COMMIT, and discards it on ABORT", function() {
				var conn = _connectedClient( variables.testPort )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: "/topic/tx-test", id: "sub-tx" } ) ) )
				sleep( 100 )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "BEGIN", { transaction: "tx-1" } ) ) )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: "/topic/tx-test", transaction: "tx-1" }, "committed-message" ) ) )

				// Nothing has arrived yet — prove it by aborting a SECOND,
				// independent transaction's buffered SEND and confirming
				// its message never shows up either, then committing the
				// first and confirming that ONE message (not the aborted
				// one) is what arrives.
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "BEGIN", { transaction: "tx-2" } ) ) )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: "/topic/tx-test", transaction: "tx-2" }, "aborted-message" ) ) )
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "ABORT", { transaction: "tx-2" } ) ) )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "COMMIT", { transaction: "tx-1" } ) ) )
				var msg = variables.codec.parse( conn.client.readTextFrame() )
				expect( msg.getBody() ).toBe( "committed-message" )

				conn.client.close()
			} )

			it( "rejects SEND/ACK/BEGIN/COMMIT referencing an unknown transaction id", function() {
				var conn = _connectedClient( variables.testPort )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: "/topic/no-such-tx", transaction: "ghost" }, "x" ) ) )
				var errorFrame = variables.codec.parse( conn.client.readTextFrame() )
				expect( errorFrame.getCommand() ).toBe( "ERROR" )

				conn.client.close()
			} )

			it( "escapes a colon and embedded newline in a header value instead of corrupting the frame", function() {
				var conn = _connectedClient( variables.testPort )
				var trickyDestination = "/topic/inject:test"
				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SUBSCRIBE", { destination: trickyDestination, id: "sub-tricky" } ) ) )
				sleep( 100 )

				conn.client.sendText( variables.codec.serialize( new "../../models/StompFrame"( "SEND", { destination: trickyDestination }, "x" ) ) )
				var msg = variables.codec.parse( conn.client.readTextFrame() )
				expect( msg.getHeader( "destination" ) ).toBe( trickyDestination )

				conn.client.close()
			} )

			it( "honors content-length so an embedded NUL byte in the body round-trips instead of being read as the terminator", function() {
				var bodyWithEmbeddedNul = "before" & char( 0 ) & "after"
				var frame = new "../../models/StompFrame"( "SEND", { destination: "/topic/x" }, bodyWithEmbeddedNul )
				var wire = variables.codec.serialize( frame )
				expect( wire ).toInclude( "content-length:" & len( bodyWithEmbeddedNul.getBytes( "UTF-8" ) ) )

				var parsed = variables.codec.parse( wire )
				expect( parsed.getBody() ).toBe( bodyWithEmbeddedNul )
			} )

		} )
	}

}
