/**
 * Process-level lifecycle tests: things that can't be exercised by TestBox's
 * usual in-process, block=false server (see BoxExpressIntegrationSpec) because
 * they involve a real OS process boundary — a clean exit on a port conflict
 * (System.exit(1), which would kill the test runner itself if triggered
 * in-process), a real SIGTERM releasing the listening socket, and
 * reloadOnChange's supervisor restarting its child server on a file change.
 *
 * Each test spawns `boxlang` as a real subprocess (replaying the current JVM's
 * own command line, the same trick BoxExpress._currentCommand() uses) against
 * a small generated .bxs script, and asserts on its stdout/exit code/the
 * actual TCP port — never on internal state, since these are black-box,
 * OS-level behaviors.
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		variables.scratchDir = expandPath( "tests/fixtures/process-lifecycle-scratch" )
		if ( !directoryExists( variables.scratchDir ) ) {
			directoryCreate( variables.scratchDir )
		}
	}

	function afterAll() {
		if ( directoryExists( variables.scratchDir ) ) {
			directoryDelete( variables.scratchDir, true )
		}
	}

	function run() {
		describe( "BoxExpress process lifecycle", function() {

			it( "exits cleanly with a friendly message (not a raw stack trace) when the requested port is already in use", function() {
				var port = 4401
				var holderApp = new "../../models/BoxExpress"()
				holderApp.get( "/", ( req, res ) => res.send( "up" ) )
				holderApp.listen( port = port, options = { block: false } )
				sleep( 300 )

				try {
					var scriptPath = _writeScratchScript( "port-conflict", '
						app = boxExpress()
						app.listen( #port# )
					' )
					var logPath = scriptPath & ".log"
					var proc = _spawnBoxlangScript( scriptPath, logPath )

					var exited = proc.waitFor( 10, createObject( "java", "java.util.concurrent.TimeUnit" ).SECONDS )
					expect( exited ).toBeTrue( "subprocess should have exited within 10s" )
					expect( proc.exitValue() ).toBe( 1 )

					var logContents = fileRead( logPath )
					expect( logContents ).toInclude( "already in use" )
					expect( logContents ).notToInclude( "BoxRuntimeException" )
					expect( logContents ).notToInclude( "at ortus.boxlang" )
				} finally {
					holderApp.close()
				}
			} )

			it( "releases the port immediately when the process is sent SIGTERM", function() {
				var port = 4402
				var scriptPath = _writeScratchScript( "sigterm-shutdown", '
					app = boxExpress()
					app.get( "/", ( req, res ) => res.send( "up" ) )
					app.listen( #port#, ( p ) => println( "LISTENING_OK" ) )
				' )
				var logPath = scriptPath & ".log"
				var proc = _spawnBoxlangScript( scriptPath, logPath )

				try {
					var cameUp = _waitUntil( function() {
						return fileExists( logPath ) && fileRead( logPath ).contains( "LISTENING_OK" )
					}, 8000 )
					expect( cameUp ).toBeTrue( "subprocess should have reported LISTENING_OK within 8s" )
					expect( _isPortFree( port ) ).toBeFalse( "port should be bound while the subprocess is up" )

					proc.destroy() // SIGTERM

					var timeUnit = createObject( "java", "java.util.concurrent.TimeUnit" )
					var exited = proc.waitFor( 8, timeUnit.SECONDS )
					expect( exited ).toBeTrue( "subprocess should exit within 8s of SIGTERM" )

					var portFreed = _waitUntil( function() {
						return _isPortFree( port )
					}, 3000 )
					expect( portFreed ).toBeTrue( "port should be released promptly after SIGTERM" )
				} finally {
					if ( proc.isAlive() ) {
						proc.destroyForcibly()
					}
				}
			} )

			it( "reloadOnChange restarts the child server with the edited source while the supervisor process stays alive", function() {
				var port = 4403
				var marker = "reload-test-" & createUUID()
				var scriptPath = _writeScratchScript( marker, _reloadScript( port, 1 ) )
				var logPath = scriptPath & ".log"
				var proc = _spawnBoxlangScript( scriptPath, logPath )

				try {
					expect( _waitForLog( logPath, "LISTENING_OK", 15000 ) ).toBeTrue( "child should have reported LISTENING_OK within 15s" )
					var initial = _httpGetJson( "http://localhost:#port#/version" )
					expect( initial.version ).toBe( 1 )
					expect( initial.pid ).notToBe( proc.pid(), "the server should run in a child, not the supervisor" )

					fileWrite( scriptPath, _reloadScript( port, 2 ) )

					expect( _waitForVersion( port, 2 ) ).toBeTrue( "server should serve the updated route within 20s of the file change" )
					expect( proc.isAlive() ).toBeTrue( "the supervisor (the process we started) must survive a reload" )

					var logContents = fileRead( logPath )
					expect( logContents ).toInclude( "[reloadOnChange]" )
					expect( logContents ).toInclude( "restarting" )
				} finally {
					_destroyAllMatching( marker )
				}
			} )

			it( "reloadOnChange survives a save that crashes the app at startup and recovers on the next save", function() {
				var port = 4404
				var marker = "reload-crash-" & createUUID()
				var scriptPath = _writeScratchScript( marker, _reloadScript( port, 1 ) )
				var logPath = scriptPath & ".log"
				var proc = _spawnBoxlangScript( scriptPath, logPath )

				try {
					expect( _waitForLog( logPath, "LISTENING_OK", 15000 ) ).toBeTrue( "child should have reported LISTENING_OK within 15s" )

					fileWrite( scriptPath, 'throw( "BOOM_AT_STARTUP" )' )
					expect( _waitForLog( logPath, "app exited with code", 20000 ) ).toBeTrue( "supervisor should report the crashed child" )
					expect( proc.isAlive() ).toBeTrue( "the supervisor must keep running after the app crashes" )

					fileWrite( scriptPath, _reloadScript( port, 3 ) )
					expect( _waitForVersion( port, 3 ) ).toBeTrue( "fixing the file should bring the server back within 20s" )
				} finally {
					_destroyAllMatching( marker )
				}
			} )

			it( "SIGTERM to the reloadOnChange supervisor stops its child and releases the port", function() {
				var port = 4405
				var marker = "reload-sigterm-" & createUUID()
				var scriptPath = _writeScratchScript( marker, _reloadScript( port, 1 ) )
				var logPath = scriptPath & ".log"
				var proc = _spawnBoxlangScript( scriptPath, logPath )

				try {
					expect( _waitForLog( logPath, "LISTENING_OK", 15000 ) ).toBeTrue( "child should have reported LISTENING_OK within 15s" )

					proc.destroy() // SIGTERM to the supervisor only

					var exited = proc.waitFor( 15, createObject( "java", "java.util.concurrent.TimeUnit" ).SECONDS )
					expect( exited ).toBeTrue( "supervisor should exit within 15s of SIGTERM" )
					expect( _waitUntil( function() {
						return _isPortFree( port )
					}, 5000 ) ).toBeTrue( "the child should have released the port" )
					expect( _countMatching( marker ) ).toBe( 0, "no process for this script should be left running" )
				} finally {
					_destroyAllMatching( marker )
				}
			} )

		} )
	}

	private function _reloadScript( port, version ) {
		return '
			app = boxExpress()
			app.set( "reloadOnChange", true )
			app.get( "/version", ( req, res ) => res.json( { version: #version#, pid: createObject( "java", "java.lang.ProcessHandle" ).current().pid() } ) )
			app.listen( #port#, ( p ) => println( "LISTENING_OK" ) )
		'
	}

	private function _waitForLog( logPath, text, timeoutMs ) {
		var logFile = logPath
		var needle = text
		return _waitUntil( function() {
			return fileExists( logFile ) && fileRead( logFile ).contains( needle )
		}, timeoutMs )
	}

	private function _waitForVersion( port, version ) {
		var versionUrl = "http://localhost:#port#/version"
		var expected = version
		return _waitUntil( function() {
			try {
				return _httpGetJson( versionUrl ).version == expected
			} catch ( any e ) {
				return false // port briefly unbound mid-restart — keep polling
			}
		}, 20000, 400 )
	}

	private function _writeScratchScript( name, content ) {
		var scriptPath = variables.scratchDir & "/" & name & "-" & createUUID() & ".bxs"
		fileWrite( scriptPath, content )
		return scriptPath
	}

	/**
	 * Spawns `boxlang <scriptPath>` by replaying the current JVM's own command
	 * line with the trailing script argument swapped out — the same approach
	 * BoxExpress._currentCommand() uses — so this works with however the test
	 * suite itself was launched (bvm-managed boxlang, a raw java invocation,
	 * custom JVM flags) without hardcoding a "boxlang" executable path.
	 */
	private function _spawnBoxlangScript( scriptPath, logPath ) {
		var info = createObject( "java", "java.lang.ProcessHandle" ).current().info()
		var command = []
		command.append( info.command().isPresent() ? info.command().get() : "boxlang" )

		if ( info.arguments().isPresent() ) {
			var currentArgs = info.arguments().get()
			for ( var i = 1; i < currentArgs.length; i++ ) {
				command.append( currentArgs[ i ] )
			}
		}
		command.append( scriptPath )

		var pb = createObject( "java", "java.lang.ProcessBuilder" ).init( command )
		pb.redirectOutput( createObject( "java", "java.io.File" ).init( logPath ) )
		pb.redirectErrorStream( true )
		return pb.start()
	}

	private function _waitUntil( checkFn, timeoutMs, intervalMs = 200 ) {
		var start = getTickCount()
		while ( getTickCount() - start < timeoutMs ) {
			if ( checkFn() ) {
				return true
			}
			sleep( intervalMs )
		}
		return false
	}

	private function _isPortFree( port ) {
		try {
			var socket = createObject( "java", "java.net.ServerSocket" ).init( port )
			socket.close()
			return true
		} catch ( any e ) {
			return false
		}
	}

	private function _httpGetJson( targetUrl ) {
		var httpClient = createObject( "java", "java.net.http.HttpClient" ).newHttpClient()
		var req = createObject( "java", "java.net.http.HttpRequest" ).newBuilder()
			.uri( createObject( "java", "java.net.URI" ).init( targetUrl ) )
			.GET()
			.build()
		var response = httpClient.send( req, createObject( "java", "java.net.http.HttpResponse$BodyHandlers" ).ofString() )
		return JSONDeserialize( response.body() )
	}

	/**
	 * Best-effort cleanup for a reloadOnChange test: our Process handle is the
	 * supervisor, and its child server carries the same unique marker in its
	 * command line, so match on that to catch both even if a test failed
	 * part-way through a restart.
	 */
	private function _countMatching( marker ) {
		var count = 0
		var allProcs = createObject( "java", "java.lang.ProcessHandle" ).allProcesses().toArray()
		for ( var i = 1; i <= arrayLen( allProcs ); i++ ) {
			try {
				var cmdLine = allProcs[ i ].info().commandLine()
				if ( cmdLine.isPresent() && cmdLine.get().contains( marker ) && allProcs[ i ].isAlive() ) {
					count++
				}
			} catch ( any e ) {
			}
		}
		return count
	}

	private function _destroyAllMatching( marker ) {
		try {
			var allProcs = createObject( "java", "java.lang.ProcessHandle" ).allProcesses()
				.toArray()

			for ( var i = 1; i <= arrayLen( allProcs ); i++ ) {
				var ph = allProcs[ i ]
				try {
					var cmdLine = ph.info().commandLine()
					if ( cmdLine.isPresent() && cmdLine.get().contains( marker ) ) {
						ph.destroyForcibly()
					}
				} catch ( any e ) {
					// process may have exited between enumeration and inspection — ignore
				}
			}
		} catch ( any e ) {
			// best-effort cleanup only
		}
	}

}
