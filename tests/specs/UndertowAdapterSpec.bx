/**
 * Dedicated coverage for BoxExpress's Undertow server wiring
 * (listen()/close() in BoxExpress.bx, plus the adapters/ classes they use).
 * Not a full behavior suite (that's what the rest of tests/specs/ already
 * exercises against the same server) — just regression coverage for the
 * real bugs found while building it: Undertow dispatches handlers on its
 * own I/O thread by default, where blocking body reads throw
 * IllegalStateException — fixed by dispatching each request onto its own
 * virtual thread first (see UndertowVirtualThreadHandler.bx), verified
 * here by actually exercising a JSON body and by checking the handling
 * thread directly.
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		variables.testPort = 4501
		variables.baseUrl = "http://localhost:#variables.testPort#"
		variables.client = new "../helpers/HttpClient"()

		variables.app = new "../../models/BoxExpress"()
		variables.app.use( new "../../models/middleware/BodyParsers"().json() )

		variables.app.get( "/", ( req, res ) => {
			res.send( "hello from undertow" )
		} )

		variables.app.get( "/query", ( req, res ) => {
			res.json( { query: req.query } )
		} )

		variables.app.post( "/echo", ( req, res ) => {
			res.json( { youSent: req.body } )
		} )

		variables.app.get( "/cookie", ( req, res ) => {
			res.cookie( "a", "1" ).cookie( "b", "2" ).send( "cookied" )
		} )

		variables.app.get( "/head-test", ( req, res ) => {
			res.send( "should not appear in a HEAD response" )
		} )

		variables.app.get( "/thread-info", ( req, res ) => {
			var currentThread = createObject( "java", "java.lang.Thread" ).currentThread()
			res.json( { virtual: currentThread.isVirtual() } )
		} )

		variables.app.listen( port = variables.testPort, options = { block: false } )
		sleep( 500 )
	}

	function afterAll() {
		variables.app.close()
	}

	function run() {
		describe( "BoxExpress's Undertow server", function() {

			it( "serves a basic GET route", function() {
				var result = variables.client.get( variables.baseUrl & "/" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toBe( "hello from undertow" )
			} )

			it( "parses the query string via the UndertowExchangeAdapter", function() {
				var result = variables.client.get( variables.baseUrl & "/query?a=1&b=hello" )
				expect( JSONDeserialize( result.body ).query.a ).toBe( "1" )
				expect( JSONDeserialize( result.body ).query.b ).toBe( "hello" )
			} )

			it( "reads a JSON request body — the actual bug this adapter had until requests were dispatched onto virtual threads", function() {
				var result = variables.client.post( variables.baseUrl & "/echo", '{"x":42}', "application/json" )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).youSent.x ).toBe( 42 )
			} )

			it( "sets multiple Set-Cookie headers via addHeader()", function() {
				var result = variables.client.get( variables.baseUrl & "/cookie" )
				expect( result.setCookie ).toInclude( "a=1" )
				expect( result.setCookie ).toInclude( "b=2" )
			} )

			it( "suppresses the body but keeps the correct Content-Length on HEAD", function() {
				var result = variables.client.requestNoRedirect( "HEAD", variables.baseUrl & "/head-test" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toBe( "" )
			} )

			it( "runs each request on its own virtual thread, not Undertow's XNIO worker pool", function() {
				var result = variables.client.get( variables.baseUrl & "/thread-info" )
				expect( JSONDeserialize( result.body ).virtual ).toBeTrue()
			} )

			it( "returns a default 404 for an unmatched route", function() {
				var result = variables.client.get( variables.baseUrl & "/does-not-exist" )
				expect( result.statusCode ).toBe( 404 )
			} )

			it( "exposes live request counts via getConnectorStatistics()", function() {
				var before = variables.app.getConnectorStatistics()
				expect( before ).notToBeNull()
				var countBefore = before.getRequestCount()

				variables.client.get( variables.baseUrl & "/" )

				var after = variables.app.getConnectorStatistics()
				expect( after.getRequestCount() ).toBeGT( countBefore )
			} )

		} )
	}

}
