/**
 * Dedicated coverage for the Undertow-backed HttpServerAdapter (Phase 3 of
 * the Undertow-adapter plan) — not a full parity suite (that's Phase 5's
 * job, running the *whole* existing suite against both engines), just
 * regression coverage for this adapter's own code, including the real bug
 * found while building it: Undertow dispatches handlers on its own I/O
 * thread by default, where blocking body reads throw
 * IllegalStateException — fixed with io.undertow.server.handlers.
 * BlockingHandler, verified here by actually exercising a JSON body.
 *
 * Constructs BoxExpress with an explicit UndertowHttpServerAdapter override
 * rather than relying on the default (still the JDK adapter — engine
 * selection is Phase 4, not built yet).
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		variables.testPort = 4501
		variables.baseUrl = "http://localhost:#variables.testPort#"
		variables.client = new "../helpers/HttpClient"()

		variables.app = new "../../models/BoxExpress"( new "../../models/adapters/UndertowHttpServerAdapter"() )
		variables.app.use( new "../../models/middleware/BodyParsers"().json() )

		variables.app.get( "/", ( req, res ) => {
			res.send( "hello from undertow" )
		} )

		variables.app.get( "/query", ( req, res ) => {
			res.json( { query: req.query } )
		} )

		variables.app.post( "/echo", ( req, res ) => {
			res.json( { youSent: req.body } )
		} )

		variables.app.get( "/cookie", ( req, res ) => {
			res.cookie( "a", "1" ).cookie( "b", "2" ).send( "cookied" )
		} )

		variables.app.get( "/head-test", ( req, res ) => {
			res.send( "should not appear in a HEAD response" )
		} )

		variables.app.listen( port = variables.testPort, options = { block: false } )
		sleep( 500 )
	}

	function afterAll() {
		variables.app.close()
	}

	function run() {
		describe( "UndertowHttpServerAdapter", function() {

			it( "serves a basic GET route", function() {
				var result = variables.client.get( variables.baseUrl & "/" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toBe( "hello from undertow" )
			} )

			it( "parses the query string via the UndertowExchangeAdapter", function() {
				var result = variables.client.get( variables.baseUrl & "/query?a=1&b=hello" )
				expect( JSONDeserialize( result.body ).query.a ).toBe( "1" )
				expect( JSONDeserialize( result.body ).query.b ).toBe( "hello" )
			} )

			it( "reads a JSON request body — the actual bug this adapter had until BlockingHandler was added", function() {
				var result = variables.client.post( variables.baseUrl & "/echo", '{"x":42}', "application/json" )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).youSent.x ).toBe( 42 )
			} )

			it( "sets multiple Set-Cookie headers via addHeader()", function() {
				var result = variables.client.get( variables.baseUrl & "/cookie" )
				expect( result.setCookie ).toInclude( "a=1" )
				expect( result.setCookie ).toInclude( "b=2" )
			} )

			it( "suppresses the body but keeps the correct Content-Length on HEAD", function() {
				var result = variables.client.requestNoRedirect( "HEAD", variables.baseUrl & "/head-test" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toBe( "" )
			} )

			it( "returns a default 404 for an unmatched route", function() {
				var result = variables.client.get( variables.baseUrl & "/does-not-exist" )
				expect( result.statusCode ).toBe( 404 )
			} )

			it( "throws type=BoxExpress.PortInUse when the port is already bound, same as the JDK adapter", function() {
				// Testing the adapter's own start() directly, not
				// BoxExpress.listen() — listen() catches this type and
				// calls System.exit(1) for the real "friendly message and
				// quit" UX, which would kill the test runner itself if
				// triggered in-process (same reason ProcessLifecycleSpec
				// tests that specific behavior via a real subprocess
				// instead).
				var conflictingAdapter = new "../../models/adapters/UndertowHttpServerAdapter"()
				var noopBridge = new "../../models/HttpBridge"( new "../../models/Router"( {} ), {}, {} )

				expect( function() {
					conflictingAdapter.start( variables.testPort, 1024, noopBridge )
				} ).toThrow( "BoxExpress.PortInUse" )
			} )

		} )
	}

}
