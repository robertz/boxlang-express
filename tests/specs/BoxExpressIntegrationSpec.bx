/**
 * End-to-end tests: spins up a real BoxExpress app on a real port and hits it
 * with actual HTTP requests (java.net.HttpURLConnection), exercising Request,
 * Response, BodyParsers, StaticFiles, HttpBridge and BoxExpress together —
 * the same thing manual curl testing verified during development, now automated.
 */
class extends="testbox.system.BaseSpec" {

	function beforeAll() {
		variables.testPort = 4321
		variables.baseUrl = "http://localhost:#variables.testPort#"
		variables.client = new "../helpers/HttpClient"()

		var bodyParsers = new "../../models/middleware/BodyParsers"()
		var staticFiles = new "../../models/middleware/StaticFiles"()
		var multipart = new "../../models/middleware/Multipart"()
		var session = new "../../models/middleware/Session"()
		variables.uploadDest = expandPath( "tests/fixtures/uploads" )

		// expandPath() resolves relative to the top-level entry script (run-tests.bxs,
		// at the project root), not relative to this class file — hence the project-root-
		// relative "tests/..." paths below rather than "../fixtures/...".

		variables.app = new "../../models/BoxExpress"()
		variables.app.use( bodyParsers.json() )
		variables.app.use( "/public", staticFiles.serve( expandPath( "tests/fixtures/public" ) ) )
		variables.app.use( "/public-cached", staticFiles.serve( expandPath( "tests/fixtures/public" ), { maxAge: 86400 } ) )
		// Mounted at the root (no path prefix) like the README's quickstart example —
		// tests/fixtures/public has no index.html, so every request should fall through
		// to the routes below via next() rather than erroring.
		variables.app.use( staticFiles.serve( expandPath( "tests/fixtures/public" ) ) )
		variables.app.use( session.session() )
		variables.app.set( "views", expandPath( "tests/fixtures/views" ) )
		variables.app.locals.appValue = "fromApp"
		variables.app.locals.overridden = "shouldBeReplaced"

		variables.app.get( "/", ( req, res ) => {
			res.send( "Hello from BoxExpress!" )
		} )

		variables.app.get( "/users/:id", ( req, res ) => {
			res.json( { id: req.params.id } )
		} )

		variables.app.get( "/search", ( req, res ) => {
			res.json( { query: req.query } )
		} )

		variables.app.get( "/cookies", ( req, res ) => {
			res.json( { cookies: req.cookies } )
		} )

		variables.app.post( "/echo", ( req, res ) => {
			res.json( { youSent: req.body } )
		} )

		variables.app.get( "/boom", ( req, res ) => {
			throw( message = "kaboom", type = "TestError" )
		} )

		variables.app.get( "/go-home", ( req, res ) => {
			res.redirect( "/" )
		} )

		variables.app.get( "/set-cookie", ( req, res ) => {
			res.cookie( "sessionId", "abc123" ).json( { cookieSet: true } )
		} )

		variables.app.get( "/not-found-status", ( req, res ) => {
			res.sendStatus( 404 )
		} )

		variables.app.get( "/session-count", ( req, res ) => {
			req.session.views = ( req.session.views ?: 0 ) + 1
			res.json( { views: req.session.views, sessionID: req.sessionID } )
		} )

		variables.app.get( "/session-logout", ( req, res ) => {
			req.destroySession()
			res.json( { loggedOut: true } )
		} )

		variables.app.get( "/download", ( req, res ) => {
			res.download( expandPath( "tests/fixtures/public/hello.txt" ), "greeting.txt" )
		} )

		variables.app.get( "/download-named", ( req, res ) => {
			res.download( expandPath( "tests/fixtures/public/hello.txt" ), req.query.filename )
		} )

		variables.app.get( "/send-file", ( req, res ) => {
			res.sendFile( expandPath( "tests/fixtures/public/hello.txt" ) )
		} )

		variables.app.get( "/send-file-cached", ( req, res ) => {
			res.sendFile( expandPath( "tests/fixtures/public/hello.txt" ), { maxAge: 3600 } )
		} )

		variables.app.post( "/upload", multipart.upload( { dest: variables.uploadDest } ), ( req, res ) => {
			res.json( { fields: req.body, files: req.files } )
		} )

		variables.app.get( "/dump-test", ( req, res ) => {
			res.dump( { name: "Ada", tags: [ "a", "b" ] } )
		} )

		variables.app.put( "/items/:id", ( req, res ) => {
			res.json( { updated: req.params.id, body: req.body } )
		} )

		variables.app.patch( "/items/:id", ( req, res ) => {
			res.json( { patched: req.params.id } )
		} )

		variables.app.delete( "/items/:id", ( req, res ) => {
			res.json( { deleted: req.params.id } )
		} )

		variables.app.all( "/any-method", ( req, res ) => {
			res.send( "matched: " & req.method )
		} )

		variables.app.get( "/header-test", ( req, res ) => {
			res.header( "X-Custom", "yes" ).send( "ok" )
		} )

		variables.app.get( "/type-test", ( req, res ) => {
			res.type( "application/xml" ).send( "<x/>" )
		} )

		variables.app.get( "/end-test", ( req, res ) => {
			res.end()
		} )

		variables.app.get( "/end-test-body", ( req, res ) => {
			res.end( "bye" )
		} )

		variables.app.get( "/bytes-test", ( req, res ) => {
			res.sendBytes( "raw bytes".getBytes( "UTF-8" ), "text/plain; charset=utf-8" )
		} )

		variables.app.get( "/echo-header", ( req, res ) => {
			res.json( { got: req.get( "X-Ping" ) ?: "" } )
		} )

		variables.app.get( "/raw-exchange-test", ( req, res ) => {
			res.json( { hasExchange: !isNull( req.rawExchange() ) } )
		} )

		variables.app.get( "/redirect-permanent", ( req, res ) => {
			res.redirect( "/", 301 )
		} )

		variables.app.get( "/ip-test", ( req, res ) => {
			res.json( { ip: req.ip } )
		} )

		variables.app.get( "/reqinfo-test", ( req, res ) => {
			res.json( { protocol: req.protocol, secure: req.secure, hostname: req.hostname } )
		} )

		variables.app.get( "/locals-test", ( req, res ) => {
			res.locals.resValue = "fromRes"
			res.render( "locals-test", { overridden: "fromData" } )
		} )

		variables.app.get( "/optional-param-test/:id?", ( req, res ) => {
			res.json( { id: req.params.id ?: "(absent)" } )
		} )

		variables.app.use( "/multi-use-test",
			( req, res, next ) => { req.testOrder = [ "mw1" ]; next() },
			( req, res, next ) => { req.testOrder.append( "mw2" ); next() }
		)
		variables.app.get( "/multi-use-test", ( req, res ) => {
			req.testOrder.append( "route" )
			res.json( { order: req.testOrder } )
		} )

		variables.app.param( "code", ( req, res, next, value ) => {
			req.params.code = "parented-" & value
			next()
		} )
		variables.app.get( "/parented/:code", ( req, res ) => {
			res.json( { code: req.params.code } )
		} )

		variables.app.get( "/greet/:name", ( req, res ) => {
			res.render( "greeting", { name: req.params.name } )
		} )

		variables.app.get( "/greet-hbs/:name", ( req, res ) => {
			res.render( "greeting.hbs", { data: { name: req.params.name, things: [ "a", "b", "c" ] } } )
		} )

		var apiRouter = new "../../models/Router"()
		apiRouter.get( "/ping", ( req, res ) => {
			res.json( { pong: true } )
		} )
		variables.app.use( "/api", apiRouter )

		variables.app.use( ( err, req, res, next ) => {
			res.status( 500 ).json( { error: true, message: err.message } )
		} )

		// Registered here (before listen()) rather than inside the concurrency test below —
		// mutating the route table after listen() while other virtual-thread requests may be
		// mid-dispatch is exactly the pattern this project doesn't guarantee is safe.
		variables.app.get( "/slow-test-only", ( req, res ) => {
			sleep( 500 )
			res.json( { slept: true } )
		} )

		variables.app.listen( port = variables.testPort, options = { block: false } )
		sleep( 300 )
	}

	function afterAll() {
		variables.app.close()
		if ( directoryExists( variables.uploadDest ) ) {
			directoryDelete( variables.uploadDest, true )
		}
	}

	function run() {
		describe( "BoxExpress (live server)", function() {

			it( "responds to a basic GET route", function() {
				var result = variables.client.get( variables.baseUrl & "/" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toBe( "Hello from BoxExpress!" )
			} )

			it( "captures a route param", function() {
				var result = variables.client.get( variables.baseUrl & "/users/42" )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).id ).toBe( "42" )
			} )

			it( "parses the query string", function() {
				var result = variables.client.get( variables.baseUrl & "/search?q=cats" )
				expect( JSONDeserialize( result.body ).query.q ).toBe( "cats" )
			} )

			it( "handles an empty query value without a 500 (key=)", function() {
				var result = variables.client.get( variables.baseUrl & "/search?q=" )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).query.q ).toBe( "" )
			} )

			it( "handles an empty query key without a 500 (=value)", function() {
				var result = variables.client.get( variables.baseUrl & "/search?=cats" )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).query[ "" ] ).toBe( "cats" )
			} )

			it( "handles an empty cookie value without a 500 (name=)", function() {
				var result = variables.client.getWithHeaders( variables.baseUrl & "/cookies", { "Cookie": "name=" } )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).cookies.name ).toBe( "" )
			} )

			it( "handles an empty cookie name without a 500 (=value)", function() {
				var result = variables.client.getWithHeaders( variables.baseUrl & "/cookies", { "Cookie": "=value" } )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).cookies[ "" ] ).toBe( "value" )
			} )

			it( "parses a JSON request body via opt-in middleware", function() {
				var result = variables.client.post( variables.baseUrl & "/echo", '{"a":1}', "application/json" )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).youSent.a ).toBe( 1 )
			} )

			it( "dispatches into a mounted router", function() {
				var result = variables.client.get( variables.baseUrl & "/api/ping" )
				expect( JSONDeserialize( result.body ).pong ).toBeTrue()
			} )

			it( "falls through to the next handler on the root path when static middleware is mounted with no path prefix", function() {
				var result = variables.client.get( variables.baseUrl & "/" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toBe( "Hello from BoxExpress!" )
			} )

			it( "serves a static file", function() {
				var result = variables.client.get( variables.baseUrl & "/public/hello.txt" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toInclude( "static fixture" )
			} )

			it( "sets ETag/Last-Modified on a static file and sends 304 when If-None-Match matches", function() {
				var first = variables.client.get( variables.baseUrl & "/public/hello.txt" )
				expect( first.statusCode ).toBe( 200 )
				expect( first.etag ).notToBe( "" )
				expect( first.lastModified ).notToBe( "" )

				var second = variables.client.getWithHeaders( variables.baseUrl & "/public/hello.txt", { "If-None-Match": first.etag } )
				expect( second.statusCode ).toBe( 304 )
				expect( second.body ).toBe( "" )
			} )

			it( "honors a Range request on a static file, returning 206 with just the requested slice", function() {
				// tests/fixtures/public/hello.txt is "This is a static fixture ..." — bytes 0-3 are "This".
				var result = variables.client.getWithHeaders( variables.baseUrl & "/public/hello.txt", { "Range": "bytes=0-3" } )
				expect( result.statusCode ).toBe( 206 )
				expect( result.body ).toBe( "This" )
				expect( result.contentRange ).toBe( "bytes 0-3/79" )
				expect( result.acceptRanges ).toBe( "bytes" )
			} )

			it( "returns 416 with Content-Range: bytes */size for a static file Range request beyond the file", function() {
				var result = variables.client.getWithHeaders( variables.baseUrl & "/public/hello.txt", { "Range": "bytes=1000-2000" } )
				expect( result.statusCode ).toBe( 416 )
				expect( result.body ).toBe( "" )
				expect( result.contentRange ).toBe( "bytes */79" )
			} )

			it( "sets Accept-Ranges on a static file response even without a Range request", function() {
				var result = variables.client.get( variables.baseUrl & "/public/hello.txt" )
				expect( result.acceptRanges ).toBe( "bytes" )
			} )

			it( "sets Cache-Control on a static file only when maxAge is configured", function() {
				var withMaxAge = variables.client.get( variables.baseUrl & "/public-cached/hello.txt" )
				expect( withMaxAge.getHeader( "Cache-Control" ) ).toBe( "public, max-age=86400" )

				var withoutMaxAge = variables.client.get( variables.baseUrl & "/public/hello.txt" )
				expect( withoutMaxAge.hasHeader( "Cache-Control" ) ).toBeFalse()
			} )

			it( "sets Cache-Control on res.sendFile() only when maxAge is configured", function() {
				var withMaxAge = variables.client.get( variables.baseUrl & "/send-file-cached" )
				expect( withMaxAge.getHeader( "Cache-Control" ) ).toBe( "public, max-age=3600" )

				var withoutMaxAge = variables.client.get( variables.baseUrl & "/send-file" )
				expect( withoutMaxAge.hasHeader( "Cache-Control" ) ).toBeFalse()
			} )

			it( "sends a file inline via res.sendFile()", function() {
				var result = variables.client.get( variables.baseUrl & "/send-file" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toInclude( "static fixture" )
				expect( result.contentDisposition ).toBe( "" )
			} )

			it( "honors a Range request on res.sendFile(), returning 206 with just the requested slice", function() {
				var result = variables.client.getWithHeaders( variables.baseUrl & "/send-file", { "Range": "bytes=5-8" } )
				expect( result.statusCode ).toBe( 206 )
				expect( result.body ).toBe( "is a" )
				expect( result.contentRange ).toBe( "bytes 5-8/79" )
				expect( result.acceptRanges ).toBe( "bytes" )
			} )

			it( "returns 416 with Content-Range: bytes */size for a res.sendFile() Range request beyond the file", function() {
				var result = variables.client.getWithHeaders( variables.baseUrl & "/send-file", { "Range": "bytes=1000-2000" } )
				expect( result.statusCode ).toBe( 416 )
				expect( result.body ).toBe( "" )
				expect( result.contentRange ).toBe( "bytes */79" )
			} )

			it( "falls back to a full 200 response for a multi-range request (not supported)", function() {
				var result = variables.client.getWithHeaders( variables.baseUrl & "/send-file", { "Range": "bytes=0-3,5-8" } )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toInclude( "static fixture" )
			} )

			it( "sets ETag/Last-Modified on res.sendFile() and sends 304 when If-None-Match matches", function() {
				var first = variables.client.get( variables.baseUrl & "/send-file" )
				expect( first.etag ).notToBe( "" )

				var second = variables.client.getWithHeaders( variables.baseUrl & "/send-file", { "If-None-Match": first.etag } )
				expect( second.statusCode ).toBe( 304 )
				expect( second.body ).toBe( "" )
			} )

			it( "sends a file as an attachment via res.download()", function() {
				var result = variables.client.get( variables.baseUrl & "/download" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toInclude( "static fixture" )
				expect( result.contentDisposition ).toInclude( 'attachment; filename="greeting.txt"' )
			} )

			it( "strips quote/control characters from a caller-supplied download filename, preventing Content-Disposition parameter injection", function() {
				var result = variables.client.get( variables.baseUrl & "/download-named?filename=" & urlEncodedFormat( 'x".hi; foo=bar' ) )
				expect( result.statusCode ).toBe( 200 )
				expect( result.contentDisposition ).toBe( 'attachment; filename="x.hi; foo=bar"' )
			} )

			it( "parses a multipart/form-data upload, fields and files alike", function() {
				var result = variables.client.postMultipart(
					variables.baseUrl & "/upload",
					{ note: "hello" },
					[ { field: "avatar", filename: "avatar.txt", contentType: "text/plain", content: "binary-ish content" } ]
				)
				expect( result.statusCode ).toBe( 200 )
				var parsed = JSONDeserialize( result.body )
				expect( parsed.fields.note ).toBe( "hello" )
				expect( parsed.files.avatar[ 1 ].filename ).toBe( "avatar.txt" )
				expect( parsed.files.avatar[ 1 ].size ).toBe( 18 )
				expect( fileExists( parsed.files.avatar[ 1 ].path ) ).toBeTrue()
				expect( fileRead( parsed.files.avatar[ 1 ].path ) ).toBe( "binary-ish content" )
			} )

			it( 'handles a file input submitted with nothing selected (filename="") without a 500', function() {
				var result = variables.client.postMultipart(
					variables.baseUrl & "/upload",
					{},
					[ { field: "avatar", filename: "", contentType: "application/octet-stream", content: "" } ]
				)
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).files ).toBeStruct()
			} )

			it( "handles a multipart part with an empty body without a 500", function() {
				var crlf = char( 13 ) & char( 10 )
				var body = "--BOUNDARY" & crlf
					& 'Content-Disposition: form-data; name="note"' & crlf & crlf
					& "--BOUNDARY--" & crlf
				var result = variables.client.request( "POST", variables.baseUrl & "/upload", body, "multipart/form-data; boundary=BOUNDARY" )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).fields.note ).toBe( "" )
			} )

			it( "handles a part header with an empty name or value without a 500", function() {
				var crlf = char( 13 ) & char( 10 )
				var body = "--BOUNDARY" & crlf
					& ":value" & crlf
					& "Empty-Header:" & crlf
					& 'Content-Disposition: form-data; name="note"' & crlf & crlf
					& "hi" & crlf
					& "--BOUNDARY--" & crlf
				var result = variables.client.request( "POST", variables.baseUrl & "/upload", body, "multipart/form-data; boundary=BOUNDARY" )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).fields.note ).toBe( "hi" )
			} )

			it( "handles an empty boundary in Content-Type without a 500", function() {
				var crlf = char( 13 ) & char( 10 )
				var body = "--" & crlf
					& 'Content-Disposition: form-data; name="note"' & crlf & crlf
					& "hi" & crlf
					& "----" & crlf
				var result = variables.client.request( "POST", variables.baseUrl & "/upload", body, "multipart/form-data; boundary=" )
				expect( result.statusCode ).toBe( 200 )
			} )

			it( "renders a .bxm view", function() {
				var result = variables.client.get( variables.baseUrl & "/greet/Ada" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.contentType ).toInclude( "text/html" )
				expect( result.body ).toInclude( "Hello, Ada!" )
			} )

			it( "renders a .hbs view via Handlebars, including a loop", function() {
				var result = variables.client.get( variables.baseUrl & "/greet-hbs/Grace" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.contentType ).toInclude( "text/html" )
				expect( result.body ).toInclude( "Hello, Grace!" )
				expect( result.body ).toInclude( "Things: a, b, c" )
			} )

			it( "sends a status with its reason phrase via res.sendStatus()", function() {
				var result = variables.client.get( variables.baseUrl & "/not-found-status" )
				expect( result.statusCode ).toBe( 404 )
				expect( result.body ).toBe( "Not Found" )
			} )

			it( "sends dump()'s HTML view of a variable as the response via res.dump()", function() {
				var result = variables.client.get( variables.baseUrl & "/dump-test" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.contentType ).toInclude( "text/html" )
				expect( result.body ).toInclude( "bx-dump" )
				expect( result.body ).toInclude( "Ada" )
			} )

			it( "sets a cookie via res.cookie()", function() {
				var result = variables.client.get( variables.baseUrl & "/set-cookie" )
				expect( result.setCookie ).toInclude( "sessionId=abc123" )
			} )

			it( "starts a new session (views=1) when no session cookie is sent", function() {
				var result = variables.client.get( variables.baseUrl & "/session-count" )
				expect( JSONDeserialize( result.body ).views ).toBe( 1 )
				expect( result.setCookie ).toInclude( "connect.sid=" )
			} )

			it( "persists session data across requests via the session cookie", function() {
				var first = variables.client.get( variables.baseUrl & "/session-count" )
				var sessionCookie = listFirst( first.setCookie, ";" )

				var second = variables.client.getWithHeaders( variables.baseUrl & "/session-count", { "Cookie": sessionCookie } )
				expect( JSONDeserialize( second.body ).views ).toBe( 2 )

				var third = variables.client.getWithHeaders( variables.baseUrl & "/session-count", { "Cookie": sessionCookie } )
				expect( JSONDeserialize( third.body ).views ).toBe( 3 )
			} )

			it( "destroys a session via req.destroySession(), clearing the cookie and the stored data", function() {
				var first = variables.client.get( variables.baseUrl & "/session-count" )
				var sessionCookie = listFirst( first.setCookie, ";" )

				var logout = variables.client.getWithHeaders( variables.baseUrl & "/session-logout", { "Cookie": sessionCookie } )
				expect( JSONDeserialize( logout.body ).loggedOut ).toBeTrue()
				expect( logout.setCookie ).toInclude( "connect.sid=;" )
				expect( logout.setCookie ).toInclude( "Max-Age=0" )

				var after = variables.client.getWithHeaders( variables.baseUrl & "/session-count", { "Cookie": sessionCookie } )
				expect( JSONDeserialize( after.body ).views ).toBe( 1 )
			} )

			it( "redirects via res.redirect()", function() {
				var result = variables.client.requestNoRedirect( "GET", variables.baseUrl & "/go-home" )
				expect( result.statusCode ).toBe( 302 )
				expect( result.location ).toBe( "/" )
			} )

			it( "redirects with a caller-supplied status code via res.redirect(url, code)", function() {
				var result = variables.client.requestNoRedirect( "GET", variables.baseUrl & "/redirect-permanent" )
				expect( result.statusCode ).toBe( 301 )
				expect( result.location ).toBe( "/" )
			} )

			it( "routes PUT requests via app.put()", function() {
				var result = variables.client.request( "PUT", variables.baseUrl & "/items/7", '{"name":"widget"}' )
				expect( result.statusCode ).toBe( 200 )
				var parsed = JSONDeserialize( result.body )
				expect( parsed.updated ).toBe( "7" )
				expect( parsed.body.name ).toBe( "widget" )
			} )

			it( "routes PATCH requests via app.patch()", function() {
				var result = variables.client.request( "PATCH", variables.baseUrl & "/items/7" )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).patched ).toBe( "7" )
			} )

			it( "routes DELETE requests via app.delete()", function() {
				var result = variables.client.request( "DELETE", variables.baseUrl & "/items/7" )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).deleted ).toBe( "7" )
			} )

			it( "answers HEAD on a GET route with the same headers but no body", function() {
				var result = variables.client.request( "HEAD", variables.baseUrl & "/" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toBe( "" )
				expect( result.contentType ).toInclude( "text/html" )
			} )

			it( "answers HEAD on a static file with no body but the usual conditional-GET headers", function() {
				var result = variables.client.request( "HEAD", variables.baseUrl & "/public/hello.txt" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toBe( "" )
				expect( result.etag ).notToBe( "" )
				expect( result.acceptRanges ).toBe( "bytes" )
			} )

			it( "answers HEAD with a 404 and no body when nothing matches", function() {
				var result = variables.client.request( "HEAD", variables.baseUrl & "/does-not-exist" )
				expect( result.statusCode ).toBe( 404 )
				expect( result.body ).toBe( "" )
			} )

			it( "matches every HTTP method via app.all()", function() {
				expect( variables.client.get( variables.baseUrl & "/any-method" ).body ).toBe( "matched: GET" )
				expect( variables.client.post( variables.baseUrl & "/any-method" ).body ).toBe( "matched: POST" )
				expect( variables.client.request( "PUT", variables.baseUrl & "/any-method" ).body ).toBe( "matched: PUT" )
				expect( variables.client.request( "DELETE", variables.baseUrl & "/any-method" ).body ).toBe( "matched: DELETE" )
			} )

			it( "sets an arbitrary response header via res.header()", function() {
				var result = variables.client.get( variables.baseUrl & "/header-test" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.header ).toBe( "yes" )
			} )

			it( "sets the response content type via res.type()", function() {
				var result = variables.client.get( variables.baseUrl & "/type-test" )
				expect( result.contentType ).toInclude( "application/xml" )
				expect( result.body ).toBe( "<x/>" )
			} )

			it( "ends the response with no body via res.end()", function() {
				var result = variables.client.get( variables.baseUrl & "/end-test" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toBe( "" )
			} )

			it( "ends the response with a body via res.end(data)", function() {
				var result = variables.client.get( variables.baseUrl & "/end-test-body" )
				expect( result.body ).toBe( "bye" )
			} )

			it( "sends raw bytes with an explicit content type via res.sendBytes()", function() {
				var result = variables.client.get( variables.baseUrl & "/bytes-test" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.contentType ).toInclude( "text/plain" )
				expect( result.body ).toBe( "raw bytes" )
			} )

			it( "reads an arbitrary request header via req.get()", function() {
				var result = variables.client.getWithHeaders( variables.baseUrl & "/echo-header", { "X-Ping": "pong" } )
				expect( JSONDeserialize( result.body ).got ).toBe( "pong" )
			} )

			it( "exposes the underlying HttpExchange via req.rawExchange()", function() {
				var result = variables.client.get( variables.baseUrl & "/raw-exchange-test" )
				expect( JSONDeserialize( result.body ).hasExchange ).toBeTrue()
			} )

			it( "resolves req.ip to the direct TCP peer", function() {
				var result = variables.client.get( variables.baseUrl & "/ip-test" )
				expect( len( JSONDeserialize( result.body ).ip ) ).toBeGT( 0 )
			} )

			it( "prefers X-Forwarded-For for req.ip only when app.set('trust proxy', true) is used", function() {
				var proxyPort = 4322
				var proxyApp = new "../../models/BoxExpress"()
				proxyApp.set( "trust proxy", true )
				proxyApp.get( "/ip", ( req, res ) => res.json( { ip: req.ip } ) )
				proxyApp.listen( port = proxyPort, options = { block: false } )
				sleep( 300 )

				try {
					var result = variables.client.getWithHeaders(
						"http://localhost:#proxyPort#/ip",
						{ "X-Forwarded-For": "203.0.113.9, 10.0.0.1" }
					)
					expect( JSONDeserialize( result.body ).ip ).toBe( "203.0.113.9" )
				} finally {
					proxyApp.close()
				}
			} )

			it( "prefers a configured trust proxy header for req.ip over X-Forwarded-For, with no trust proxy boolean needed", function() {
				var proxyPort = 4331
				var proxyApp = new "../../models/BoxExpress"()
				proxyApp.set( "trust proxy header", "DO-Connecting-IP" )
				proxyApp.get( "/ip", ( req, res ) => res.json( { ip: req.ip } ) )
				proxyApp.listen( port = proxyPort, options = { block: false } )
				sleep( 300 )

				try {
					var result = variables.client.getWithHeaders(
						"http://localhost:#proxyPort#/ip",
						{ "X-Forwarded-For": "203.0.113.9, 10.0.0.1", "DO-Connecting-IP": "198.51.100.7" }
					)
					expect( JSONDeserialize( result.body ).ip ).toBe( "198.51.100.7" )
				} finally {
					proxyApp.close()
				}
			} )

			it( "checks trust proxy header candidates in order and falls back to the direct peer when none are present", function() {
				var proxyPort = 4332
				var proxyApp = new "../../models/BoxExpress"()
				proxyApp.set( "trust proxy header", [ "DO-Connecting-IP", "CF-Connecting-IP" ] )
				proxyApp.get( "/ip", ( req, res ) => res.json( { ip: req.ip } ) )
				proxyApp.listen( port = proxyPort, options = { block: false } )
				sleep( 300 )

				try {
					var withSecond = variables.client.getWithHeaders(
						"http://localhost:#proxyPort#/ip",
						{ "CF-Connecting-IP": "198.51.100.42" }
					)
					expect( JSONDeserialize( withSecond.body ).ip ).toBe( "198.51.100.42" )

					var withNeither = variables.client.get( "http://localhost:#proxyPort#/ip" )
					expect( len( JSONDeserialize( withNeither.body ).ip ) ).toBeGT( 0 )
					expect( JSONDeserialize( withNeither.body ).ip ).notToBe( "198.51.100.42" )
				} finally {
					proxyApp.close()
				}
			} )

			it( "runs multiple middleware registered from a single app.use(path, ...) call, in order", function() {
				var result = variables.client.get( variables.baseUrl & "/multi-use-test" )
				expect( result.statusCode ).toBe( 200 )
				expect( JSONDeserialize( result.body ).order ).toBe( [ "mw1", "mw2", "route" ] )
			} )

			it( "enforces CSRF protection end to end: mint via GET, accept a matching token, reject a wrong/missing one", function() {
				var csrfPort = 4329
				var csrfApp = new "../../models/BoxExpress"()
				var session = new "../../models/middleware/Session"()
				var bodyParsers = new "../../models/middleware/BodyParsers"()
				var csrf = new "../../models/middleware/Csrf"()

				csrfApp.use( bodyParsers.urlencoded() )
				csrfApp.use( session.session() )
				csrfApp.use( csrf.protect() )
				csrfApp.get( "/form", ( req, res ) => res.json( { token: req.csrfToken() } ) )
				csrfApp.post( "/form", ( req, res ) => res.json( { ok: true } ) )
				csrfApp.listen( port = csrfPort, options = { block: false } )
				sleep( 300 )

				try {
					var getResult = variables.client.get( "http://localhost:#csrfPort#/form" )
					expect( getResult.statusCode ).toBe( 200 )
					var token = JSONDeserialize( getResult.body ).token
					expect( len( token ) ).toBeGT( 0 )

					var sessionCookie = listFirst( getResult.setCookie, ";" )

					var correctPost = variables.client.requestWithHeaders(
						"POST",
						"http://localhost:#csrfPort#/form",
						{ "Cookie": sessionCookie },
						"_csrf=" & token,
						"application/x-www-form-urlencoded"
					)
					expect( correctPost.statusCode ).toBe( 200 )
					expect( JSONDeserialize( correctPost.body ).ok ).toBeTrue()

					var wrongPost = variables.client.requestWithHeaders(
						"POST",
						"http://localhost:#csrfPort#/form",
						{ "Cookie": sessionCookie },
						"_csrf=not-the-real-token",
						"application/x-www-form-urlencoded"
					)
					expect( wrongPost.statusCode ).toBe( 403 )

					var missingPost = variables.client.requestWithHeaders(
						"POST",
						"http://localhost:#csrfPort#/form",
						{ "Cookie": sessionCookie },
						"note=hi",
						"application/x-www-form-urlencoded"
					)
					expect( missingPost.statusCode ).toBe( 403 )

					var headerPost = variables.client.requestWithHeaders(
						"POST",
						"http://localhost:#csrfPort#/form",
						{ "Cookie": sessionCookie, "X-CSRF-Token": token },
						"",
						"application/x-www-form-urlencoded"
					)
					expect( headerPost.statusCode ).toBe( 200 )
				} finally {
					csrfApp.close()
				}
			} )

			it( "applies Helmet with caller overrides, disabled headers, and opt-in HSTS/CSP", function() {
				var helmetPort = 4327
				var helmetApp = new "../../models/BoxExpress"()
				var helmet = new "../../models/middleware/Helmet"()
				helmetApp.use( helmet.protect( {
					frameOptions: "DENY",
					referrerPolicy: false,
					hsts: true,
					contentSecurityPolicy: "default-src 'self'"
				} ) )
				helmetApp.get( "/", ( req, res ) => res.send( "ok" ) )
				helmetApp.listen( port = helmetPort, options = { block: false } )
				sleep( 300 )

				try {
					var result = variables.client.get( "http://localhost:#helmetPort#/" )
					expect( result.getHeader( "X-Frame-Options" ) ).toBe( "DENY" )
					expect( result.hasHeader( "Referrer-Policy" ) ).toBeFalse()
					expect( result.getHeader( "Strict-Transport-Security" ) ).toBe( "max-age=15552000; includeSubDomains" )
					expect( result.getHeader( "Content-Security-Policy" ) ).toBe( "default-src 'self'" )
					// Unrelated defaults are unaffected by the overrides above.
					expect( result.getHeader( "X-Content-Type-Options" ) ).toBe( "nosniff" )
				} finally {
					helmetApp.close()
				}
			} )

			it( "runs a registered param() callback before the route handler via app.param()", function() {
				var result = variables.client.get( variables.baseUrl & "/parented/42" )
				expect( JSONDeserialize( result.body ).code ).toBe( "parented-42" )
			} )

			it( "reports req.protocol/secure/hostname for a plain direct request", function() {
				var result = variables.client.get( variables.baseUrl & "/reqinfo-test" )
				var parsed = JSONDeserialize( result.body )
				expect( parsed.protocol ).toBe( "http" )
				expect( parsed.secure ).toBeFalse()
				expect( parsed.hostname ).toBe( "localhost" )
			} )

			it( "prefers X-Forwarded-Proto/X-Forwarded-Host for req.protocol/secure/hostname only when app.set('trust proxy', true) is used", function() {
				var proxyPort = 4326
				var proxyApp = new "../../models/BoxExpress"()
				proxyApp.set( "trust proxy", true )
				proxyApp.get( "/reqinfo", ( req, res ) => res.json( { protocol: req.protocol, secure: req.secure, hostname: req.hostname } ) )
				proxyApp.listen( port = proxyPort, options = { block: false } )
				sleep( 300 )

				try {
					var result = variables.client.getWithHeaders(
						"http://localhost:#proxyPort#/reqinfo",
						{ "X-Forwarded-Proto": "https", "X-Forwarded-Host": "example.com:8443" }
					)
					var parsed = JSONDeserialize( result.body )
					expect( parsed.protocol ).toBe( "https" )
					expect( parsed.secure ).toBeTrue()
					expect( parsed.hostname ).toBe( "example.com" )
				} finally {
					proxyApp.close()
				}
			} )

			it( "merges app.locals and res.locals into render() data, with data itself taking precedence", function() {
				var result = variables.client.get( variables.baseUrl & "/locals-test" )
				expect( result.statusCode ).toBe( 200 )
				expect( result.body ).toInclude( "appValue=fromApp" )
				expect( result.body ).toInclude( "resValue=fromRes" )
				expect( result.body ).toInclude( "overridden=fromData" )
			} )

			it( "matches an optional trailing route param end to end, with and without it present", function() {
				var withId = variables.client.get( variables.baseUrl & "/optional-param-test/42" )
				expect( JSONDeserialize( withId.body ).id ).toBe( "42" )

				var withoutId = variables.client.get( variables.baseUrl & "/optional-param-test" )
				expect( JSONDeserialize( withoutId.body ).id ).toBe( "(absent)" )
			} )

			it( "returns a default 404 for an unmatched route", function() {
				var result = variables.client.get( variables.baseUrl & "/does-not-exist" )
				expect( result.statusCode ).toBe( 404 )
			} )

			it( "routes a thrown error to custom error-handling middleware", function() {
				var result = variables.client.get( variables.baseUrl & "/boom" )
				expect( result.statusCode ).toBe( 500 )
				expect( JSONDeserialize( result.body ).message ).toBe( "kaboom" )
			} )

			it( "close() is idempotent — calling it a second time does not error", function() {
				var throwawayPort = 4323
				var throwawayApp = new "../../models/BoxExpress"()
				throwawayApp.get( "/", ( req, res ) => res.send( "up" ) )
				throwawayApp.listen( port = throwawayPort, options = { block: false } )
				sleep( 300 )

				expect( variables.client.get( "http://localhost:#throwawayPort#/" ).body ).toBe( "up" )

				throwawayApp.close()
				throwawayApp.close() // must not throw

				expect( function() {
					throwawayApp.close()
				} ).notToThrow()
			} )

			it( "serves concurrent requests without serializing them", function() {
				var slowUrl = variables.baseUrl & "/slow-test-only"
				var httpClient = variables.client
				var startedAt = getTickCount()

				bx:thread name="concurrencyTestThread1" {
					httpClient.get( slowUrl )
				}
				bx:thread name="concurrencyTestThread2" {
					httpClient.get( slowUrl )
				}
				bx:thread name="concurrencyTestThread3" {
					httpClient.get( slowUrl )
				}
				bx:thread action="join" name="concurrencyTestThread1,concurrencyTestThread2,concurrencyTestThread3";

				var elapsed = getTickCount() - startedAt

				// Serialized would be ~1500ms; concurrent should land well under that.
				expect( elapsed ).toBeLT( 1200 )
			} )

		} )
	}

}
