# Dependencies installed via `box install` (see box.json) — regenerate with
# `box install`, don't commit them.
/testbox/
/modules/

# Self-referencing symlink created by run-tests.bxs so BifsSpec can exercise the
# module's global BIFs. Deliberately not committed — see run-tests.bxs for why.
/boxlang_modules/

# CommandBox / BoxLang runtime artifacts
.engine/
.artifacts/
.tmp/
*.log

# TestBox output (if a runner is pointed at a report path)
/tests/results/

# Generated by the multipart upload integration test — cleaned up in afterAll(),
# ignored here as a safety net if a run is interrupted before that.
/tests/fixtures/uploads/
/tests/fixtures/bif-uploads/

# Editor
.vscode/
.idea/
*.swp

# OS
.DS_Store
Thumbs.db
