/**
 * Global BIF wrapping BodyParsers.urlencoded() — mirrors Express's
 * express.urlencoded().
 *
 *   app.use( boxExpressUrlencoded() )
 *   app.use( boxExpressUrlencoded( { limit: 500000 } ) )
 */
@BoxBIF
class {

	function invoke( options = {} ) {
		return new bxModules.boxexpress.models.middleware.BodyParsers().urlencoded( options )
	}

}
